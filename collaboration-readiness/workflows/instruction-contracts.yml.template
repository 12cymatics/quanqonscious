name: Instruction and structural example checks
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  contract:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97
        with:
          python-version: '3.11'
      - name: Check the draft policy and memory schema
        run: |
          python validate_contracts.py --self-test
          python validate_readiness.py --record readiness.template.json --evidence-root . --ownership-root .
          python -m unittest -v test_readiness.py
          python geometry/verify_structures.py
