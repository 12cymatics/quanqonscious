        r += vGeo * 5 * sin(theta * 3 - phi * 2 * vortexHelicity + timeVo4);

        // Tornado lateral sweep
        R += vGeo * 10 * sin(theta * 2 - timeVo2) * funnelFactor;
        yOff += vSign * vGeo * 15 * cos(theta * 2 + phi * vortexHelicity - timeAbsVo3) * funnelFactor;

        // Cymatic standing wave nodes on surface
        const cymNode = sin(theta * 6 - phi * 3 * vortexHelicity + timeVo2);
        r += vGeo * 3 * cymNode * cymNode * antiFunnel;
      }

      // Wheeler φ³ hyperboloid distortion (perturbation scale)
      const wheelerDist = WHEELER.fieldDistortion(theta, phi, 2.0, t);
      R += wheelerDist * 3;
      yOff += WHEELER.goldenVortex(theta, phi, absVo || 0.1) * 4;

      // R⁴ singularity modulation: flatten near singularity
      const r4Squeeze = 1 - r4f * 0.3;
      R *= r4Squeeze;

      // Floor R so torus never self-intersects; cap to stay on screen
      r = clamp(r, 15, 120);
      R = clamp(max(R, r + 15), 80, 350);

      // Compute torus point
      const effPhi = phi + phiShift;
      const cosP = cos(effPhi), sinP = sin(effPhi);
      let x = (R + r * cosP) * cosTheta;
      let y = r * sinP + yOff;
      let z = (R + r * cosP) * sinTheta;

      // Camera rotation (using pre-computed trig)
      let t1;
      t1 = x * cRY - z * sRY; z = x * sRY + z * cRY; x = t1;
      t1 = y * cRX - z * sRX; z = y * sRX + z * cRX; y = t1;

      const idx = i * PH_SEG + j;
      const pScale = CAM_DIST / (CAM_DIST + z);
      torusPoints[idx].sx = cx + x * pScale;
      torusPoints[idx].sy = cy + y * pScale;
      torusPoints[idx].depth = z;
      torusPoints[idx].field = fvNorm;
      torusPoints[idx].theta = theta;
      torusPoints[idx].phi = phi;
    }
  }
}

function renderTorus() {
  // Pre-build quad list with back-face culling
  // At 160×80 = 12,800 quads — cull ~half, draw ~6,400 front faces
  const quads = [];
  for (let i = 0; i < TH_SEG; i++) {
    const ni = (i + 1) % TH_SEG;
    for (let j = 0; j < PH_SEG; j++) {
      const nj = (j + 1) % PH_SEG;
      const i00 = i * PH_SEG + j;
      const i10 = ni * PH_SEG + j;
      const i11 = ni * PH_SEG + nj;
      const i01 = i * PH_SEG + nj;
      const p0 = torusPoints[i00], p1 = torusPoints[i10];
      const p2 = torusPoints[i11], p3 = torusPoints[i01];

      // Face normal z-component via 2D cross product (screen-space winding)
      const e1x = p1.sx - p0.sx, e1y = p1.sy - p0.sy;
      const e2x = p3.sx - p0.sx, e2y = p3.sy - p0.sy;
      const nz = e1x * e2y - e1y * e2x;

      // Back-face cull — skip faces pointing away from camera
      if (nz < 0) continue;

      const avgDepth = (p0.depth + p1.depth + p2.depth + p3.depth) * 0.25;
      const avgField = (p0.field + p1.field + p2.field + p3.field) * 0.25;

      // Full normal for lighting
      const e1z = p1.depth - p0.depth, e2z = p3.depth - p0.depth;
      const nx = e1y * e2z - e1z * e2y;
      const ny = e1z * e2x - e1x * e2z;
      const nLen = sqrt(nx*nx + ny*ny + nz*nz) || 1;
      const diffuse = clamp((-0.4 * nx - 0.6 * ny + 0.7 * nz) / nLen, 0, 1);

      quads.push({ p0, p1, p2, p3, depth: avgDepth, field: avgField, diffuse });
    }
  }
  // Sort back-to-front
  quads.sort((a, b) => a.depth - b.depth);

  // Draw — all front-facing, opaque fill, no wireframe
  for (const q of quads) {
    const fv = clamp(q.field, -1, 1);
    const afv = abs(fv);

    // Cymatic color mapping — warm/cool/nodal
    let r, g, b;
    if (fv > 0.03) {
      const t = clamp(fv, 0, 1);
      r = floor(200 + t * 55);
      g = floor(140 + t * 80);
      b = floor(30 + t * 60);
    } else if (fv < -0.03) {
      const t = clamp(-fv, 0, 1);
      r = floor(25 + t * 50);
      g = floor(80 + t * 100);
      b = floor(180 + t * 75);
    } else {
      // Nodal line: deep purple — cymatic standing wave zero-crossings
      const n = 1 - afv / 0.03;
      r = floor(50 + n * 30);
      g = floor(15 + n * 15);
      b = floor(60 + n * 40);
    }

    // Surface lighting: ambient + diffuse
    const light = 0.25 + 0.75 * q.diffuse;
    r = floor(r * light); g = floor(g * light); b = floor(b * light);

    ctx.fillStyle = `rgba(${r},${g},${b},0.95)`;
    ctx.beginPath();
    ctx.moveTo(q.p0.sx, q.p0.sy);
    ctx.lineTo(q.p1.sx, q.p1.sy);
    ctx.lineTo(q.p2.sx, q.p2.sy);
    ctx.lineTo(q.p3.sx, q.p3.sy);
    ctx.closePath();
    ctx.fill();
  }
}

