      const mean = Q.fl(VTX.mean());
      const B = max(1, Math.pow(10, floor(Math.log10(max(1, abs(mean))) + 1)));
      for (let i = 0; i < 16; i++) {
        const v = Q.fl(VTX.psi[i]);
        const d = (B - abs(v)) / B; // normalized deficiency
        const sqFactor = d * d; // d²/B² — the deficiency squared
        // MULTIPLICATIVE: Ψ' = Ψ·(1 + α·d²) → Ψ when α→0
        VTX.psi[i] = Q.mul(VTX.psi[i], Q.add(Q.ONE, Q.mk(Bi(α * sqFactor * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(10, 1);
      return `S10: MULT d²-squaring B=${sf(B,0)} α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S11: Vyaṣṭisamaṣṭiḥ — "Part and Whole"
  // TYPE: CONVOLUTIVE
  // Hamming weight layers are parts; total field is whole.
  // Convolution: each vertex gets weighted average of its layer and total.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:11, name:'Vyaṣṭisamaṣṭiḥ', sk:'व्यष्टि', m:2, n:1, amp:0.35, freq:0.9,
    desc:'CONVOLUTIVE: part-whole by Hamming weight layers',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(11);
      // Compute layer sums by Hamming weight
      const layerSum = [Q.ZERO, Q.ZERO, Q.ZERO, Q.ZERO, Q.ZERO];
      const layerCnt = [0, 0, 0, 0, 0];
      for (let i = 0; i < 16; i++) {
        const h = VTX.hw(i);
        layerSum[h] = Q.add(layerSum[h], VTX.psi[i]);
        layerCnt[h]++;
      }
      const whole = VTX.mean();
      // Each vertex: blend layer mean with whole mean
      for (let i = 0; i < 16; i++) {
        const h = VTX.hw(i);
        const partMean = Q.div(layerSum[h], Q.mk(BigInt(layerCnt[h])));
        // Target: (part + whole)/2 — balanced part-whole relation
        const target = Q.div(Q.add(partMean, whole), Q.mk(2n));
        const diff = Q.sub(target, VTX.psi[i]);
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(11, 26);
      return `S11: CONV layers=[${layerSum.map(s=>sf(Q.fl(s),1)).join(',')}] α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S12: Veṣṭanaṃ — "Osculation / Casting out nines"
  // TYPE: REFLECTIVE
  // Digital root: Ψ → dr(Ψ) = 1 + ((|Ψ|-1) mod 9). Reflect toward digital root.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:12, name:'Veṣṭanaṃ', sk:'वेष्टनम्', m:3, n:0, amp:0.3, freq:0.75,
    desc:'REFLECTIVE: reflect vertex fields toward their digital root mod 9',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(12);
      for (let i = 0; i < 16; i++) {
        const v = abs(floor(Q.fl(VTX.psi[i])));
        const dr = v === 0 ? 0 : 1 + ((v - 1) % 9); // digital root
        const sign = Q.fl(VTX.psi[i]) >= 0 ? 1 : -1;
        const target = Q.mk(Bi(sign * dr * 1000), 1000n);
        const diff = Q.sub(target, VTX.psi[i]);
        // REFLECTIVE: Ψ' = Ψ + α·(dr - Ψ) → Ψ when α→0
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(12, 14);
      return `S12: REFL digital root α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S13: Sopāntyadvayamantyam — "Penultimate and Ultimate"
  // TYPE: DIVISIVE
  // Continued fraction convergents from vertex pair ratios.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:13, name:'Sopāntyadvayamantyam', sk:'सोपान्त्य', m:1, n:3, amp:0.35, freq:0.85,
    desc:'DIVISIVE: continued fraction convergents on vertex pair ratios',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(13);
      // Use complementary pair (0, 15) as numerator/denominator
      const num = bigAbs(VTX.psi[0].n) || 1n;
      const den = bigAbs(VTX.psi[15].n) || 1n;
      // Compute CF: [a₀; a₁, a₂, ...]
      let n = num, d = den;
      const cf = [];
      for (let step = 0; step < 8 && d > 0n; step++) {
        cf.push(n / d);
        const r = n % d; n = d; d = r;
      }
      // Compute convergent p/q from CF
      let p0 = 1n, p1 = cf[0] || 0n, q0 = 0n, q1 = 1n;
      for (let k = 1; k < cf.length; k++) {
        const a = cf[k];
        const p2 = a * p1 + p0, q2 = a * q1 + q0;
        p0 = p1; p1 = p2; q0 = q1; q1 = q2;
      }
      // Drive vertex pair toward convergent ratio
      if (q1 !== 0n) {
        const convTarget = Q.mk(p1, q1);
        const actual = VTX.psi[15].n !== 0n ? Q.div(VTX.psi[0], VTX.psi[15]) : Q.ONE;
        const diff = Q.sub(convTarget, actual);
        // Apply convergent correction to vertices 0 and 15
        VTX.psi[0] = Q.add(VTX.psi[0], Q.mul(diff, Q.mk(Bi(α * 5000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(13, 4);
      return `S13: DIV CF=[${cf.slice(0,4).join(';')}…] p/q=${p1}/${q1} α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S14: Ekanyūnena Pūrveṇa — "By one less than the previous"
  // TYPE: MULTIPLICATIVE
  // Ψ'ᵢ = Ψᵢ · (1 - α/|Ψ_{nb}|) — "one less" as multiplicative decrement
  // ═══════════════════════════════════════════════════════════════════════════
  { id:14, name:'Ekanyūnena Pūrveṇa', sk:'एकन्यूनेन', m:0, n:0, amp:0.3, freq:0.95,
    desc:'MULTIPLICATIVE: Ψ\'ᵢ = Ψᵢ·(1 - α/|Ψ_{nb}|) — one less decrement',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(14);
      for (let i = 0; i < 16; i++) {
        const nb = VTX.psi[i ^ 8]; // neighbor along axis 3 (complementary to S1's axis 0)
        const nbMag = abs(Q.fl(nb)) + 1; // prevent division by zero
        const factor = -1.0 / nbMag; // "one less"
        VTX.psi[i] = Q.mul(VTX.psi[i], Q.add(Q.ONE, Q.mk(Bi(α * factor * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(14, 1);
      return `S14: MULT one-less α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S15: Guṇitasamuccayaḥ — "Product of sum = sum of products"
  // TYPE: MULTIPLICATIVE
  // Vertex pairs along each axis: Ψ₊·Ψ₋ should equal sum-of-pair-products.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:15, name:'Guṇitasamuccayaḥ', sk:'गुणित', m:2, n:2, amp:0.4, freq:1.1,
    desc:'MULTIPLICATIVE: enforce (Σ)(Σ) = ΣΠ on vertex edge pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(15);
      // For each axis: compute Σ₊·Σ₋ vs Σ(Ψ₊·Ψ₋)
      for (let axis = 0; axis < 4; axis++) {
        const mask = 1 << axis;
        let sumPlus = Q.ZERO, sumMinus = Q.ZERO, sumProd = Q.ZERO;
        for (let base = 0; base < 16; base++) {
          if (base & mask) continue;
          sumMinus = Q.add(sumMinus, VTX.psi[base]);
          sumPlus = Q.add(sumPlus, VTX.psi[base | mask]);
          sumProd = Q.add(sumProd, Q.mul(VTX.psi[base], VTX.psi[base | mask]));
        }
        const prodSum = Q.mul(sumPlus, sumMinus);
        // Residual: (Σ₊)(Σ₋) - Σ(Ψ₊Ψ₋)
        const residual = Q.fl(Q.sub(prodSum, sumProd));
        if (isFinite(residual) && abs(residual) > 0.01) {
          const corr = -residual * 0.001;
          for (let base = 0; base < 16; base++) {
            if (base & mask) continue;
            // MULTIPLICATIVE: scale vertex products to enforce identity
            VTX.psi[base | mask] = Q.mul(VTX.psi[base | mask],
              Q.add(Q.ONE, Q.mk(Bi(α * corr * 10000), 10000n)));
          }
        }
      }
      INTER_SUTRA.recordInteraction(15, 3);
      return `S15: MULT Π-Σ identity α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S16: Guṇakasamuccayaḥ — "Factor of sum = sum of factors"
  // TYPE: DIVISIVE
  // Extended GCD on vertex magnitude pairs → Bézout combination.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:16, name:'Guṇakasamuccayaḥ', sk:'गुणक', m:3, n:3, amp:0.35, freq:0.8,
    desc:'DIVISIVE: Extended GCD Bézout coefficients on vertex pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(16);
      // GCD of magnitudes of vertex 0 and vertex 15
      const a = bigAbs(VTX.psi[0].n) || 1n, b = bigAbs(VTX.psi[15].n) || 1n;
      let r0 = a, r1 = b, s0 = 1n, s1 = 0n, t0 = 0n, t1 = 1n;
      while (r1 > 0n) {
        const q = r0 / r1;
        [r0, r1] = [r1, r0 - q * r1];
        [s0, s1] = [s1, s0 - q * s1];
        [t0, t1] = [t1, t0 - q * t1];
      }
      const g = r0; // gcd
      // Drive vertex 15 toward Bézout combination sa+tb=g
      if (g > 1n) {
        const reduced = Q.div(VTX.psi[0], Q.mk(g));
        const diff = Q.sub(reduced, VTX.psi[15]);
        VTX.psi[15] = Q.add(VTX.psi[15], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(16, 24);
      return `S16: DIV gcd=${g} Bézout s=${s0},t=${t0} α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S17: Ānurūpyeṇa — "Proportionately"
  // TYPE: DIFFUSIVE
  // φ-weighted gradient flow along tesseract edges.
  // Each edge carries flow proportional to φ^(Hamming distance).
  // ═══════════════════════════════════════════════════════════════════════════
  { id:17, name:'Ānurūpyeṇa', sk:'आनुरूप्येण', m:1, n:1, amp:0.3, freq:0.9,
    desc:'DIFFUSIVE: φ-weighted gradient flow along tesseract edges',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(17);
      const phi = C.phi_f;
      // For each edge (i,j): flow ∝ φ·(Ψⱼ-Ψᵢ) / max_gradient
      let maxGrad = 0.001;
      for (let i = 0; i < 16; i++) {
        for (const j of VTX.neighbors(i)) {
          maxGrad = max(maxGrad, abs(Q.fl(Q.sub(VTX.psi[j], VTX.psi[i]))));
        }
      }
      for (let i = 0; i < 16; i++) {
        let flow = Q.ZERO;
        for (const j of VTX.neighbors(i)) {
          const grad = Q.sub(VTX.psi[j], VTX.psi[i]);
          flow = Q.add(flow, Q.div(grad, Q.mk(Bi(maxGrad * 1000), 1000n)));
        }
        // Scale flow by φ/4 (4 neighbors)
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(flow, Q.mk(Bi(α * phi * 2500), 10000n)));
      }
      INTER_SUTRA.recordInteraction(17, 6);
      return `S17: DIFF φ-flow maxG=${sf(maxGrad,3)} α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S18: Śiṣyate Śeṣasaṃjñaḥ — "The remainder stays"
  // TYPE: MODULAR
  // CRT: vertices grouped by Hamming weight class mod (5,7).
  // ═══════════════════════════════════════════════════════════════════════════
  { id:18, name:'Śiṣyate Śeṣasaṃjñaḥ', sk:'शिष्यते', m:0, n:1, amp:0.25, freq:0.85,
    desc:'MODULAR: CRT on Hamming-weight classes mod (5,7)',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(18);
      // Group vertices by hw mod 5 and hw mod 7
      for (let i = 0; i < 16; i++) {
        const hw = VTX.hw(i);
        const r5 = hw % 5, r7 = hw % 7;
        const v = abs(floor(Q.fl(VTX.psi[i])));
        const vr5 = v % 5, vr7 = v % 7;
        // CRT target: vertex value should have residue matching its Hamming class
        if (vr5 !== r5 || vr7 !== r7) {
          // Find smallest adjustment to fix both residues
          const target5 = (r5 - vr5 + 5) % 5;
          const adj = Q.mk(BigInt(target5), 1n);
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(adj, Q.mk(Bi(α * 10000), 10000n)));
        }
      }
      INTER_SUTRA.recordInteraction(18, 20);
      return `S18: MOD CRT(5,7) α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S19: Kevalaih Saptakam Guṇyāt — "Multiply by 7 only"
  // TYPE: DIVISIVE
  // Vieta's formulas: vertex pairs as roots of quadratic.
  // Sum of roots = -b/a, product = c/a.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:19, name:'Kevalaih Saptakam Guṇyāt', sk:'केवलैः', m:2, n:0, amp:0.3, freq:0.8,
    desc:'DIVISIVE: Vieta relations on complementary vertex root pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(19);
      // For each complementary pair (i, comp(i)):
      // Treat as roots r₁=Ψᵢ, r₂=Ψ_c → sum=r₁+r₂, prod=r₁·r₂
      // Vieta: these should form coefficients of x²-Sx+P=0
      for (let i = 0; i < 8; i++) {
        const j = VTX.comp(i);
        const sum = Q.add(VTX.psi[i], VTX.psi[j]);
        const prod = Q.mul(VTX.psi[i], VTX.psi[j]);
        // Discriminant: S²-4P should be non-negative (real roots)
        const disc = Q.sub(Q.mul(sum, sum), Q.mul(Q.mk(4n), prod));
        const discF = Q.fl(disc);
        if (discF < 0) {
          // Negative discriminant → drive toward zero (real root boundary)
          const correction = Q.mul(disc, Q.mk(Bi(-α * 5000), 10000n));
          VTX.psi[i] = Q.add(VTX.psi[i], correction);
        }
      }
      INTER_SUTRA.recordInteraction(19, 13);
      return `S19: DIV Vieta α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S20: Vilokanam — "By mere observation"
  // TYPE: MODULAR
  // Base-7 residue correction: drive vertex values toward divisibility by 7.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:20, name:'Vilokanam', sk:'विलोकनम्', m:3, n:2, amp:0.25, freq:0.75,
