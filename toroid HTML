// §15 UI + MAIN LOOP
// ═══════════════════════════════════════════════════════════════════════════════
function buildPanel() {
  const list = document.getElementById('sutra-list');
  list.innerHTML = '';
  SUTRAS.forEach((s, i) => {
    const el = document.createElement('div');
    el.className = 'st';
    el.innerHTML = `<div class="led"></div><span class="sid">S${s.id}</span><span class="sname">${s.sk} ${s.name}</span><span class="sharm">(${s.m},${s.n})</span>`;
    el.addEventListener('click', () => {
      s.on = !s.on;
      el.classList.toggle('active', s.on);
    });
    list.appendChild(el);
  });
}

const center = document.getElementById('center');
center.addEventListener('mousemove', e => {
  if (!isDrag) return;
  camRY += (e.clientX - lastMX) * 0.005;
  camRX += (e.clientY - lastMY) * 0.005;
  lastMX = e.clientX; lastMY = e.clientY;
});
center.addEventListener('mousedown', e => { isDrag = true; lastMX = e.clientX; lastMY = e.clientY; autoRotate = false; });
center.addEventListener('mouseup', () => { isDrag = false; setTimeout(() => autoRotate = true, 2000); });

let frameTime = 0;
function frame(t) {
  frameTime = t;
  const cw = W / devicePixelRatio, ch = H / devicePixelRatio;

  try {
  if (autoRotate) { camRY += 0.006; camRX = 0.55 + 0.25 * sin(t * 0.0002); }

  // PRE-SANITIZE: Lean-verified QI interval bounds (Interval.lean: contains_add, contains_sub)
  QI.clampLambda();

  // Sync Lean State from lambda BEFORE evolves
  LeanState.syncFromLambda();

  // ── VERTEX FIELD SUBSTRATE: λ → Ψ[16] ──────────────────────────────────
  // Forward transform: project 4-vector into 16-vertex tesseract field
  VTX.forward();

  // ── USO ENERGY INJECTION ──────────────────────────────────────────────
  // Without a driving term, all operators are dissipative → field → 0.
  // VERTEX INJECTION: Hamming-layer patterned energy from USO
  {
    const P = USO.P, S = USO.S;
    const drive = (P - 1) * 2.0;
    for (let i = 0; i < 16; i++) {
      const hw = VTX.hw(i);
      const sign = (hw % 2 === 0) ? 1 : -1;
      const inject = drive * sign * (1 + hw * 0.3) * abs(S) * 0.5;
      if (isFinite(inject) && abs(inject) < 100) {
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(inject * 10000), 10000n));
      }
    }
  }

  // Evolve all active sutras on vertex field Ψ[16] — genuinely different operators
  const active = SUTRAS.filter(s => s.on);
  for (const s of active) {
    try {
      s.lastResult = s.evolve(1);
      // Lean-verified backbone: act(u, s) transition (SutraSemantics.lean)
      LeanState.act(s.id);
    }
    catch (e) { s.lastResult = `[ERR: ${e.message}]`; }
  }

  // ── INVERSE TRANSFORM: Ψ[16] → λ ─────────────────────────────────────
  // Energy conservation: bound ‖Ψ‖² to prevent blowup from compound operators
  // Max energy = 16 × 500² = 4,000,000 (generous ceiling)
  VTX.normalize(100000);
  // Reconstruct 4-vector from transformed vertex field
  VTX.inverse();

  // ── OSCILLATORY LAMBDA DRIVER ──────────────────────────────────────
  // AFTER inverse (so it's not overwritten). φ-incommensurate frequencies
  // create persistent non-repeating dynamics that sutras modulate.
  {
    const t = simTime * 0.001;
    const P = USO.P, S = USO.S;
    const targets = [
      (3 + P * 2) * sin(t * 1.0000),
      (4 + S * 2) * sin(t * C.phi_f + PI * 0.25),
      (5 + P * 1.5) * cos(t * C.phi_f * C.phi_f + PI * 0.5),
      (6 + S * 1.5) * sin(t * C.sqrt2_f + PI * 0.75)
    ];
    for (let k = 0; k < 4; k++) {
      const target = Q.mk(Bi(targets[k] * 1000), 1000n);
      const diff = Q.sub(target, lambda[k]);
      lambda[k] = Q.add(lambda[k], Q.mul(diff, Q.mk(30n, 1000n)));
    }
  }

  CASCADE.update();

  // POST-SANITIZE: QI interval bounds again after evolves
  QI.clampLambda();

  // Advance deterministic simulation time (decoupled from wall clock)
  simTime += SIM_DT;
  cycle++;
  computeR4();
  if (cycle % 10 === 0) computeUSO();

  // TGCR: clamp vortex omega to prevent energy divergence
  TGCR.clampOmega();

  // Update TGCR from current vortex state — coupled to Lean momentum (State.lean: X'=X+x*k)
  if (cycle % 5 === 0) {
    const theta_avg = (cycle * 0.01) % TAU;
    const phi_avg = (cycle * 0.007) % TAU;
    // Momentum coupling: soft saturate to [0,1] for stable TGCR speed
    const momContrib = abs(LeanState.momX()) / (1 + abs(LeanState.momX()));
    TGCR.setVortex(theta_avg, phi_avg, abs(vortexOmega) + 0.1 + momContrib * 0.5);
    TGCR.computeEnergy();
    TGCR.checkPhaseLock(theta_avg, 0.333); // a=1/3 for θ/(3a)=1
  }

  // Update MSTVQ tensor — coupled to Lean momentum (State.lean: Y'=Y+y*k, Z'=Z+z*k)
  if (cycle % 8 === 0) {
    const mY = LeanState.momY(), mZ = LeanState.momZ();
    const momYn = mY / (1 + abs(mY)) * 0.1;
    const momZn = mZ / (1 + abs(mZ)) * 0.1;
    const feNorm = fieldEnergy() / (1 + fieldEnergy()) * 0.02;
    MSTVQ.setB(Q.fl(lambda[0]) * 0.01 + momYn, Q.fl(lambda[1]) * 0.01 + momZn, feNorm);
    MSTVQ.compute();
    // FEEDBACK LOOP: MSTVQ trace → TGCR κ + MSTVQ stress → λ
    MSTVQ.feedbackToTGCR();
    MSTVQ.feedbackToLambda(lambda);
  }

  // Update Ansatz with FEEDBACK to λ
  if (cycle % 30 === 0) {
    ANSATZ.computeEnergy(lambda);
    // VQE optimization: update circuit parameters toward lower energy
    if (cycle % 60 === 0) ANSATZ.updateParams(lambda, 0.01);
    // Ansatz energy gradient feeds back into λ
    ANSATZ.feedbackToLambda(lambda);
  }

  updateField(simTime);
  projectTorus(simTime);

  // Render — black background with subtle energy glow
  ctx.fillStyle = '#050510';
  ctx.fillRect(0, 0, cw, ch);
  const rawEnergy = fieldEnergy();
  const energy = rawEnergy / (1 + rawEnergy); // [0,1)
  const glowR = 120 + energy * 100 + abs(vortexOmega) * 40;
  const grd = ctx.createRadialGradient(cw/2, ch/2, 0, cw/2, ch/2, glowR);
  grd.addColorStop(0, `rgba(${floor(15 + energy * 30)},${floor(8 + abs(vortexOmega) * 15)},${floor(25 + energy * 25)},0.25)`);
  grd.addColorStop(0.6, `rgba(10,5,20,0.1)`);
  grd.addColorStop(1, 'rgba(5,5,16,0)');
  ctx.fillStyle = grd;
  ctx.fillRect(0, 0, cw, ch);

  renderTorus();
  renderTesseract(simTime);

  // Recording indicator overlay (drawn on canvas so it's captured in video)
  if (recorder && recorder.state === 'recording') {
    const elapsed = (performance.now() - recordingStart) / 1000;
    const remaining = max(0, RECORD_DURATION / 1000 - elapsed);
    ctx.fillStyle = 'rgba(180,0,0,0.7)';
    ctx.fillRect(cw - 200, 10, 190, 28);
    ctx.fillStyle = '#fff';
    ctx.font = '13px monospace';
    ctx.fillText(`● REC ${floor(elapsed)}s / ${RECORD_DURATION/1000}s  -${floor(remaining)}s`, cw - 195, 30);
  }

  if (cycle % 8 === 0) updateHUD();

  } catch (frameErr) {
    // Frame error recovery — reset lambda to safe values, keep running
    for (let k = 0; k < 4; k++) lambda[k] = Q.mk(BigInt(k + 3));
    LeanState.reset(); // Reset verified state too
    console.warn('Frame recovery:', frameErr.message);
  }
  // rAF ALWAYS fires — simulation never dies
  requestAnimationFrame(frame);
}

function updateHUD() {
  document.getElementById('v-r4').textContent = sf(Q.fl(R4val),6);
  document.getElementById('v-l0').textContent = Q.str(lambda[0]);
  document.getElementById('v-l1').textContent = Q.str(lambda[1]);
  document.getElementById('v-l2').textContent = Q.str(lambda[2]);
  document.getElementById('v-l3').textContent = Q.str(lambda[3]);
  document.getElementById('v-uso').textContent = sf(USO_U,4);
  document.getElementById('v-tgcr').textContent = sf(TGCR.energy,4);
  document.getElementById('v-mstvq').textContent = sf(MSTVQ.trace(),4);
  document.getElementById('v-wheeler').textContent = sf(C.phi_cu_f,4);
  document.getElementById('v-maya').textContent = `${MAYA.state(cycle).tz.number}.${MAYA.state(cycle).tz.glyph}`;
  document.getElementById('v-ansatz').textContent = sf(ANSATZ.energy / (1 + abs(ANSATZ.energy) * 0.01), 4);
  document.getElementById('v-vortex').textContent = sf(vortexOmega,4);
  // Lean-verified: Σδ(1..29)=435 (Proofs.lean: all_sum), momentum from State evolution
  const activeIds = SUTRAS.filter(s => s.on).map(s => s.id);
  const sigmaD = activeIds.reduce((a, id) => a + id, 0);
  document.getElementById('v-sigma').textContent = `${sigmaD}/435`;
  // Compact momentum display
  const fmtMom = v => { const a = abs(v); return a > 1e6 ? sf(v/1e6,1)+'M' : a > 1e3 ? sf(v/1e3,1)+'K' : sf(v,1); };
  document.getElementById('v-mom').textContent = `${fmtMom(LeanState.momX())},${fmtMom(LeanState.momY())},${fmtMom(LeanState.momZ())}`;
  document.getElementById('v-cascade').textContent = CASCADE.active ? `S${CASCADE.current + 1}/29` : (CASCADE.impulses.length > 0 ? `dec(${CASCADE.impulses.length})` : '—');
  document.getElementById('v-active').textContent = SUTRAS.filter(s => s.on).length;
  document.getElementById('v-cycle').textContent = cycle;

  const al = document.getElementById('active-list');
  const act = SUTRAS.filter(s => s.on);
  al.innerHTML = act.length === 0 ? '<div style="color:#444">none</div>' :
    act.map(s => `<div class="asutra"><span class="an">S${s.id}</span> ${s.sk} <span class="av">(${s.m},${s.n})</span></div>`).join('');

  const fd = document.getElementById('formula-display');
  fd.innerHTML = act.length === 0 ? 'Toggle a sūtra to begin' :
    act.slice(0, 5).map(s => `<div style="margin-bottom:3px"><b style="color:#d4af37">S${s.id}</b>: ${s.lastResult || s.desc}</div>`).join('');
}

