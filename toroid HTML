  // 4D rotation: XW plane (vortex-coupled) — the hypercube morph
  const cxw = cos(TESS_ROT.xw), sxw = sin(TESS_ROT.xw);
  let nx = x * cxw - w * sxw, nw = x * sxw + w * cxw;
  x = nx; w = nw;

