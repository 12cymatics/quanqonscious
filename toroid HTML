// §17 VIDEO EXPORT — Canvas MediaRecorder (60s capture, MP4/WebM cross-platform)
// ═══════════════════════════════════════════════════════════════════════════════
let recorder = null, recordChunks = [], recordingStart = 0;
const RECORD_DURATION = 60000; // 60 seconds max
let recordTimer = null;

// Detect best available codec — Safari/iOS needs MP4, Chrome/Firefox use WebM
function detectMimeType() {
  if (typeof MediaRecorder === 'undefined') return null;
  // Priority order: MP4 (Safari/iOS), VP9 (Chrome), VP8 (Firefox), WebM fallback
  const candidates = [
    'video/mp4',
    'video/mp4;codecs=avc1',
    'video/webm;codecs=vp9',
    'video/webm;codecs=vp8',
    'video/webm'
  ];
  for (const mime of candidates) {
    try { if (MediaRecorder.isTypeSupported(mime)) return mime; } catch(e) {}
  }
  return null;
}

function getFileExtension(mimeType) {
  return mimeType.startsWith('video/mp4') ? 'mp4' : 'webm';
}

function resetExportButton() {
  const btn = document.getElementById('btn-export');
  btn.textContent = 'EXPORT';
  btn.style.background = '';
}

function stopRecording() {
  if (recordTimer) { clearTimeout(recordTimer); recordTimer = null; }
  if (recorder && recorder.state === 'recording') {
    try { recorder.stop(); } catch(e) { console.warn('Stop error:', e); }
  }
}

document.getElementById('btn-export').addEventListener('click', () => {
  const btn = document.getElementById('btn-export');

  // If already recording, stop early
  if (recorder && recorder.state === 'recording') {
    stopRecording();
    return;
  }

  // Check API availability
  if (typeof MediaRecorder === 'undefined') {
    btn.textContent = 'NO RECORDER API';
    btn.style.background = '#800';
    setTimeout(resetExportButton, 3000);
    return;
  }

  const mimeType = detectMimeType();
  if (!mimeType) {
    btn.textContent = 'NO CODEC';
    btn.style.background = '#800';
    setTimeout(resetExportButton, 3000);
    return;
  }

  let stream;
  try {
    stream = canvas.captureStream(30); // 30 fps capture
  } catch(e) {
    btn.textContent = 'CAPTURE FAILED';
    btn.style.background = '#800';
    console.error('captureStream failed:', e);
    setTimeout(resetExportButton, 3000);
    return;
  }

  recordChunks = [];
  const ext = getFileExtension(mimeType);

  try {
    recorder = new MediaRecorder(stream, {
      mimeType,
      videoBitsPerSecond: 8000000 // 8 Mbps for quality
    });
  } catch(e) {
    // Some browsers reject bitrate option — retry without it
    try {
      recorder = new MediaRecorder(stream, { mimeType });
    } catch(e2) {
      btn.textContent = 'RECORDER FAILED';
      btn.style.background = '#800';
      console.error('MediaRecorder init failed:', e2);
      setTimeout(resetExportButton, 3000);
      return;
    }
  }

  recorder.ondataavailable = e => {
    if (e.data && e.data.size > 0) recordChunks.push(e.data);
  };

  recorder.onstop = () => {
    if (recordChunks.length === 0) {
      btn.textContent = 'NO DATA';
      btn.style.background = '#800';
      recorder = null;
      setTimeout(resetExportButton, 3000);
      return;
    }

    const blob = new Blob(recordChunks, { type: mimeType });
    const elapsed = floor((performance.now() - recordingStart) / 1000);
    const ts = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
    const filename = `vedic-v13-${ts}-${elapsed}s-${cycle}cyc.${ext}`;
    const sizeMB = (blob.size / (1024 * 1024)).toFixed(1);

    // Create download link — on iOS this opens the share sheet / "Save to Files" prompt
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    // iOS Safari needs the link in the DOM briefly
    a.style.display = 'none';
    document.body.appendChild(a);
    a.click();

    // Brief delay before cleanup so iOS can process the download
    setTimeout(() => {
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }, 2000);

    btn.textContent = `SAVED ${sizeMB}MB`;
    btn.style.background = '#060';
    recorder = null;
    recordChunks = [];
    recordTimer = null;
    setTimeout(resetExportButton, 4000);
  };

  recorder.onerror = err => {
    console.error('Recording error:', err);
    recorder = null;
    recordChunks = [];
    recordTimer = null;
    btn.textContent = 'REC ERROR';
    btn.style.background = '#800';
    setTimeout(resetExportButton, 3000);
  };

  // Start recording — collect data every 1s for responsive stop
  recorder.start(1000);
  recordingStart = performance.now();
  btn.textContent = 'REC ● TAP TO STOP';
  btn.style.background = '#a00';

  // Auto-stop after 60s
  recordTimer = setTimeout(() => {
    if (recorder && recorder.state === 'recording') recorder.stop();
  }, RECORD_DURATION);
});

