    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S21: Guṇitasamuccayah Samuccayaguṇitaḥ — "Osculation"
  // TYPE: MODULAR
  // Oscillatory modular composition: vertex values at Hamming-adjacent pairs
  // should satisfy divisibility by 7 after osculation.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:21, name:'Guṇitasamuccayah Samuccayaguṇitaḥ', sk:'गुणितसमुच्चयः', m:1, n:3, amp:0.3, freq:0.8,
    desc:'MODULAR: oscillatory divisibility by 7 on edge pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(21);
      const osculator = 5; // for divisibility by 7: osculator = (7+1)/2 rounded
      for (let i = 0; i < 16; i++) {
        const v = abs(floor(Q.fl(VTX.psi[i])));
        // Osculation: split last digit, multiply by osculator, add to remaining
        const lastDigit = v % 10;
        const remaining = floor(v / 10);
        const osculated = remaining + lastDigit * osculator;
        const target = osculated % 7 === 0 ? v : v + (7 - osculated % 7);
        const diff = target - v;
        if (abs(diff) > 0 && abs(diff) < 100) {
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(α * diff * 10000), 10000n));
        }
      }
      INTER_SUTRA.recordInteraction(21, 20);
      return `S21: MOD osculation α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S22: Dvandvayogaḥ — "Duplex / Double"
  // TYPE: REFLECTIVE
  // Double complement: reflect each vertex toward mean of it + its complement.
  // Ψ'ᵢ = (1-α)·Ψᵢ + α·(Ψᵢ+Ψ_c)/2 — balance with complement
  // ═══════════════════════════════════════════════════════════════════════════
  { id:22, name:'Dvandvayogaḥ', sk:'द्वन्द्वयोगः', m:0, n:2, amp:0.35, freq:0.9,
    desc:'REFLECTIVE: balance vertex with its complement (Ψᵢ+Ψ_c)/2',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(22);
      for (let i = 0; i < 16; i++) {
        const c = VTX.comp(i);
        const balanced = Q.div(Q.add(VTX.psi[i], VTX.psi[c]), Q.mk(2n));
        const diff = Q.sub(balanced, VTX.psi[i]);
        // REFLECTIVE: → identity when α→0
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(22, 2);
      return `S22: REFL duplex balance α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S23: Antyayordaśake'pi — "Terminal digit coherence"
  // TYPE: REFLECTIVE
  // Terminal digits of complementary vertex pairs should sum to 10.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:23, name:"Antyayordaśake'pi", sk:'अन्त्ययोः', m:1, n:0, amp:0.25, freq:0.85,
    desc:'REFLECTIVE: terminal digits of vertex complement pairs sum to 10',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(23);
      for (let i = 0; i < 8; i++) {
        const j = VTX.comp(i);
        const di = abs(floor(Q.fl(VTX.psi[i]))) % 10;
        const dj = abs(floor(Q.fl(VTX.psi[j]))) % 10;
        const sum = di + dj;
        if (sum !== 10 && sum !== 0) {
          const adj = (10 - sum) / 2;
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(α * adj * 10000), 10000n));
          VTX.psi[j] = Q.add(VTX.psi[j], Q.mk(Bi(α * adj * 10000), 10000n));
        }
      }
      INTER_SUTRA.recordInteraction(23, 12);
      return `S23: REFL terminal-10 α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S24: Lopanasthāpanābhyām — "By elimination and retention"
  // TYPE: MODULAR
  // GCD of vertex field tails (last N digits) — common factors eliminated.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:24, name:'Lopanasthāpanābhyām', sk:'लोपन', m:2, n:3, amp:0.25, freq:0.8,
    desc:'MODULAR: GCD of vertex tails for factor elimination',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(24);
      // Extract last 2 digits from each vertex magnitude
      const tails = [];
      for (let i = 0; i < 16; i++) tails.push(BigInt(abs(floor(Q.fl(VTX.psi[i]))) % 100));
      // Find GCD of all tails
