  },

  // Ricci curvature: discrete second derivative with PERIODIC boundary conditions
  // R_k ≈ f_{k-1} + f_{k+1} - 2f_k (same stencil as Laplacian but with curvature scaling)
  // On a compact manifold (periodic λ-array = S¹ topology), all points have valid neighbors
  ricciTerm(lam, k) {
    const N = lam.length;
    const prev = Q.fl(lam[((k - 1) % N + N) % N]);
    const curr = Q.fl(lam[k]);
    const next = Q.fl(lam[(k + 1) % N]);
    return prev + next - 2 * curr;
  },

