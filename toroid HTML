  // This IS the discrete heat equation on the 4-cube graph.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:9, name:'Calana-Kalanābhyām', sk:'चलन', m:0, n:3, amp:0.3, freq:0.7,
    desc:'DIFFUSIVE: Graph Laplacian ΔΨᵢ = Σ_{j~i}(Ψⱼ-Ψᵢ) on tesseract',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(9);
      const grvq = GRVQ.evolve(lambda, 0, simTime);
      // Compute graph Laplacian: 4-regular graph
      const lap = new Array(16);
      for (let i = 0; i < 16; i++) {
        lap[i] = Q.neg(Q.mul(Q.mk(4n), VTX.psi[i]));
        for (const j of VTX.neighbors(i)) lap[i] = Q.add(lap[i], VTX.psi[j]);
      }
      // DIFFUSIVE: Ψ' = Ψ + α·ΔΨ (heat diffusion on tesseract)
      for (let i = 0; i < 16; i++) {
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(lap[i], Q.mk(Bi(α * 10000), 10000n)));
      }
      const d1 = Q.fl(Q.sub(VTX.psi[1], VTX.psi[0]));
      INTER_SUTRA.recordInteraction(9, 7);
      return `S9: DIFF Δ¹=${sf(d1,3)} lap₀=${sf(Q.fl(lap[0]),2)} α=${sf(α,4)} G=${sf(grvq,3)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S10: Yāvadūnam — "By the deficiency"
  // TYPE: MULTIPLICATIVE
  // Squaring via deficiency: (B-d)² = B²-2Bd+d²
  // Vertex field squared relative to base, multiplicative coupling.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:10, name:'Yāvadūnam', sk:'यावदूनम्', m:1, n:2, amp:0.5, freq:1.05,
    desc:'MULTIPLICATIVE: Ψ\'ᵢ = Ψᵢ·(1+α·(dᵢ/B)²) — deficiency squaring',
    evolve(dt) {
