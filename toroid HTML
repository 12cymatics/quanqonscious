ANSATZ.computeEnergy(lambda);
[0, 2, 8].forEach(idx => {
  SUTRAS[idx].on = true;
  const els = document.querySelectorAll('.st');
  if (els[idx]) els[idx].classList.add('active');
});
vortexOmega = 0.15;
requestAnimationFrame(frame);
