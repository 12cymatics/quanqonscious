// §12A  VEDIC DIGIT-LEVEL HELPERS — BigInt exact arithmetic
//
// These implement the fundamental digit-extraction and recombination
// operations that Bharati Krishna Tirthaji's sutra system operates on.
// All functions: BigInt → BigInt (zero IEEE-754 contamination)
// ═══════════════════════════════════════════════════════════════════════════════

// Extract digits of |n| as array, most-significant-digit first
function bigDigits(n) {
  n = n < 0n ? -n : n;
  if (n === 0n) return [0n];
  const d = []; while (n > 0n) { d.unshift(n % 10n); n /= 10n; } return d;
}
// Reconstruct BigInt from MSD-first digit array
function fromDigits(d) {
  let r = 0n; for (const x of d) r = r * 10n + x; return r;
}
// Number of decimal digits
function bigNumDigits(n) {
  n = n < 0n ? -n : n; if (n === 0n) return 1;
  let c = 0; while (n > 0n) { c++; n /= 10n; } return c;
}
// Smallest 10^k ≥ |n| (nearest Vedic base)
function nearestBase10(n) {
  n = n < 0n ? -n : n; let B = 1n; while (B <= n) B *= 10n; return B;
}
// Exact integer square root (Newton's method, BigInt)
function bigISqrt(n) {
  if (n < 0n) return 0n; if (n < 2n) return n;
  let x = n, y = (x + 1n) / 2n;
  while (y < x) { x = y; y = (x + n / x) / 2n; }
  return x;
}
// BigInt abs
function bigAbs(n) { return n < 0n ? -n : n; }
// Digit sum of |n| (BigInt exact)
function bigDigitSum(n) {
  n = n < 0n ? -n : n; let s = 0n;
  while (n > 0n) { s += n % 10n; n /= 10n; }
  return s;
}
// BigInt min/max
function bigMin(a, b) { return a < b ? a : b; }
function bigMax(a, b) { return a > b ? a : b; }
// Extended Euclidean: returns {g, s, t} where a*s + b*t = g = gcd(a,b)
function bigExtGCD(a, b) {
  a = bigAbs(a); b = bigAbs(b);
  if (b === 0n) return { g: a, s: 1n, t: 0n };
  let old_r = a, r = b, old_s = 1n, s = 0n, old_t = 0n, t = 1n;
  while (r !== 0n) {
    const q = old_r / r;
    [old_r, r] = [r, old_r - q * r];
    [old_s, s] = [s, old_s - q * s];
    [old_t, t] = [t, old_t - q * t];
  }
  return { g: old_r, s: old_s, t: old_t };
}
// Duplex (Dvandva-yoga): D(n) for squaring sutra
// For digits [d₁,d₂,...,dₖ]: D = d₁×dₖ + d₂×d_{k-1} + ... (pairs from outside in)
// + middle² if odd count
function duplex(digits) {
  const k = digits.length;
  let d = 0n;
  for (let i = 0; i < Math.floor(k / 2); i++) d += digits[i] * digits[k - 1 - i] * 2n;
  if (k % 2 === 1) d += digits[Math.floor(k / 2)] ** 2n;
  return d;
}
// Ūrdhva-Tiryagbhyām crosswise column convolution for position k
// c_k = Σ_{i+j=k} a_i × b_j  (LSD-first arrays)
function crosswiseColumn(aLSD, bLSD, k) {
  let s = 0n;
  const maxI = Math.min(k, aLSD.length - 1);
  for (let i = 0; i <= maxI; i++) {
    const j = k - i;
    if (j >= 0 && j < bLSD.length) s += aLSD[i] * bLSD[j];
  }
  return s;
}
// Continued fraction expansion of p/q: returns array of partial quotients
function continuedFrac(p, q, maxTerms = 8) {
  p = bigAbs(p); q = bigAbs(q) || 1n;
  const cf = [];
  while (q !== 0n && cf.length < maxTerms) {
    cf.push(p / q);
    [p, q] = [q, p % q];
  }
  return cf;
}
// Evaluate continued fraction convergent p_n/q_n from partial quotients
function cfConvergent(cf) {
  let p0 = 1n, p1 = cf[0], q0 = 0n, q1 = 1n;
  for (let i = 1; i < cf.length; i++) {
    const a = cf[i];
    [p0, p1] = [p1, a * p1 + p0];
    [q0, q1] = [q1, a * q1 + q0];
  }
  return { p: p1, q: q1 };
}
// Nikhilam complement: 9's complement of each digit, 10's complement of last
function nikhilamComplement(n, B) {
  n = bigAbs(n);
  return B - n; // The deficiency from the base
}
// Osculation test: multiply last digit by osculator, add to rest
function osculate(n, osculator) {
  n = bigAbs(n);
  const last = n % 10n, rest = n / 10n;
  return rest + last * osculator;
}


