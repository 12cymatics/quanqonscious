  let t1;
  t1 = x3 * cos(camRY) - z3 * sin(camRY); z3 = x3 * sin(camRY) + z3 * cos(camRY); x3 = t1;
  t1 = y3 * cos(camRX) - z3 * sin(camRX); z3 = y3 * sin(camRX) + z3 * cos(camRX); y3 = t1;
  // Perspective divide
  const pScale = CAM_DIST / (CAM_DIST + z3);
  return { sx: cx + x3 * pScale, sy: cy + y3 * pScale, depth: z3 };
}

// Shortest angular interpolation (handles 2π wraparound)
function lerpAngle(a, b, t) {
  let diff = b - a;
