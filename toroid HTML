// ═══════════════════════════════════════════════════════════════════════════════
// §8 HYBRID ANSATZ — VQE Parameterized Circuit
//
// |ψ(θ)⟩ = U(θ)|0⟩ — hardware-efficient ansatz
// Layer ℓ: Ry(θᵢ,ℓ) rotations + CNOT entanglement
// E(θ) = Σᵢ αᵢ ⟨ψ(θ)|Pᵢ|ψ(θ)⟩ (energy from Pauli decomposition)
// Grover amplitude: ≈ sin((2k+1)θ/2) after k iterations, θ ≈ 2/√N
// ═══════════════════════════════════════════════════════════════════════════════
const ANSATZ = {
  nQubits: 4,
  nLayers: 3,
  params: new Float64Array(4 * 3), // nQubits × nLayers
  energy: 0,

  init() {
    // Initialize with golden-ratio-spaced angles
    for (let l = 0; l < this.nLayers; l++) {
      for (let q = 0; q < this.nQubits; q++) {
        this.params[l * this.nQubits + q] = C.phi_f * (l * this.nQubits + q) % TAU;
      }
    }
  },

  // Single-qubit Ry rotation matrix element: Ry(θ) = [[cos(θ/2), -sin(θ/2)], [sin(θ/2), cos(θ/2)]]
  ry(theta) {
    return { c: cos(theta / 2), s: sin(theta / 2) };
  },

  // Compute state amplitudes after full circuit: all 3 layers with CNOT entanglement
  // Returns array of 2^nQubits amplitudes (real part only — sufficient for Z-basis measurement)
  computeState() {
    const nStates = 1 << this.nQubits; // 2^4 = 16
    // Start in |0000⟩
    const stateReal = new Float64Array(nStates);
    const stateImag = new Float64Array(nStates);
    stateReal[0] = 1.0; // |0000⟩

    for (let l = 0; l < this.nLayers; l++) {
      // Layer l: apply Ry(θ_{q,l}) to each qubit
      for (let q = 0; q < this.nQubits; q++) {
        const theta = this.params[l * this.nQubits + q];
        const c = cos(theta / 2), s = sin(theta / 2);
        const newReal = new Float64Array(nStates);
        const newImag = new Float64Array(nStates);
        const mask = 1 << q;
        for (let i = 0; i < nStates; i++) {
          if (!(i & mask)) {
            // |0⟩ component at qubit q
            const j = i | mask; // corresponding |1⟩ state
            // Ry: |0⟩ → c|0⟩ + s|1⟩, |1⟩ → -s|0⟩ + c|1⟩
            newReal[i] += c * stateReal[i] - s * stateReal[j];
            newImag[i] += c * stateImag[i] - s * stateImag[j];
            newReal[j] += s * stateReal[i] + c * stateReal[j];
            newImag[j] += s * stateImag[i] + c * stateImag[j];
          }
        }
        stateReal.set(newReal);
        stateImag.set(newImag);
      }

      // CNOT entanglement: CNOT(q, q+1) for q = 0..nQubits-2 (linear chain)
      for (let q = 0; q < this.nQubits - 1; q++) {
        const controlMask = 1 << q;
        const targetMask = 1 << (q + 1);
        const newReal = new Float64Array(stateReal);
        const newImag = new Float64Array(stateImag);
        for (let i = 0; i < nStates; i++) {
          if (i & controlMask) {
            // Control qubit is |1⟩ → flip target
            const j = i ^ targetMask;
            newReal[i] = stateReal[j];
            newImag[i] = stateImag[j];
            newReal[j] = stateReal[i];
            newImag[j] = stateImag[i];
          }
        }
        stateReal.set(newReal);
        stateImag.set(newImag);
      }
    }

    return { real: stateReal, imag: stateImag };
  },

  // Compute expectation: ⟨ψ(θ)|H|ψ(θ)⟩ with full circuit simulation
  // Hamiltonian: H = Σᵢ λᵢ Zᵢ + ½ Σᵢ Zᵢ Zᵢ₊₁ (Ising model)
  computeEnergy(lambda) {
    const state = this.computeState();
    const nStates = 1 << this.nQubits;
    let E = 0;

    for (let basis = 0; basis < nStates; basis++) {
      const prob = state.real[basis] * state.real[basis] + state.imag[basis] * state.imag[basis];
      if (prob < 1e-15) continue;

      // Compute ⟨basis|H|basis⟩ for this basis state
      let hDiag = 0;
      for (let q = 0; q < this.nQubits; q++) {
        // Z eigenvalue: +1 for |0⟩, -1 for |1⟩
        const zq = (basis & (1 << q)) ? -1 : 1;
        hDiag += Q.fl(lambda[q]) * zq;

        // ZZ coupling with next qubit
        if (q < this.nQubits - 1) {
          const zq1 = (basis & (1 << (q + 1))) ? -1 : 1;
          hDiag += 0.5 * zq * zq1;
        }
      }
      E += prob * hDiag;
    }

    this.energy = E;
    return E;
  },

  // Grover amplitude after k iterations for N states
  groverAmplitude(k, N) {
    const theta = 2 / sqrt(N);
    return sin((2 * k + 1) * theta / 2);
  },

  // Update parameters via gradient descent with parameter shift rule
  // θ_new = θ_old - η·∇E, where ∇E_i = (E(θ_i+π/2) - E(θ_i-π/2))/2
  updateParams(lambda, learningRate) {
    for (let i = 0; i < this.params.length; i++) {
      const orig = this.params[i];
      this.params[i] = orig + PI / 2;
      const Eplus = this.computeEnergy(lambda);
      this.params[i] = orig - PI / 2;
      const Eminus = this.computeEnergy(lambda);
      this.params[i] = orig;
      const grad = (Eplus - Eminus) / 2;
      this.params[i] -= learningRate * grad;
      // Wrap to [0, 2π) to prevent drift
      this.params[i] = ((this.params[i] % TAU) + TAU) % TAU;
    }
    return this.computeEnergy(lambda);
  },

  // FEEDBACK: Ansatz energy gradient feeds back into λ as exact rational perturbation
  // This closes the VQE loop: minimize E(θ) w.r.t. θ, then adjust λ toward lower energy
  feedbackToLambda(lambda) {
    if (abs(this.energy) < 1e-12) return;
    // Energy gradient w.r.t. each λ_k: ∂E/∂λ_k = ⟨Z_k⟩ (from Ising Hamiltonian)
    const state = this.computeState();
    const nStates = 1 << this.nQubits;
    for (let q = 0; q < this.nQubits; q++) {
      let expectZ = 0;
      for (let basis = 0; basis < nStates; basis++) {
        const prob = state.real[basis] * state.real[basis] + state.imag[basis] * state.imag[basis];
        const zq = (basis & (1 << q)) ? -1 : 1;
        expectZ += prob * zq;
      }
      // Nudge λ_q in direction of lower energy: -η·∂E/∂λ_q = -η·⟨Z_q⟩
      const nudge = -0.001 * expectZ;
      if (isFinite(nudge) && abs(nudge) > 1e-10) {
        lambda[q] = Q.add(lambda[q], Q.mk(Bi(nudge * 1000), 1000000n));
      }
    }
  }
};
