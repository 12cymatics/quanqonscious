// §12D  VILOKANAM PATTERN RECOGNITION ENGINE
//
// Detects: perfect squares, difference of squares, Pythagorean triples,
//          arithmetic progressions, geometric progressions
// All operations use BigInt for exact integer detection
// ═══════════════════════════════════════════════════════════════════════════════
const VILOKANAM = {
  // Perfect square test via BigInt Newton isqrt
  isPerfectSquare(n) {
    n = bigAbs(n); if (n < 2n) return true;
    const s = bigISqrt(n);
    return s * s === n;
  },

  // Difference of squares: n = a² - b² = (a+b)(a-b)
  isDiffOfSquares(n) {
    n = bigAbs(n); if (n === 0n) return true;
    // n = a²-b² iff n is not ≡ 2 mod 4
    return n % 4n !== 2n;
  },

  // Pythagorean triple test: is (a,b,c) a valid triple?
  isPythTriple(a, b, c) {
    return a * a + b * b === c * c;
  },

  // Arithmetic progression test
  isArithProg(arr) {
    if (arr.length < 3) return true;
    const d = arr[1] - arr[0];
    for (let i = 2; i < arr.length; i++) {
      if (arr[i] - arr[i - 1] !== d) return false;
    }
    return true;
  },

  // Geometric progression test
  isGeoProg(arr) {
    if (arr.length < 3) return true;
    if (arr[0] === 0) return false;
    const r0num = arr[1], r0den = arr[0]; // ratio = arr[1]/arr[0]
    for (let i = 2; i < arr.length; i++) {
      // Check arr[i]/arr[i-1] = r0num/r0den
      // i.e. arr[i] * r0den === arr[i-1] * r0num
      if (arr[i] * r0den !== arr[i - 1] * r0num) return false;
    }
    return true;
  },

  // Comprehensive pattern recognition on a BigInt value
  recognize(n) {
    n = bigAbs(n);
    const patterns = [];
    if (this.isPerfectSquare(n)) patterns.push('□');
    if (this.isDiffOfSquares(n)) patterns.push('□²-□²');
    if (n > 0n && n % 2n === 0n) patterns.push('2|n');
    if (n > 0n && n % 3n === 0n) patterns.push('3|n');
    if (n > 0n && n % 7n === 0n) patterns.push('7|n');
    return patterns.length > 0 ? patterns.join(',') : '∅';
  }
};

