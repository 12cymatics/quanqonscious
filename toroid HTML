  g: 1.0,       // Gravitational coupling
  r: 0.5,       // Ricci scalar coefficient
  v: 0.3,       // Vacuum expectation
  q: 0.7,       // Quantum field strength
  lambda: 0.2,  // Cosmological constant Λ
