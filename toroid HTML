// §12G  29 SŪTRA — FIELD OPERATOR ARCHITECTURE
//
// CRITICAL DESIGN: Each sutra is a FIELD OPERATOR, not a textbook demonstration.
// The sutra's mathematical principle DEFINES the transformation topology on λ.
//
// OPERATOR EQUATION per sutra Sᵢ:
//   δλ = (i/435) · Δᵢ · φᵢ · Fᵢ(λ, R⁴, GRVQ, MSTVQ, TGCR, Wheeler, Maya)
//   λ' = λ + δλ
//
// Where:
//   Fᵢ(λ)     = sutra-specific 4-vector field transformation
//   Δᵢ         = USO delta (dynamic modulation from G_equiv·sin·exp formula)
//   φᵢ         = golden-ratio coefficient (geometric coupling dimension)
//   i/435      = conservation weight (Σᵢ₌₁²⁹ i/435 = 1)
//
// ZERO cookie-cutter patterns. Each sutra has UNIQUE operator topology.
// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════
// §13  VERTEX-FIELD SUTRA ARCHITECTURE
//
// SUBSTRATE: Ψ[16] = V·λ  where V = tesseract sign matrix
// SEVEN OPERATOR TYPES: Multiplicative, Reflective, Convolutive, Divisive,
//                       Diffusive, Permutative, Modular
// STRUCTURAL SUPPRESSION: α(n) = σ·e^(-|r|/(n+1))·Δₙ → operator becomes
//                         identity when α→0 (singularity, large radius, or weak field)
// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════
// §12X  VERTEX FIELD SUBSTRATE — Ψ[16] = V·λ
//
// The 16 vertices of the tesseract are the ACTUAL field substrate.
// Sutras transform vertex fields, NOT the flat 4-vector.
//
// Forward:  Ψᵢ = Σₖ sᵢₖ·λₖ   where sᵢₖ = (i & (1<<k)) ? +1 : -1
// Inverse:  λₖ = (1/16) Σᵢ sᵢₖ·Ψᵢ   (VᵀV = 16·I₄ orthogonality)
//
// Operators work in vertex space. Lambda is reconstructed ONCE after all sutras.
// ═══════════════════════════════════════════════════════════════════════════════
const VTX = {
  psi: Array.from({length:16}, () => Q.ZERO),
  signs: Array.from({length:16}, (_, i) => [
    (i & 1) ? 1n : -1n, (i & 2) ? 1n : -1n,
    (i & 4) ? 1n : -1n, (i & 8) ? 1n : -1n
  ]),
  forward() {
    for (let i = 0; i < 16; i++) {
      this.psi[i] = Q.ZERO;
      for (let k = 0; k < 4; k++)
        this.psi[i] = Q.add(this.psi[i], Q.mul(Q.mk(this.signs[i][k]), lambda[k]));
    }
  },
  inverse() {
    for (let k = 0; k < 4; k++) {
      let s = Q.ZERO;
      for (let i = 0; i < 16; i++)
        s = Q.add(s, Q.mul(Q.mk(this.signs[i][k]), this.psi[i]));
      lambda[k] = Q.div(s, Q.mk(16n));
    }
  },
  // Hamming weight of vertex index
  hw(i) { let c=0,n=i; while(n){c+=n&1;n>>=1;} return c; },
  // Complement vertex (bitwise NOT on 4 bits)
  comp(i) { return i ^ 15; },
  // 4 neighbors (Hamming distance 1)
  neighbors(i) { return [i^1, i^2, i^4, i^8]; },
  // Mean of all 16 vertex fields
  mean() { let s=Q.ZERO; for(const p of this.psi) s=Q.add(s,p); return Q.div(s,Q.mk(16n)); },
  // Norm²: Σ Ψᵢ²
  normSq() { let s=Q.ZERO; for(const p of this.psi) s=Q.add(s,Q.mul(p,p)); return s; },
  // Energy-preserving normalization: rescale Ψ so ‖Ψ‖² stays bounded
  // Allows gentle growth/decay but prevents blowup
  normalize(maxEnergy) {
    const E = Q.fl(this.normSq());
    if (!isFinite(E) || E <= 0) return;
    if (E > maxEnergy) {
      const scale = sqrt(maxEnergy / E);
      for (let i = 0; i < 16; i++)
        this.psi[i] = Q.mul(this.psi[i], Q.mk(Bi(scale * 10000), 10000n));
    }
    // Also clamp individual vertices to prevent single-vertex blowup
    for (let i = 0; i < 16; i++) {
      const v = Q.fl(this.psi[i]);
      if (!isFinite(v) || abs(v) > 200) {
        this.psi[i] = Q.mk(Bi(clamp(v, -200, 200) || 0));
      }
      // BigInt cap
      const an = this.psi[i].n < 0n ? -this.psi[i].n : this.psi[i].n;
      if (an > MAXN) this.psi[i] = Q.mk(Bi(Q.fl(this.psi[i])));
    }
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §12Y  STRUCTURAL SINGULARITY SUPPRESSION
//
// α(n) = σ · decay · Δₙ — controls operator deviation from identity
//
// σ = R⁴ = ∏ₖ λₖ⁴/(r⁴+λₖ⁴)  ∈ [0,1]  — singularity suppression
// decay = e^(-|r|/(n+1))                  — radial decay from USO formula
// Δₙ = USO delta                          — field-coherent modulation
//
// STRUCTURAL GUARANTEE: every operator type collapses to identity when α→0:
//   MULTIPLICATIVE:  Ψ' = Ψ·(1 + α·(M-1))       → Ψ·1 = Ψ
//   REFLECTIVE:      Ψ' = (1-α)·Ψ + α·R(Ψ)      → 1·Ψ + 0 = Ψ
//   CONVOLUTIVE:     Ψ' = Ψ + α·(C⊛Ψ - Ψ)       → Ψ + 0 = Ψ
//   DIFFUSIVE:       Ψ' = Ψ + α·ΔΨ               → Ψ + 0 = Ψ
//   DIVISIVE:        Ψ' = Ψ + α·(Q(Ψ) - Ψ)      → Ψ + 0 = Ψ
//   PERMUTATIVE:     Ψ' = (1-α)·Ψ + α·P(Ψ)      → Ψ
//   MODULAR:         Ψ' = Ψ + α·(Ψ mod B - Ψ)   → Ψ
//   CONSERVATION:    Ψ' = Ψ + α·(target - Ψ)     → Ψ
// ═══════════════════════════════════════════════════════════════════════════════
const SUPPRESS = {
  // Structural alpha: decay · sqrt(|Δₙ|) · sign(Δₙ)
  //
  // NO R⁴ factor — the vertex field substrate already encodes singularity geometry.
  // R⁴ in alpha was double-gating: small λ → small R⁴ → small α → operators freeze.
  //
  // Identity guarantee: when Δₙ→0 (field coherent), α→0 → operator→identity
  // Radial decay: operators weaken at large radius (USO formula)
  alpha(sid) {
    const R = abs(Q.fl(r_param));
    const decay = exp(-R / (sid + 1));
    const delta = USO.delta(sid);
    const softDelta = Math.sign(delta) * sqrt(abs(delta) + 0.001);
    return clamp(decay * softDelta * 0.5, -0.8, 0.8); // 0.5 = base coupling strength
  },
  alphaPhi(sid) {
    return this.alpha(sid) * Q.fl(SUTRA_COEFF[sid] || Q.ONE);
  }
};

