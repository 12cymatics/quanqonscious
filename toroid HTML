// Perspective camera distance — controls zoom level
const CAM_DIST = 1200; // higher = further away, gentler perspective

function torusToScreen(theta, phi, cx, cy) {
  let R = TORUS_R, r = TORUS_r;
  let x3 = (R + r * cos(phi)) * cos(theta);
  let y3 = r * sin(phi);
  let z3 = (R + r * cos(phi)) * sin(theta);
