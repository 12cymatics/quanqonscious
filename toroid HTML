const gcd = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a || 1n; };
const MAXD = 10n ** 10n;
const MAXN = 10n ** 15n; // Cap numerator to prevent BigInt computation explosion
const safeBi = v => { try { const x = Number(v); if (!isFinite(x)) return 0n; return BigInt(Math.round(x)); } catch { return 0n; } };
const Q = {
  mk(n, d = 1n) {
    if (typeof n !== 'bigint') n = safeBi(n);
    if (typeof d !== 'bigint') d = safeBi(d) || 1n;
    if (d === 0n) return { n: 0n, d: 1n };
    const g = gcd(n < 0n ? -n : n, d < 0n ? -d : d);
    const s = d < 0n ? -1n : 1n;
    let nn = s * n / g, dd = s * d / g;
    if (dd > MAXD) { const sc = dd / MAXD || 1n; nn = nn / sc; dd = MAXD; }
    // Cap numerator to prevent BigInt explosion freezing the browser
    const ann = nn < 0n ? -nn : nn;
    if (ann > MAXN) { const sc = ann / MAXN || 1n; nn = nn / sc; dd = dd / sc || 1n; }
