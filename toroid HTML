  vortexHelicity *= -1;
  vortexOmega += 3.0 * vortexHelicity;
});
document.getElementById('btn-pde').addEventListener('click', () => {
  SUTRAS.forEach(s => s.on = false);
  document.querySelectorAll('.st').forEach(el => el.classList.remove('active'));
  [3,4,7,9,11,13,17,19,27].forEach(id => {
