const QI = {
  mk(lo, hi) { return { lo: Q.fl(lo), hi: Q.fl(hi) }; },
  point(x) { const v = Q.fl(x); return { lo: v, hi: v }; },
  contains(I, x) { const v = Q.fl(x); return I.lo <= v && v <= I.hi; },
  add(A, B) { return { lo: A.lo + B.lo, hi: A.hi + B.hi }; },
