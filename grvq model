@dataclass
class GroverSearch:
    """
    Grover's Quantum Search Algorithm.
    
    # ```
    Complexity: O(√N) queries vs O(N) classical
    """
    
    num_qubits: int
    
    @property
    def database_size(self) -> int:
        return 2 ** self.num_qubits
    
    @property
    def optimal_iterations(self) -> int:
        """Optimal: ⌊π√N/4⌋"""
        return int(math.pi * math.sqrt(self.database_size) / 4)
    
    def oracle_specification(self, target_state: int) -> Dict[str, Any]:
        """
        Oracle O: |x⟩ → (-1)^f(x)|x⟩
        where f(x) = 1 if x = target, 0 otherwise
        """
        if target_state >= self.database_size:
            raise ValueError(f"Target {target_state} >= database size {self.database_size}")
        
        return {
            'type': 'phase_oracle',
            'target': target_state,
            'target_binary': format(target_state, f'0{self.num_qubits}b'),
            'action': 'Flip phase of |target⟩',
            'implementation': 'Multi-controlled Z with X gates for 0-controls'
        }
    
    def diffusion_operator(self) -> Dict[str, Any]:
        """
        Diffusion D = 2|ψ⟩⟨ψ| - I = H^⊗n (2|0⟩⟨0| - I) H^⊗n
        """
        return {
            'type': 'diffusion',
            'formula': 'D = H^⊗n (2|0⟩⟨0| - I) H^⊗n',
            'steps': [
                'Apply H to all qubits',
                'Apply X to all qubits',
                'Multi-controlled Z',
                'Apply X to all qubits',
                'Apply H to all qubits'
            ]
        }
    
    def algorithm_specification(self, target_state: int) -> Dict[str, Any]:
        """Complete Grover algorithm specification."""
        return {
            'num_qubits': self.num_qubits,
            'database_size': self.database_size,
            'target_state': target_state,
            'optimal_iterations': self.optimal_iterations,
            'success_probability': f'≈ 1 - O(1/N)',
            'speedup': 'O(√N) vs O(N) classical',
            'oracle': self.oracle_specification(target_state),
            'diffusion': self.diffusion_operator()
        }
    # ```
    
