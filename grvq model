# SUTRA 4: Parāvartya Yojayet - Transpose and Adjust
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_04_paravartya(dividend: Fraction, divisor: Fraction) -> Dict[str, Any]:
    """
    Parāvartya Yojayet: "Transpose and adjust."
    
    Division algorithm: transpose the divisor's sign and adjust.
    Used for algebraic division and polynomial division.
    
    For division p(x) / (x - a):
        Use synthetic division with +a (transposed from -a)
    """
    if divisor == 0:
        raise ValueError("Division by zero")
    
    quotient = dividend / divisor
    
    return {
        'sutra_index': 4,
        'sutra_name': 'Parāvartya Yojayet',
        'dividend': dividend,
        'divisor': divisor,
        'quotient': quotient,
        'formula': 'dividend / divisor with transposed sign',
        'application': 'Polynomial and algebraic division'
    }

# ═══════════════════════════════════════════════════════════════════════════
# SUTRA 5: Śūnyam Sāmyasamuccaye - If Sum is Same, Result is Zero
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_05_shunyam_samya(lhs_sum: Fraction, rhs_sum: Fraction) -> Dict[str, Any]:
    """
    Śūnyam Sāmyasamuccaye: "If sum is same, result is zero."
    
    If the sum of coefficients on both sides of an equation is equal,
    the equation reduces to 0.
    
    Application: Solving equations where coefficient sums match.
    """
    difference = lhs_sum - rhs_sum
    is_zero = difference == 0
    
    return {
        'sutra_index': 5,
        'sutra_name': 'Śūnyam Sāmyasamuccaye',
        'lhs_sum': lhs_sum,
        'rhs_sum': rhs_sum,
        'difference': difference,
        'is_zero': is_zero,
        'formula': 'If Σ(LHS) = Σ(RHS), then difference = 0',
        'application': 'Equation simplification and equilibrium detection'
    }

# ═══════════════════════════════════════════════════════════════════════════
# SUTRA 6: Ānurūpye Śūnyamanyat - If Proportional, Other is Zero
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_06_anurupye(a: Fraction, b: Fraction, 
                      c: Fraction, d: Fraction) -> Dict[str, Any]:
    """
    Ānurūpye Śūnyamanyat: "If proportional, the other is zero."
    
    If a/b = c/d, then ad - bc = 0.
    Used for solving proportional equations.
    """
    cross_product_1 = a * d
    cross_product_2 = b * c
    difference = cross_product_1 - cross_product_2
    is_proportional = difference == 0
    
    return {
        'sutra_index': 6,
        'sutra_name': 'Ānurūpye Śūnyamanyat',
        'a': a, 'b': b, 'c': c, 'd': d,
        'ad': cross_product_1,
        'bc': cross_product_2,
        'difference': difference,
        'is_proportional': is_proportional,
        'formula': 'a/b = c/d ⟺ ad - bc = 0'
    }

# ═══════════════════════════════════════════════════════════════════════════
# SUTRA 7: Saṅkalana-Vyavakalanābhyām - By Addition and Subtraction
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_07_sankalana_vyavakalana(x: Fraction, y: Fraction) -> Dict[str, Any]:
    """
    Saṅkalana-Vyavakalanābhyām: "By addition and subtraction."
    
    Solving simultaneous equations by adding and subtracting.
    Given x + y and x - y, find x and y.
    """
    sum_val = x + y
    diff_val = x - y
    
    # Solving: x = (sum + diff) / 2, y = (sum - diff) / 2
    x_solved = (sum_val + diff_val) / 2
    y_solved = (sum_val - diff_val) / 2
    
    return {
        'sutra_index': 7,
        'sutra_name': 'Saṅkalana-Vyavakalanābhyām',
        'x': x,
        'y': y,
        'sum': sum_val,
        'difference': diff_val,
        'x_from_system': x_solved,
        'y_from_system': y_solved,
        'formula': 'x = (sum + diff)/2, y = (sum - diff)/2',
        'verified': x_solved == x and y_solved == y
    }

