@dataclass
class DielectricRarefactionPDE:
    """
    Wheeler's Coupled PDE System for Dielectric-Cymatic Fields.
    
    # ```
    From source document:
    
    Primary Field u (gravitational/cymatic):
        ∂ₜu = D_u × ∇²u + M × sin(G_c × u)
    
    Dielectric Field D:
        ∂ₜₜD = c_D² × ∇²D - λ × ∂ₜD - α × D + β × u
    
    The β coupling uses φ³ to model Wheeler's prediction that
    "a surge in u causes D to rarefy."
    """
    
    # Primary field parameters
    D_u: Fraction = Fraction(1, 10)       # Diffusion
    M: Fraction = Fraction(1, 2)          # Modulation amplitude
    G_c: Fraction = PHI                   # Cymatic coupling (golden ratio)
    
    # Dielectric field parameters
    c_D: Fraction = Fraction(1)           # Wave speed
    lambda_damp: Fraction = Fraction(1, 5)
    alpha_restore: Fraction = Fraction(1, 10)
    beta_coupling: Fraction = PHI_CUBED   # φ³ coupling
    
    # Equilibrium
    D0: Fraction = Fraction(1)
    
    def primary_field_update(self, u: Fraction, laplacian_u: Fraction) -> Dict[str, Fraction]:
        """∂ₜu = D_u × ∇²u + M × sin(G_c × u)"""
        diffusion_term = self.D_u * laplacian_u
        
        oscillation_arg = float(self.G_c * u)
        oscillation_val = Fraction(float(self.M) * math.sin(oscillation_arg)).limit_denominator(10**15)
        
        du_dt = diffusion_term + oscillation_val
        
        return {
            'u': u,
            'laplacian_u': laplacian_u,
            'diffusion_term': diffusion_term,
            'oscillation_term': oscillation_val,
            'du_dt': du_dt,
            'formula': '∂ₜu = D_u × ∇²u + M × sin(G_c × u)'
        }
    
    def dielectric_field_update(self, D: Fraction, dD_dt: Fraction,
                                 laplacian_D: Fraction, u: Fraction) -> Dict[str, Fraction]:
        """∂ₜₜD = c_D² × ∇²D - λ × ∂ₜD - α × D + β × u"""
        c_D_sq = self.c_D * self.c_D
        
        wave_term = c_D_sq * laplacian_D
        damping_term = -self.lambda_damp * dD_dt
        restoring_term = -self.alpha_restore * D
        coupling_term = self.beta_coupling * u  # φ³ × u
        
        d2D_dt2 = wave_term + damping_term + restoring_term + coupling_term
        
        return {
            'D': D,
            'dD_dt': dD_dt,
            'u': u,
            'wave_term': wave_term,
            'damping_term': damping_term,
            'restoring_term': restoring_term,
            'coupling_term': coupling_term,
            'd2D_dt2': d2D_dt2,
            'formula': '∂ₜₜD = c_D² × ∇²D - λ × ∂ₜD - α × D + β × u'
        }
    
    def coupled_step(self, u: Fraction, D: Fraction, dD_dt: Fraction,
                     laplacian_u: Fraction, laplacian_D: Fraction,
                     dt: Fraction) -> Dict[str, Fraction]:
        """Execute one coupled time step."""
        primary = self.primary_field_update(u, laplacian_u)
        u_next = u + dt * primary['du_dt']
        
        eta = self.beta_coupling
        gamma = self.alpha_restore
        
        d_source = -eta * (u_next - u) / dt if dt != 0 else Fraction(0)
        d_decay = -gamma * (D - self.D0)
        D_diffusion = self.D_u * laplacian_D
        D_next = D + dt * (D_diffusion + d_decay + d_source)
        
        return {
            'u': u,
            'u_next': u_next,
            'D': D,
            'D_next': D_next,
            'dt': dt,
            'd_source': d_source,
            'd_decay': d_decay,
            'formula': 'Coupled φ³ rarefaction step'
        }
    # ```
    
