class FundamentalConstants:
    @staticmethod
    def fibonacci(n: int) -> int:
        """Compute F(n) exactly using matrix exponentiation. O(log n)."""
        if n < 0:
            raise ValueError("Negative Fibonacci index")
        if n <= 1:
            return n

        def mat_mult(A, B):
            return [
                [A[0][0]*B[0][0] + A[0][1]*B[1][0], A[0][0]*B[0][1] + A[0][1]*B[1][1]],
                [A[1][0]*B[0][0] + A[1][1]*B[1][0], A[1][0]*B[0][1] + A[1][1]*B[1][1]]
            ]

        def mat_pow(M, p):
            if p == 1:
                return M
            if p % 2 == 0:
                half = mat_pow(M, p // 2)
                return mat_mult(half, half)
            return mat_mult(M, mat_pow(M, p - 1))

        return mat_pow([[1, 1], [1, 0]], n)[0][1]

    # Golden ratio convergent: F(51)/F(50)
    PHI: Fraction = Fraction(12586269025, 7778742049)

    # Algebraic identities (exact)
    PHI_SQUARED: Fraction = PHI + Fraction(1)      # φ² = φ + 1
    PHI_CUBED: Fraction = 2 * PHI + Fraction(1)    # φ³ = 2φ + 1
    PHI_FOURTH: Fraction = 3 * PHI + Fraction(2)   # φ⁴ = 3φ + 2
    PHI_FIFTH: Fraction = 5 * PHI + Fraction(3)    # φ⁵ = 5φ + 3

    # Inverse golden ratio
    PHI_INVERSE: Fraction = PHI - Fraction(1)      # 1/φ = φ - 1

    # ─────────────────────────────────────────────────────────────────────────────
    # SPEED OF LIGHT AND DERIVED CONSTANTS
    # ─────────────────────────────────────────────────────────────────────────────

    # c = 299,792,458 m/s (exact by SI definition)
    C: int = 299792458

    # c² = 89,875,517,873,681,764 (exact integer)
    C_SQUARED: int = 89875517873681764

    # d = 207,542 (auxiliary constant from ULTRATHINK)
    D: int = 207542

    # d² = 43,073,681,764 (exact)
    D_SQUARED: int = 43073681764

    # ─────────────────────────────────────────────────────────────────────────────
    # RATIONAL π APPROXIMATIONS
    # ─────────────────────────────────────────────────────────────────────────────

    # Milü: 355/113 (error < 3×10⁻⁷)
    PI_MILU: Fraction = Fraction(355, 113)

    # More accurate: 103993/33102 (error < 5.8×10⁻¹⁰)
    PI_ACCURATE: Fraction = Fraction(103993, 33102)

    # Very high accuracy: 833719/265381 (error < 8.7×10⁻¹²)
    PI_HIGH: Fraction = Fraction(833719, 265381)

    # Default π for computations
    PI: Fraction = PI_MILU

    # ─────────────────────────────────────────────────────────────────────────────
    # PHYSICAL CONSTANTS (exact rationals where possible)
    # ─────────────────────────────────────────────────────────────────────────────

    # Planck constant: h = 6.62607015×10⁻³⁴ J·s (exact by SI)
    # Represented as 662607015 / 10^42
    PLANCK_H_NUMERATOR: int = 662607015
    PLANCK_H_EXPONENT: int = 42

    # Reduced Planck: ℏ = h / 2π
    @classmethod
    def hbar(cls) -> Fraction:
        """Compute ℏ = h / 2π exactly."""
        h = Fraction(cls.PLANCK_H_NUMERATOR, 10**cls.PLANCK_H_EXPONENT)
        return h / (2 * cls.PI)

    # Fine structure constant inverse: α⁻¹ ≈ 137.035999084
    # Rational approximation
    ALPHA_INVERSE: Fraction = Fraction(137035999084, 1000000000)

    # ─────────────────────────────────────────────────────────────────────────────
    # WHEELER COUPLING CONSTANTS
    # ─────────────────────────────────────────────────────────────────────────────

    @classmethod
    def wheeler_coupling(cls) -> Fraction:
        """κ = 8π × φ³ (Wheeler's dielectric-curvature coupling)."""
        return 8 * cls.PI * cls.PHI_CUBED

    @classmethod
    def gravitational_coupling(cls) -> Fraction:
        """8πG/c⁴ in natural units."""
        return 8 * cls.PI / Fraction(cls.C_SQUARED * cls.C_SQUARED)

