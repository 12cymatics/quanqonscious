    def coupling_constant() -> Fraction:
        """κ = 8π × φ³"""
        return 8 * FundamentalConstants.PI * PHI_CUBED

    @staticmethod
    def field_equation(G_munu: Fraction, Q_munu: Fraction,
                       T_dielectric: Fraction) -> Dict[str, Any]:
        """
        Evaluate G + Q = 8πφ³ T
        """
        kappa = WheelerCurvatureCoupling.coupling_constant()
        lhs = G_munu + Q_munu
        rhs = kappa * T_dielectric
        residual = lhs - rhs

        return {
            'G_munu': G_munu,
            'Q_munu': Q_munu,
            'T_dielectric': T_dielectric,
            'coupling_constant': kappa,
            'LHS': lhs,
            'RHS': rhs,
            'residual': residual,
            'satisfied': residual == 0,
            'formula': 'G_μν + Q_μν = 8π × φ³ × T_μν^(dielectric)'
        }

    @staticmethod
    def solve_for_dielectric(G_munu: Fraction, Q_munu: Fraction) -> Fraction:
        """T^(dielectric) = (G + Q) / (8πφ³)"""
        kappa = WheelerCurvatureCoupling.coupling_constant()
        return (G_munu + Q_munu) / kappa

    @staticmethod
    def solve_for_curvature(T_dielectric: Fraction, Q_munu: Fraction) -> Fraction:
        """G_μν = 8πφ³ T^(dielectric) - Q_μν"""
        kappa = WheelerCurvatureCoupling.coupling_constant()
        return kappa * T_dielectric - Q_munu
