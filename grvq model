@staticmethod
def sutra_15_gunitasamuccaya(list_a: List[Fraction], 
                              list_b: List[Fraction]) -> Dict[str, Any]:
    """
    Guṇitasamuccayaḥ: "Product of sums is sum of products."
    
    (Σ a_i) × (Σ b_j) relates to Σ Σ a_i × b_j
    
    This is the distributive property.
    """
    sum_a = sum(list_a)
    sum_b = sum(list_b)
    product_of_sums = sum_a * sum_b
    
    # All pairwise products
    all_products = [a * b for a in list_a for b in list_b]
    sum_of_products = sum(all_products)
    
    return {
        'sutra_index': 15,
        'sutra_name': 'Guṇitasamuccayaḥ',
        'list_a': list_a,
        'list_b': list_b,
        'sum_a': sum_a,
        'sum_b': sum_b,
        'product_of_sums': product_of_sums,
        'sum_of_products': sum_of_products,
        'formula': '(Σa)(Σb) = ΣΣ(a×b)',
        'verified': product_of_sums == sum_of_products
    }

