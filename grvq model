# SUTRA 11: Vyaṣṭisamaṣṭiḥ - Part and Whole
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_11_vyashti_samashti(parts: List[Fraction], 
                               constant: Fraction) -> Dict[str, Any]:
    """
    Vyaṣṭisamaṣṭiḥ: "Part and whole."
    
    Factor out common operations for efficiency.
    
    Instead of: Σ (part_i × constant)
    Compute:    constant × Σ part_i
    
    Example: Σ m_i × c² = c² × (Σ m_i)
    """
    sum_of_parts = sum(parts)
    
    # Inefficient: sum of products
    sum_of_products = sum(p * constant for p in parts)
    
    # Efficient: product of sum
    product_of_sum = constant * sum_of_parts
    
    return {
        'sutra_index': 11,
        'sutra_name': 'Vyaṣṭisamaṣṭiḥ',
        'parts': parts,
        'constant': constant,
        'sum_of_parts': sum_of_parts,
        'sum_of_products': sum_of_products,
        'product_of_sum': product_of_sum,
        'formula': 'Σ(p_i × c) = c × Σ(p_i)',
        'efficiency_gain': f'{len(parts)} multiplications → 1 multiplication',
        'verified': sum_of_products == product_of_sum
    }

