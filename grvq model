# SUTRA 2: Nikhilam Navataścaramam Daśataḥ - All From 9, Last From 10
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_02_nikhilam(x: int, base: int = 10) -> Dict[str, Any]:
    """
    Nikhilam: "All from 9 and the last from 10."
    
    Computes the complement of x with respect to base.
    Used for multiplication of numbers near powers of 10.
    
    Algorithm:
        1. All digits except last: subtract from 9
        2. Last digit: subtract from 10
    
    Example: 
        nikhilam(97, 100) = 3
        Because: 100 - 97 = 3
    """
    complement = base - x
    
    return {
        'sutra_index': 2,
        'sutra_name': 'Nikhilam Navataścaramam Daśataḥ',
        'input': x,
        'base': base,
        'complement': complement,
        'formula': 'base - x',
        'application': 'Multiplication near powers of 10'
    }

@staticmethod
def sutra_02_nikhilam_multiply(a: int, b: int, base: int) -> Dict[str, Any]:
    """
    Nikhilam multiplication for numbers near a base.
    
    EXACT FORMULA:
        a × b = (a - b') × base + a' × b'
        where a' = base - a, b' = base - b
    
    Example: 98 × 97 with base 100
        a' = 100 - 98 = 2
        b' = 100 - 97 = 3
        Result = (98 - 3) × 100 + 2 × 3
               = 95 × 100 + 6
               = 9506
    """
    deficiency_a = base - a
    deficiency_b = base - b
    
    # Cross subtraction
    cross_result = a - deficiency_b  # or equivalently: b - deficiency_a
    
    # Product of deficiencies
    deficiency_product = deficiency_a * deficiency_b
    
    # Final result
    result = cross_result * base + deficiency_product
    
    return {
        'sutra_index': 2,
        'sutra_name': 'Nikhilam Multiplication',
        'a': a,
        'b': b,
        'base': base,
        'deficiency_a': deficiency_a,
        'deficiency_b': deficiency_b,
        'cross_result': cross_result,
        'deficiency_product': deficiency_product,
        'result': result,
        'formula': '(a - b\') × base + a\' × b\'',
        'verification': a * b == result
    }

