# SUTRA 10: Yāvadūnam - By The Deficiency
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_10_yavadunam(n: int, base: int) -> Dict[str, Any]:
    """
    Yāvadūnam: "By the deficiency."
    
    Squaring numbers near a base.
    
    EXACT FORMULA:
        n² = (n + deficiency) × base + deficiency²
        where deficiency = n - base
    
    Example: 299792458² with base = 300000000
        deficiency = 299792458 - 300000000 = -207542
        n² = (299792458 - 207542) × 300000000 + (-207542)²
           = 299584916 × 300000000 + 43073681764
           = 89875474800000000 + 43073681764
           = 89875517873681764 ✓ (= c²)
    """
    deficiency = n - base
    
    # Method 1: Standard formula
    term1 = (n + deficiency) * base
    term2 = deficiency * deficiency
    result = term1 + term2
    
    return {
        'sutra_index': 10,
        'sutra_name': 'Yāvadūnam',
        'n': n,
        'base': base,
        'deficiency': deficiency,
        'term1_cross': term1,
        'term2_deficiency_squared': term2,
        'result': result,
        'formula': 'n² = (n + d) × base + d²',
        'verification': n * n == result
    }

