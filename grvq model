@staticmethod
def sutra_16_gunakasamuccaya(factors_list: List[Tuple[Fraction, Fraction]]) -> Dict[str, Any]:
    """
    Guṇakasamuccayaḥ: "Sum of products is product of sums."
    
    For checking: Σ(a_i × b_i) = (Σa_i) × (Σb_i) under specific conditions.
    Generally used for verification of polynomial products.
    """
    products = [a * b for a, b in factors_list]
    sum_of_products = sum(products)
    
    sum_of_first = sum(a for a, b in factors_list)
    sum_of_second = sum(b for a, b in factors_list)
    
    return {
        'sutra_index': 16,
        'sutra_name': 'Guṇakasamuccayaḥ',
        'factors': factors_list,
        'products': products,
        'sum_of_products': sum_of_products,
        'sum_of_first_factors': sum_of_first,
        'sum_of_second_factors': sum_of_second,
        'formula': 'Verification via coefficient sums',
        'application': 'Polynomial factorization verification'
    }

