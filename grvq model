# SUTRA 3: Ūrdhva-Tiryagbhyām - Vertically and Crosswise
# ═══════════════════════════════════════════════════════════════════════════

@staticmethod
def sutra_03_urdhva_tiryagbhyam(a_digits: List[int], b_digits: List[int]) -> Dict[str, Any]:
    """
    Ūrdhva-Tiryagbhyām: "Vertically and crosswise."
    
    General multiplication algorithm using cross products.
    
    For n-digit × n-digit multiplication:
        c_k = Σ(i+j=k) a_i × b_j
    
    Visual pattern (3×3):
        a₂ a₁ a₀
      × b₂ b₁ b₀
      ───────────
      Vertical:   a₀b₀
      Cross 1:    a₀b₁ + a₁b₀
      Cross 2:    a₀b₂ + a₁b₁ + a₂b₀
      Cross 3:    a₁b₂ + a₂b₁
      Vertical:   a₂b₂
    """
    n_a = len(a_digits)
    n_b = len(b_digits)
    n_result = n_a + n_b - 1
    
    # Compute each coefficient c_k
    coefficients = []
    for k in range(n_result):
        c_k = Fraction(0)
        for i in range(max(0, k - n_b + 1), min(k + 1, n_a)):
            j = k - i
            if 0 <= j < n_b:
                c_k += Fraction(a_digits[i]) * Fraction(b_digits[j])
        coefficients.append(c_k)
    
    return {
        'sutra_index': 3,
        'sutra_name': 'Ūrdhva-Tiryagbhyām',
        'a_digits': a_digits,
        'b_digits': b_digits,
        'coefficients': coefficients,
        'formula': 'c_k = Σ(i+j=k) a_i × b_j',
        'complexity': f'O({n_a * n_b})'
    }

