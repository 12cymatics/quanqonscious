// ═══════════════════════════════════════════════════════════════════════════════
// §13 TESSERACT — Hypercubic Kronecker Fabric on Torus
//
// 16 vertices of 4-cube: (±1,±1,±1,±1)
// Natural torus embedding: (x,w)→θ major circle, (y,z)→φ minor circle
// 4D rotation in XW, YZ planes driven by vortex ω
// Edges drawn as geodesic curves ON the torus surface
// Color: blue→magenta gradient by vertex index (Ω(n) labeling)
// ═══════════════════════════════════════════════════════════════════════════════
const TESS_V = [];
for (let i = 0; i < 16; i++) TESS_V.push({
  x: (i & 1) ? 1 : -1, y: (i & 2) ? 1 : -1,
  z: (i & 4) ? 1 : -1, w: (i & 8) ? 1 : -1
});
const TESS_E = [];
for (let i = 0; i < 16; i++) for (let j = i + 1; j < 16; j++) {
  const d = i ^ j; if (d && (d & (d - 1)) === 0) TESS_E.push([i, j]);
}

// 4D rotation state — driven by vortex
const TESS_ROT = { xw: 0, yz: 0, xy: 0 };

// Map a point on torus (θ,φ) to screen coordinates via camera
// Perspective camera distance — controls zoom level
const CAM_DIST = 1200; // perspective distance
let ZOOM = 0.35;        // screen scale — user adjustable (lower = further)

function torusToScreen(theta, phi, cx, cy) {
  let R = TORUS_R, r = TORUS_r;
  let x3 = (R + r * cos(phi)) * cos(theta);
  let y3 = r * sin(phi);
  let z3 = (R + r * cos(phi)) * sin(theta);
  // Camera rotation
  let t1;
  t1 = x3 * cos(camRY) - z3 * sin(camRY); z3 = x3 * sin(camRY) + z3 * cos(camRY); x3 = t1;
  t1 = y3 * cos(camRX) - z3 * sin(camRX); z3 = y3 * sin(camRX) + z3 * cos(camRX); y3 = t1;
  // Perspective divide
  const pScale = CAM_DIST / (CAM_DIST + z3) * ZOOM;
  return { sx: cx + x3 * pScale, sy: cy + y3 * pScale, depth: z3 };
}

// Shortest angular interpolation (handles 2π wraparound)
function lerpAngle(a, b, t) {
  let diff = b - a;
  // Wrap to [-π, π]
  while (diff > PI) diff -= TAU;
  while (diff < -PI) diff += TAU;
  return a + diff * t;
}

// Rotate 4D vertex and map to torus (θ, φ)
function tessVertexToTorus(v, t) {
  let {x, y, z, w} = v;

  // 4D rotation: XW plane (vortex-coupled) — the hypercube morph
  const cxw = cos(TESS_ROT.xw), sxw = sin(TESS_ROT.xw);
  let nx = x * cxw - w * sxw, nw = x * sxw + w * cxw;
  x = nx; w = nw;

  // 4D rotation: YZ plane (counter-rotating)
  const cyz = cos(TESS_ROT.yz), syz = sin(TESS_ROT.yz);
  let ny = y * cyz - z * syz, nz = y * syz + z * cyz;
  y = ny; z = nz;

  // 4D rotation: XY plane (gentle roll)
  const cxy = cos(TESS_ROT.xy), sxy = sin(TESS_ROT.xy);
  let nx2 = x * cxy - y * sxy, ny2 = x * sxy + y * cxy;
  x = nx2; y = ny2;

  // Direct angle mapping: (x,w)→θ major circle, (y,z)→φ minor circle
  // atan2 gives 4 distinct angles that morph smoothly under rotation
  const theta = (Math.atan2(w, x) + PI) % TAU;
  const phi = (Math.atan2(z, y) + PI) % TAU;

  // Stereographic w-scale for 4D depth effect
  const wScale = 2.5 / (2.5 - w * 0.6);

  return { theta, phi, w, wScale };
}

function renderTesseract(t) {
  const cw = W / devicePixelRatio, ch = H / devicePixelRatio;
  const cx = cw / 2, cy = ch / 2;

  // Update 4D rotation from vortex
  const voAbs = abs(vortexOmega);
  const vSign = vortexOmega > 0 ? 1 : -1;
  TESS_ROT.xw += (0.00024 + voAbs * 0.0003) * vSign;
  TESS_ROT.yz += 0.00014 - voAbs * 0.0001;
  TESS_ROT.xy += 0.00008 * sin(t * 0.000003);

  // ── Compute vertex field metrics ──────────────────────────────────
  const vpsi = VTX.psi.map(p => Q.fl(p));
  let psiMax = 0.001;
  for (let i = 0; i < 16; i++) psiMax = max(psiMax, abs(vpsi[i]));

  // Project all 16 vertices to torus coordinates
  const verts = TESS_V.map((v, i) => {
    const tp = tessVertexToTorus(v, t);
    const scr = torusToScreen(tp.theta, tp.phi, cx, cy);
    return { ...tp, ...scr, idx: i, psi: vpsi[i], psiNorm: vpsi[i] / psiMax };
  });

  // ── EDGES: brightness ∝ |∇Ψ| = |Ψⱼ-Ψᵢ| ─────────────────────────
  const EDGE_STEPS = 8;
  let maxGrad = 0.001;
  for (const [a, b] of TESS_E) maxGrad = max(maxGrad, abs(vpsi[a] - vpsi[b]));

  for (const [a, b] of TESS_E) {
    const va = verts[a], vb = verts[b];
    const avgDepth = (va.depth + vb.depth) * 0.5;
    const avgScale = (va.wScale + vb.wScale) * 0.5;

    // Edge gradient: how much field changes along this edge
    const grad = abs(vpsi[a] - vpsi[b]) / maxGrad; // [0,1]
    const avgPsi = (va.psiNorm + vb.psiNorm) * 0.5;

    // Wheeler ether contribution along this edge
    const edgeTheta = (va.theta + vb.theta) * 0.5 || 0;
    const edgePhi = (va.phi + vb.phi) * 0.5 || 0;
    const eCentBal = WHEELER.centripetal * cos(edgeTheta * C.phi_f)
                   - WHEELER.centrifugal * sin(edgePhi * C.phi_f);
    const eEther = eCentBal / (1 + abs(eCentBal)); // [-1,1]

    // Color by FIELD + ETHER:
    //   High gradient → white-gold/white-violet (ether-heated energy flow)
    //   Low gradient  → dim amber/cyan (ether equilibrium)
    //   Centripetal → warm, Centrifugal → cool
    let r, g, bv;
    if (grad > 0.5) {
      // High gradient: intense energy flow — ether-tinted white
      const intensity = grad;
      if (eCentBal > 0) {
        // Centripetal: golden-white energy flow
        r = floor(185 + intensity * 70 + eEther * 20);
        g = floor(145 + intensity * 75 + eEther * 15);
        bv = floor(50 + (1 - intensity) * 100);
      } else {
        // Centrifugal: cyan-white energy flow
        r = floor(140 + intensity * 60);
        g = floor(155 + intensity * 70);
        bv = floor(100 + intensity * 90 + abs(eEther) * 30);
      }
    } else if (avgPsi > 0) {
      // Positive field: amber with ether warmth
      r = floor(125 + grad * 95 + max(0, eEther) * 20);
      g = floor(75 + grad * 55 + max(0, eEther) * 15);
      bv = floor(25 + grad * 35 + abs(eEther) * 15);
    } else {
      // Negative field: cyan-blue with counterspace cool
      r = floor(25 + grad * 35 + max(0, eEther) * 15);
      g = floor(75 + grad * 80 + abs(eEther) * 10);
      bv = floor(155 + grad * 80 + max(0, -eEther) * 25);
    }

    const depthFade = clamp(0.3 + (avgDepth + 300) / 600 * 0.7, 0.1, 1);
    const alpha = (0.15 + grad * 0.6) * depthFade * avgScale;

    // Glow pass (wider, gradient-proportional)
    ctx.strokeStyle = `rgba(${r},${g},${bv},${sf(alpha * 0.4, 2)})`;
    ctx.lineWidth = (1.5 + grad * 3.5) * avgScale;
    ctx.beginPath();
    for (let s = 0; s <= EDGE_STEPS; s++) {
      const frac = s / EDGE_STEPS;
      const th = lerpAngle(va.theta, vb.theta, frac);
      const ph = lerpAngle(va.phi, vb.phi, frac);
      const pt = torusToScreen(th, ph, cx, cy);
      if (s === 0) ctx.moveTo(pt.sx, pt.sy); else ctx.lineTo(pt.sx, pt.sy);
    }
    ctx.stroke();

    // Core pass
    ctx.strokeStyle = `rgba(${min(255,r+40)},${min(255,g+30)},${min(255,bv+20)},${sf(alpha, 2)})`;
    ctx.lineWidth = (0.5 + grad * 1.5) * avgScale;
    ctx.beginPath();
    for (let s = 0; s <= EDGE_STEPS; s++) {
      const frac = s / EDGE_STEPS;
      const th = lerpAngle(va.theta, vb.theta, frac);
      const ph = lerpAngle(va.phi, vb.phi, frac);
      const pt = torusToScreen(th, ph, cx, cy);
      if (s === 0) ctx.moveTo(pt.sx, pt.sy); else ctx.lineTo(pt.sx, pt.sy);
    }
    ctx.stroke();
  }

  // ── VERTICES: size ∝ |Ψᵢ|, color by sign ────────────────────────
  // Sort by depth for proper overlap (back to front)
  const sorted = [...verts].sort((a, b) => a.depth - b.depth);

  for (const v of sorted) {
    const depthFade = clamp(0.3 + (v.depth + 300) / 600 * 0.7, 0.1, 1);
    const psiAbs = abs(v.psiNorm);

    // Size: minimum 2px, up to 8px for max |Ψ|
    const dotR = (2.0 + psiAbs * 6.0) * v.wScale;

    // Color by sign and magnitude:
    //   Positive → gold/amber (centripetal, warm ether)
    //   Negative → cyan/indigo (centrifugal, counterspace)
    //   Near zero → dim violet (singularity suppressed, ether void)
    let vr, vg, vbv, coreAlpha;

    // Wheeler ether contribution at this vertex position
    const vEtherP = WHEELER.etherPressure(v.theta || 0, v.phi || 0, simTime);
    const vEtherNorm = vEtherP / (1 + abs(vEtherP));
    const vCentBal = WHEELER.centripetal * cos((v.theta || 0) * C.phi_f)
                   - WHEELER.centrifugal * sin((v.phi || 0) * C.phi_f);

    if (psiAbs < 0.05) {
      // Near-zero: suppressed vertex — dim violet ether void
      vr = 60 + abs(vEtherNorm) * 20;
      vg = 50 + abs(vEtherNorm) * 15;
      vbv = 80 + abs(vEtherNorm) * 25;
      coreAlpha = 0.25 + abs(vEtherNorm) * 0.1;
    } else if (v.psi > 0) {
      // Positive field: gold → amber → incandescent white
      // Centripetal ether warms the glow toward deeper gold
      const ethWarm = max(0, vCentBal) * 0.15;
      vr = floor(175 + psiAbs * 80 + ethWarm * 40);
      vg = floor(120 + psiAbs * 110 + ethWarm * 30);
      vbv = floor(30 + psiAbs * 35 + abs(vEtherNorm) * 25);
      coreAlpha = 0.5 + psiAbs * 0.5;
    } else {
      // Negative field: teal → cyan → indigo → deep violet
      // Centrifugal ether pushes toward ultraviolet
      const ethCool = max(0, -vCentBal) * 0.15;
      vr = floor(35 + psiAbs * 55 + ethCool * 20);
      vg = floor(130 + psiAbs * 95 + ethCool * 10);
      vbv = floor(190 + psiAbs * 65 + abs(vEtherNorm) * 30);
      coreAlpha = 0.5 + psiAbs * 0.5;
    }

    // ── 4-LAYER VERTEX GLOW with Ether halo ──

    // Layer 0: Far ether halo — very faint, colored by centripetal/centrifugal balance
    const haloR = vCentBal > 0 ? min(255, vr + 40) : min(255, vr + 15);
    const haloG = vCentBal > 0 ? min(255, vg + 20) : min(255, vg + 10);
    const haloB = vCentBal > 0 ? min(255, vbv + 10) : min(255, vbv + 50);
    ctx.fillStyle = `rgba(${haloR},${haloG},${haloB},${sf(0.06 * depthFade * coreAlpha, 2)})`;
    ctx.beginPath();
    ctx.arc(v.sx, v.sy, dotR * 4.5, 0, TAU);
    ctx.fill();

    // Layer 1: Outer glow
    ctx.fillStyle = `rgba(${vr},${vg},${vbv},${sf(0.14 * depthFade * coreAlpha, 2)})`;
    ctx.beginPath();
    ctx.arc(v.sx, v.sy, dotR * 3.0, 0, TAU);
    ctx.fill();

    // Layer 2: Mid glow
    ctx.fillStyle = `rgba(${vr},${vg},${vbv},${sf(0.30 * depthFade * coreAlpha, 2)})`;
    ctx.beginPath();
    ctx.arc(v.sx, v.sy, dotR * 1.8, 0, TAU);
    ctx.fill();

    // Layer 3: Core — slightly brighter than base
    ctx.fillStyle = `rgba(${min(255,vr+35)},${min(255,vg+25)},${min(255,vbv+15)},${sf(coreAlpha * depthFade, 2)})`;
    ctx.beginPath();
    ctx.arc(v.sx, v.sy, dotR, 0, TAU);
    ctx.fill();

    // Layer 4: White-hot center for high |Ψ| — ether incandescence
    if (psiAbs > 0.3) {
      const incand = (psiAbs - 0.3) * 1.4;
      // Incandescent color shifts with ether: golden-white for centripetal, blue-white for centrifugal
      const incR = vCentBal > 0 ? 255 : floor(220 + incand * 35);
      const incG = vCentBal > 0 ? floor(250 + incand * 5) : floor(240 + incand * 15);
      const incB = vCentBal > 0 ? floor(220 + incand * 20) : 255;
      ctx.fillStyle = `rgba(${incR},${incG},${incB},${sf(incand * depthFade, 2)})`;
      ctx.beginPath();
      ctx.arc(v.sx, v.sy, dotR * 0.4, 0, TAU);
      ctx.fill();
    }
  }
}
// ═══════════════════════════════════════════════════════════════════════════════
// §14 TORUS RENDERING — with per-sutra geo distortion + TGCR + Wheeler + GRVQ
// ═══════════════════════════════════════════════════════════════════════════════
const TORUS_R = 180, TORUS_r = 70;
const TH_SEG = 160, PH_SEG = 80;
const torusPoints = new Array(TH_SEG * PH_SEG);
for (let i = 0; i < torusPoints.length; i++) torusPoints[i] = { sx:0, sy:0, depth:0, field:0, theta:0, phi:0 };

let camRX = 0.55, camRY = 0, isDrag = false, lastMX = 0, lastMY = 0;
let autoRotate = true;
let showOverlay = true;

function projectTorus(t) {
  GEO_LOG.resetFrame();
  const cw = W / devicePixelRatio, ch = H / devicePixelRatio;
  const cx = cw / 2, cy = ch / 2;
  const r4f = clamp(abs(Q.fl(R4val)), 0, 1);
  const time = t * 0.001;

  // Pre-compute per-frame constants (hoisted from inner loop)
  const cRY = cos(camRY), sRY = sin(camRY);
  const cRX = cos(camRX), sRX = sin(camRX);

  // Pre-compute vortex constants
  const vo = vortexOmega, absVo = abs(vo);
  const vortexActive = absVo > 0.005;
  const vGeo = min(absVo, 2.0) * AMP.vortex;
  const vSign = vo > 0 ? 1 : -1;
  const bLam01 = 1 + TGCR.beltramiLambda * 0.1;
  const timeVo3 = time * vo * 3;
  const timeVo2 = time * vo * 2;
  const timeVo4 = time * vo * 4;
  const timeAbsVo3 = time * absVo * 3;

  for (let i = 0; i < TH_SEG; i++) {
    const theta = (i / TH_SEG) * TAU;
    const cosTheta = cos(theta), sinTheta = sin(theta);

    // Pre-compute theta-dependent vortex values (constant across phi)
    const funnelFactor = 0.5 + 0.5 * cosTheta;
    const antiFunnel = 1 - funnelFactor;

    for (let j = 0; j < PH_SEG; j++) {
      const phi = (j / PH_SEG) * TAU;
      const fv = sampleField(theta, phi);

      let R = TORUS_R, r = TORUS_r, yOff = 0, phiShift = 0;

      // ── PRIMARY DEFORMATION: Vertex field Ψ[16] ──────────────────
      // No clamps. No dampening. The field IS the geometry.
      const fvNorm = fv; // RAW field value — no saturation
      R += fvNorm * AMP.field * (1 + r4f);
      r += fvNorm * AMP.tube;
      yOff += fvNorm * AMP.yDisp;

      // Field gradient: unclamped
      const fvNext = sampleField(theta + 0.05, phi);
      const fvUp = sampleField(theta, phi + 0.05);
      const gradTh = (fvNext - fv) * 5;
      const gradPh = (fvUp - fv) * 5;
      phiShift += gradTh * AMP.gradTwist;
      r += abs(gradPh) * AMP.gradRipple;
      R += abs(gradTh) * AMP.gradBulge;

      // TGCR vortex geometry — tornado funnel with Beltrami eigenflow
      if (vortexActive) {
        // Beltrami eigenflow twist
        phiShift += vSign * vGeo * 1.5 * funnelFactor * sin(theta * 3 + timeVo3) * bLam01;
        phiShift -= vSign * vGeo * 0.5 * antiFunnel * sin(theta * 5 - timeVo2);

        // Tube pinch for funnel + cymatic ripple
        r *= (1 - vGeo * 0.15 * funnelFactor);
        r += vGeo * 5 * sin(theta * 3 - phi * 2 * vortexHelicity + timeVo4);

        // Tornado lateral sweep
        R += vGeo * 10 * sin(theta * 2 - timeVo2) * funnelFactor;
        yOff += vSign * vGeo * 15 * cos(theta * 2 + phi * vortexHelicity - timeAbsVo3) * funnelFactor;

        // Cymatic standing wave nodes on surface
        const cymNode = sin(theta * 6 - phi * 3 * vortexHelicity + timeVo2);
        r += vGeo * 3 * cymNode * cymNode * antiFunnel;
      }

      // ═══ WHEELER ETHER GEOMETRY — φ³ hyperboloid + dielectric shaping ═══
      //
      // Ken Wheeler: the torus IS the ether — centripetal (√2 inward) and
      // centrifugal (√3 outward) forces shape the dielectric medium.
      // The inertia plane (φ=π/2) is the equator of maximum ether strain.

      // Base φ³ hyperboloid distortion
      const wheelerDist = WHEELER.fieldDistortion(theta, phi, 2.0, t) * AMP.wheeler;
      R += wheelerDist * 3;
      yOff += WHEELER.goldenVortex(theta, phi, absVo || 0.1) * 4;

      // Ether pressure sculpting: bulge where pressure is high, dimple where low
      const ethP = WHEELER.etherPressure(theta, phi, t);
      const ethPNorm = ethP / (1 + abs(ethP)); // [-1,1]
      r += ethPNorm * 7.0;  // tube radius breathes with ether pressure (was 3.5)
      R += ethPNorm * 3.0;  // ring radius shifts under pressure differential (was 1.5)

      // Counterspace contraction: α⁻¹ magnification creates dimples
      // where the dielectric field is strained (high |Ψ|)
      const csI = WHEELER.counterspaceIntensity(theta, phi, fvNorm, t);
      const csDimple = csI / (1 + abs(csI) * 2); // soft saturate
      r -= abs(csDimple) * 4.0;  // counterspace strains thin the tube (was 2.0)
      yOff += csDimple * 6.0;    // vertical displacement from counterspace pressure (was 3.0)

      // Dielectric inertia plane: the equator (φ≈π/2) has maximum
      // centripetal/centrifugal tension → creates a ridge/groove
      const inertiaAngle = abs(phi - WHEELER.inertiaPlane);
      const inertiaEnvelope = exp(-inertiaAngle * inertiaAngle * 3);
      // Centripetal/centrifugal balance at this (θ,φ)
      const centBal = WHEELER.centripetal * cos(theta * C.phi_f) - WHEELER.centrifugal * sin(phi * C.phi_f);
      // Positive centBal (centripetal dominates) → tube contracts (inward force)
      // Negative centBal (centrifugal dominates) → tube expands (outward force)
      r += centBal * inertiaEnvelope * 4.0;  // (was 2.0)
      // Inertia ridge: thickening at the inertia plane
      r += inertiaEnvelope * 3.0;  // (was 1.5)

      // φ-spiral texture ripple: corrugation from golden angle periodicity
      // This creates the visible "grain" of the ether on the surface
      const spiralRipple = sin((theta * C.phi_f + phi) * 8 + t * 0.0005) * 1.2;  // (was 0.6)
      const dielectricGrain = sin(theta * 13 + phi * 8 - t * 0.0003) * 0.6;  // (was 0.3)
      r += spiralRipple * (0.8 + abs(ethPNorm) * 0.8);  // (was 0.5+0.5)
      r += dielectricGrain * (0.5 + abs(centBal) * 0.6);  // (was 0.3+0.4)

      // Hyperboloid contour: cosh(θ) creates the Wheeler hyperboloid bulge
      // at the top/bottom of the torus (θ≈0, θ≈π)
      const hypBulge = WHEELER.hyperboloid(sin(phi), theta, 1.8) - 1;
      R += hypBulge * 1.6 * AMP.wheeler;  // (was 0.8)

      // Golden vortex shear: φ-spiral velocity field displaces the tube laterally
      const vortexShear = WHEELER.goldenVortex(theta, phi, 0.5);
      phiShift += vortexShear * 0.05;  // twist from ether vortex (was 0.02)

      // σ suppression → TUBE PINCH (Morris-Thorne throat geometry)
      // Low σ (near singularity) = tube narrows (r→0), ring R preserved
      // This is physically correct: wormhole throat radius → 0
      const r4Pinch = 1 - (1 - r4f) * 0.4; // r4f=1 (healthy) → no pinch; r4f→0 → 40% tube pinch
      r *= r4Pinch;
      
      // MAGFIELD: Magnetic pressure inflates tube where B is strong
      // P_mag = |B|²/(2μ) → tube radius increase ∝ B²
      const bPressure = MAGFIELD.pressure * AMP.bfield;
      r += bPressure * 8; // B² pressure inflates tube (diamagnetic effect)

      // Floor: prevent tube inversion (negative r) and self-intersection
      if (r < 1) r = 1;
      if (R < r + 1) R = r + 1;

      // Track geometry for unique geometry logger
      GEO_LOG.trackPoint(R, r, yOff, phiShift);

      // Compute torus point
      const effPhi = phi + phiShift;
      const cosP = cos(effPhi), sinP = sin(effPhi);
      let x = (R + r * cosP) * cosTheta;
      let y = r * sinP + yOff;
      let z = (R + r * cosP) * sinTheta;

      // Camera rotation (using pre-computed trig)
      let t1;
      t1 = x * cRY - z * sRY; z = x * sRY + z * cRY; x = t1;
      t1 = y * cRX - z * sRX; z = y * sRX + z * cRX; y = t1;

      const idx = i * PH_SEG + j;
      const pScale = CAM_DIST / (CAM_DIST + z) * ZOOM;
      torusPoints[idx].sx = cx + x * pScale;
      torusPoints[idx].sy = cy + y * pScale;
      torusPoints[idx].depth = z;
      torusPoints[idx].field = fvNorm;
      torusPoints[idx].theta = theta;
      torusPoints[idx].phi = phi;
    }
  }
}

function renderTorus() {
  // ═══ MOBILE PERFORMANCE GUARD ═══
  // Ether aura (gradient layers, caustics, spirals) is GPU-heavy.
  // On mobile (small viewport), render these every 3rd frame.
  // On desktop, every frame.
  const isMobile = cw < 600;
  const renderEther = !isMobile || (cycle % 3 === 0);

  // ═══ WHEELER ETHER AURA — MULTI-LAYER DIELECTRIC MEDIUM ═══
  //
  // Ken Wheeler: the ether is not empty — it is a pressurised dielectric
  // medium with centripetal/centrifugal tension. The aura layers show:
  //   Layer 1-3: Near-field counterspace glow (α⁻¹ magnified)
  //   Layer 4-5: Dielectric pressure nodes (φ³ resonance)
  //   Layer 6-7: Far-field ether boundary (centripetal/centrifugal edge)

  if (renderEther) {
  const etherLayers = isMobile ? 4 : 7;
  for (let layer = etherLayers; layer >= 1; layer--) {
    const layerR = 50 + layer * 30 + abs(vortexOmega || 0) * 12;
    const ethPhase = simTime * 0.0003 + layer * 0.618; // Golden ratio phase offset
    const centBal = WHEELER.centripetal * cos(ethPhase * (1 + layer * 0.1))
                  - WHEELER.centrifugal * sin(ethPhase * C.phi_f * (1 + layer * 0.05));
    const [eR, eG, eB] = WHEELER.etherColor(centBal, layer * 0.25);

    // Inner layers (1-3): brighter, tighter, counterspace-dominated
    // Outer layers (4-7): dimmer, wider, centripetal/centrifugal boundary
    const isInner = layer <= 3;
    const ethAlpha = isInner
      ? (0.18 + abs(centBal) * 0.12) / (layer * 0.6)
      : (0.08 + abs(centBal) * 0.06) / (layer * 0.4);

    // Golden vortex drift — each layer drifts differently (parallax)
    const driftX = sin(ethPhase * C.phi_f + layer * 1.2) * 8 * layer;
    const driftY = cos(ethPhase + layer * 0.8) * 6 * layer;

    const grd = ctx.createRadialGradient(
      cw/2 + driftX, ch/2 + driftY, layerR * 0.15,
      cw/2 + driftX, ch/2 + driftY, layerR
    );
    grd.addColorStop(0, `rgba(${floor(eR*255)},${floor(eG*255)},${floor(eB*255)},${ethAlpha.toFixed(3)})`);
    // Mid-ring: ether pressure node (brighter band)
    const nodeAlpha = isInner ? ethAlpha * 0.7 : ethAlpha * 0.4;
    grd.addColorStop(0.4, `rgba(${floor(eR*240)},${floor(eG*210)},${floor(eB*230)},${nodeAlpha.toFixed(3)})`);
    grd.addColorStop(0.7, `rgba(${floor(eR*180)},${floor(eG*140)},${floor(eB*200)},${(ethAlpha*0.35).toFixed(3)})`);
    grd.addColorStop(1, 'rgba(3,3,8,0)');
    ctx.fillStyle = grd;
    ctx.fillRect(0, 0, cw, ch);
  }

  // ── ETHER PRESSURE CAUSTICS: bright filaments where pressure constructively interferes ──
  ctx.globalAlpha = 0.18;
  ctx.lineWidth = 1.5;
  const causticTime = simTime * 0.0002;
  for (let c = 0; c < 8; c++) {
    const cPhase = c * TAU / 8 + causticTime;
    const cR = 60 + sin(cPhase * C.phi_f) * 25;
    // Ether caustic color: golden where centripetal, violet where centrifugal
    const cBal = cos(cPhase * 2);
    if (cBal > 0) {
      ctx.strokeStyle = `rgba(235,195,70,${(0.22 + cBal * 0.15).toFixed(2)})`;
    } else {
      ctx.strokeStyle = `rgba(160,90,220,${(0.18 + abs(cBal) * 0.12).toFixed(2)})`;
    }
    ctx.beginPath();
    for (let s = 0; s < 150; s++) {
      const a = s * 0.04 + cPhase;
      const cRadius = cR + s * 0.5 + sin(a * 3 + c) * 8;
      const px = cw/2 + cRadius * cos(a);
      const py = ch/2 + cRadius * sin(a) * 0.55;
      if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
  }

  // ── COUNTERSPACE FIELD LINES: φ-spiral dielectric flux ──
  // Five golden-ratio-spaced arms showing ether flow convergence
  ctx.strokeStyle = 'rgba(220,185,55,0.30)';
  ctx.lineWidth = 1.2;
  for (let arm = 0; arm < 5; arm++) {
    ctx.beginPath();
    const armOffset = arm * TAU / 5;
    for (let s = 0; s < 220; s++) {
      const angle = s * 0.045 + armOffset + simTime * 0.00008;
      const spiralR = 25 + s * 0.65;
      const wobble = sin(s * 0.15 + simTime * 0.0003) * 3;
      const px = cw/2 + (spiralR + wobble) * cos(angle * C.phi_f);
      const py = ch/2 + (spiralR + wobble) * sin(angle) * 0.58;
      if (s === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
  }

  // ── COUNTERSPACE VOID MARKERS: dark nodes where Ξ inverts ──
  // Wheeler: counterspace voids are where the dielectric medium
  // "turns inside out" — visible as dark spots in the ether
  ctx.globalAlpha = 0.14;
  for (let v = 0; v < 6; v++) {
    const vAngle = v * TAU / 6 + simTime * 0.00015 * (v % 2 === 0 ? 1 : -1);
    const vR = 70 + sin(vAngle * C.phi_f + v) * 20;
    const vx = cw/2 + vR * cos(vAngle);
    const vy = ch/2 + vR * sin(vAngle) * 0.55;
    const voidR = 10 + sin(simTime * 0.001 + v * 1.5) * 5;
    const voidGrd = ctx.createRadialGradient(vx, vy, 0, vx, vy, voidR);
    voidGrd.addColorStop(0, 'rgba(0,0,5,0.40)');
    voidGrd.addColorStop(0.4, 'rgba(20,5,40,0.20)');
    voidGrd.addColorStop(0.7, 'rgba(50,15,80,0.10)');
    voidGrd.addColorStop(1, 'rgba(3,3,8,0)');
    ctx.fillStyle = voidGrd;
    ctx.fillRect(vx - voidR, vy - voidR, voidR * 2, voidR * 2);
  }

  // ── ΥΓΙΘΑ PENTAGRAM OVERLAY ────────────────────────────────────────────
  // Pythagorean pentagram: 5 vertices at 72° intervals
  // "ΥΓΙΘΑ implies harmony, perfection, divine order, wholeness"
  // Faint golden pentagram rotating slowly in the ether field
  ctx.globalAlpha = 0.12;
  const pentaRot = simTime * 0.00003; // very slow rotation
  const pentaR = min(cw, ch) * 0.28;  // radius scales with viewport
  const pentaVerts = [];
  for (let v = 0; v < 5; v++) {
    const a = pentaRot + v * C.pentagram.angle - PI / 2; // start from top
    pentaVerts.push({
      x: cw/2 + pentaR * cos(a),
      y: ch/2 + pentaR * sin(a) * 0.58 // perspective compression
    });
  }
  // Draw pentagram star (connect every other vertex)
  ctx.strokeStyle = 'rgba(212,185,55,0.20)';
  ctx.lineWidth = 1.0;
  ctx.beginPath();
  for (let i = 0; i < 5; i++) {
    const from = pentaVerts[i];
    const to = pentaVerts[(i + 2) % 5];
    ctx.moveTo(from.x, from.y);
    ctx.lineTo(to.x, to.y);
  }
  ctx.stroke();
  // Vertex glyphs: Ι Θ Α Υ Γ at each vertex
  ctx.font = '10px serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  for (let v = 0; v < 5; v++) {
    const vInfo = C.pentagram.vertices[v];
    // Color by element: light=gold, logos=cyan, animus=green, water=blue, earth=brown
    const vColors = ['rgba(255,220,80,0.35)', 'rgba(80,220,255,0.35)', 'rgba(80,255,160,0.30)', 'rgba(80,160,255,0.30)', 'rgba(200,160,80,0.30)'];
    ctx.fillStyle = vColors[v];
    ctx.fillText(vInfo.letter, pentaVerts[v].x, pentaVerts[v].y);
  }

  // ── GOLDEN SPIRAL (Nautilus) ───────────────────────────────────────────
  // Wheeler page 9: logarithmic spiral expanding by φ per quarter-turn
  // Drawn as faint golden spiral in the ether field
  ctx.globalAlpha = 0.08;
  ctx.strokeStyle = 'rgba(220,190,55,0.25)';
  ctx.lineWidth = 0.8;
  ctx.beginPath();
  const spiralOffset = simTime * 0.00008;
  for (let s = 0; s < 400; s++) {
    const angle = s * 0.04 + spiralOffset;
    const pt = WHEELER.goldenSpiral(angle, cw/2, ch/2, 3);
    // Perspective compress Y
    const py = ch/2 + (pt.y - ch/2) * 0.58;
    if (s === 0) ctx.moveTo(pt.x, py); else ctx.lineTo(pt.x, py);
    if (pt.r > pentaR * 1.5) break; // stop when spiral exceeds pentagram
  }
  ctx.stroke();
  ctx.globalAlpha = 1.0;
  } // end if (renderEther)

  // ── TORUS SURFACE: Pre-build quad list with back-face culling ──
  const quads = [];
  for (let i = 0; i < TH_SEG; i++) {
    const ni = (i + 1) % TH_SEG;
    for (let j = 0; j < PH_SEG; j++) {
      const nj = (j + 1) % PH_SEG;
      const i00 = i * PH_SEG + j;
      const i10 = ni * PH_SEG + j;
      const i11 = ni * PH_SEG + nj;
      const i01 = i * PH_SEG + nj;
      const p0 = torusPoints[i00], p1 = torusPoints[i10];
      const p2 = torusPoints[i11], p3 = torusPoints[i01];

      // Face normal z-component via 2D cross product (screen-space winding)
      const e1x = p1.sx - p0.sx, e1y = p1.sy - p0.sy;
      const e2x = p3.sx - p0.sx, e2y = p3.sy - p0.sy;
      const nz = e1x * e2y - e1y * e2x;
      if (nz < 0) continue;

      const avgDepth = (p0.depth + p1.depth + p2.depth + p3.depth) * 0.25;
      const avgField = (p0.field + p1.field + p2.field + p3.field) * 0.25;
      const avgTheta = (p0.theta + p1.theta) * 0.5;
      const avgPhi = (p0.phi + p3.phi) * 0.5;

      // Full 3D normal for lighting
      const e1z = p1.depth - p0.depth, e2z = p3.depth - p0.depth;
      const nx = e1y * e2z - e1z * e2y;
      const ny = e1z * e2x - e1x * e2z;
      const nLen = sqrt(nx*nx + ny*ny + nz*nz) || 1;
      const nxN = nx/nLen, nyN = ny/nLen, nzN = nz/nLen;

      // Diffuse lighting (Lambertian)
      const diffuse = clamp((-0.35 * nxN - 0.55 * nyN + 0.75 * nzN), 0, 1);

      // Specular (Blinn-Phong) — half-vector with light direction
      const hx = -0.35 + 0, hy = -0.55 + 0, hz = 0.75 + 1;
      const hLen = sqrt(hx*hx + hy*hy + hz*hz) || 1;
      const specDot = clamp((nxN * hx + nyN * hy + nzN * hz) / hLen, 0, 1);
      const specular = Math.pow(specDot, 32) * 0.6;

      // Fresnel rim: grazing angles glow brighter (dielectric reflection)
      const viewDot = abs(nzN); // 1=facing camera, 0=edge-on
      const fresnel = Math.pow(1 - viewDot, 3) * 0.5;

      quads.push({
        p0, p1, p2, p3, depth: avgDepth, field: avgField,
        diffuse, specular, fresnel,
        theta: avgTheta, phi: avgPhi,
        nxN, nyN, nzN
      });
    }
  }
  quads.sort((a, b) => a.depth - b.depth);

  // ── DRAW QUADS with full Wheeler Ether texture, contours, dielectric coloring ──
  for (const q of quads) {
    const rawField = q.field;
    const fv = 2 * Math.atan(rawField * 2) / PI;
    const afv = abs(fv);

    // ── Wheeler Ether field state at this surface point ──
    const etherP = WHEELER.etherPressure(q.theta, q.phi, simTime);
    // counterspaceIntensity: expensive exp() + goldenVortex — skip on mobile
    const csIntensity = isMobile ? 0 : WHEELER.counterspaceIntensity(q.theta, q.phi, rawField, simTime);
    const centBal = WHEELER.centripetal * cos(q.theta * C.phi_f) - WHEELER.centrifugal * sin(q.phi * C.phi_f);
    const etherNorm = etherP / (1 + abs(etherP));
    const csNorm = isMobile ? 0 : csIntensity / (1 + abs(csIntensity));
    const inertiaAngle = abs(q.phi - WHEELER.inertiaPlane);
    const inertiaProx = exp(-inertiaAngle * inertiaAngle * 3); // 1 at inertia plane, 0 at poles

    // ── CONTOUR SYSTEM (5 layers — mobile renders layers 1,2 only) ──
    // Layer 1: Dielectric flux contours — φ-spiral iso-phase lines
    const fluxP = WHEELER.fluxPhase(q.theta, q.phi, simTime);
    const contourDist1 = abs(fluxP - 0.5);
    const contourFlux = contourDist1 < 0.04 ? (1 - contourDist1 / 0.04) * 0.45 : 0;

    // Layer 2: Field iso-surfaces — dark bands at Ψ = ±0.25, ±0.5, ±0.75
    const isoField = abs(fv * 8 % 1.0 - 0.5);
    const contourField = isoField < 0.05 ? (1 - isoField / 0.05) * 0.30 : 0;

    // Layer 3: Ether pressure isobars — where ∂P_ether/∂n = 0
    const contourEther = isMobile ? 0 : (abs(sin(etherNorm * PI * 4)) < 0.12 ? (1 - abs(sin(etherNorm * PI * 4)) / 0.12) * 0.25 : 0);

    // Layer 4: Counterspace boundary — transition zone where Ξ changes sign
    const contourCS = isMobile ? 0 : (abs(csNorm) < 0.08 ? (1 - abs(csNorm) / 0.08) * 0.35 : 0);

    // Layer 5: Inertia plane equator band — golden ring at φ ≈ π/2
    const contourInertia = inertiaProx > 0.75 ? (inertiaProx - 0.75) / 0.25 * 0.25 : 0;

    // ── DIELECTRIC GRAIN TEXTURE ──
    // Mobile: single-octave grain; Desktop: three-octave procedural texture
    let grainFactor, textureMod;
    if (isMobile) {
      grainFactor = sin(q.theta * 11 - q.phi * 17) * 0.5 + 0.5;
      textureMod = 0.90 + grainFactor * 0.10;
    } else {
      const grain1 = sin(q.theta * 37 + q.phi * 23 + simTime * 0.0002) * 0.5 + 0.5;
      const grain2 = sin(q.theta * 11 - q.phi * 17 + simTime * 0.0004) * 0.5 + 0.5;
      const grain3 = sin((q.theta * C.phi_f + q.phi) * 19) * 0.5 + 0.5;
      grainFactor = (grain1 * 0.3 + grain2 * 0.4 + grain3 * 0.3);
      textureMod = 0.85 + grainFactor * 0.15;
    }

    // ── ENHANCED COLOR MAPPING: Wheeler Ether temperature bands ──
    let r, g, b;
    if (fv > 0.005) {
      // Positive field: gold → amber → white → incandescent
      // Wheeler: centripetal-dominant regions glow with warm ether
      const warmEther = max(0, etherNorm) * 0.6;
      const centWarm = max(0, centBal) * 0.4;
      const inertiaGold = inertiaProx * 0.3;
      r = floor(155 + fv * 100 + warmEther * 70 + centWarm * 50 + inertiaGold * 50);
      g = floor(95 + fv * 140 + warmEther * 80 + centWarm * 40 + inertiaGold * 60);
      b = floor(8 + fv * 35 + abs(csNorm) * 80 + inertiaGold * 40);
      // High-field incandescence: approaches white-gold
      if (afv > 0.5) {
        const incand = (afv - 0.5) * 2.0;
        r = floor(min(255, r + incand * 70));
        g = floor(min(255, g + incand * 80));
        b = floor(min(255, b + incand * 50));
      }
    } else if (fv < -0.005) {
      // Negative field: teal → cyan → indigo → deep violet
      // Wheeler: centrifugal-dominant regions cool into counterspace violet
      const t = -fv;
      const coolEther = max(0, -etherNorm) * 0.5;
      const centCool = max(0, -centBal) * 0.45;
      r = floor(5 + t * 40 + coolEther * 40 + centCool * 55);
      g = floor(35 + t * 150 + coolEther * 35 + centCool * 20);
      b = floor(130 + t * 125 + abs(etherNorm) * 65 + centCool * 45);
      // Deep counterspace: approaches ultraviolet-indigo
      if (afv > 0.5) {
        const deep = (afv - 0.5) * 2.0;
        r = floor(min(255, r + deep * 50));
        g = floor(min(255, g + deep * 25));
        b = floor(min(255, b + deep * 60));
      }
    } else {
      // Nodal line: deep violet-purple with ether shimmer and dielectric grain
      const n = 1 - afv / 0.005;
      const shimmer = sin(q.theta * 12 + simTime * 0.002) * 0.25;
      const nodalEther = abs(etherNorm) * 0.35;
      r = floor(55 + n * 30 + shimmer * 30 + nodalEther * 25);
      g = floor(8 + n * 10 + shimmer * 15 + nodalEther * 12);
      b = floor(70 + n * 40 + abs(etherNorm) * 45 + nodalEther * 30);
    }

    // ── CENTRIPETAL / CENTRIFUGAL ETHER TEMPERATURE BANDS ──
    // Wheeler's key insight: √2 inward vs √3 outward creates zones
    // Golden warm band where centripetal dominates
    // Violet cool band where centrifugal dominates
    // White-gold equilibrium at the inertia plane boundary
    if (centBal > 0.08) {
      // Centripetal region — golden ether glow, warm dielectric
      const warmth = centBal * 1.2;
      r = floor(min(255, r + warmth * 55));
      g = floor(min(255, g + warmth * 35));
      b = floor(max(0, b - warmth * 20));
    } else if (centBal < -0.08) {
      // Centrifugal region — violet counterspace, cool dielectric
      const coolth = abs(centBal) * 1.2;
      r = floor(min(255, r + coolth * 25));
      g = floor(max(0, g - coolth * 10));
      b = floor(min(255, b + coolth * 55));
    }
    // Inertia plane equilibrium band: white-gold shimmer
    if (inertiaProx > 0.45) {
      const eqBand = (inertiaProx - 0.45) * 1.8;
      r = floor(min(255, r + eqBand * 55));
      g = floor(min(255, g + eqBand * 48));
      b = floor(min(255, b + eqBand * 28));
    }

    // ── Apply dielectric grain texture ──
    r = floor(r * textureMod);
    g = floor(g * textureMod);
    b = floor(b * textureMod);

    // ── SUBSURFACE SCATTERING from counterspace ──
    // Wheeler: the ether has internal luminosity — field energy
    // scatters beneath the surface, creating soft inner glow
    const sss = abs(csNorm) * 0.30 * (1 - q.diffuse); // (was 0.12) stronger on shadow side
    r = floor(min(255, r + sss * 120));
    g = floor(min(255, g + sss * 90));
    b = floor(min(255, b + sss * 150));

    // ── Surface lighting: ambient + diffuse + specular + Fresnel ──
    const ambient = 0.15;
    const light = ambient + 0.60 * q.diffuse + q.specular;
    r = floor(min(255, r * light));
    g = floor(min(255, g * light));
    b = floor(min(255, b * light));

    // Fresnel rim glow — dielectric edge luminosity (Wheeler boundary layer)
    // Centripetal edges glow golden, centrifugal edges glow violet
    const fresnelR = centBal > 0 ? 200 : 120;
    const fresnelG = centBal > 0 ? 160 : 60;
    const fresnelB = centBal > 0 ? 70 : 240;
    r = floor(min(255, r + q.fresnel * fresnelR));
    g = floor(min(255, g + q.fresnel * fresnelG));
    b = floor(min(255, b + q.fresnel * fresnelB));

    // ── Anisotropic specular: elongated along φ-spiral direction ──
    if (q.specular > 0.12) {
      const specBlend = (q.specular - 0.12) * 2.2;
      // Specular tinted by ether temperature
      const specR = centBal > 0 ? 220 : 160;
      const specG = centBal > 0 ? 195 : 140;
      const specB = centBal > 0 ? 130 : 200;
      r = floor(min(255, r + specBlend * specR * 0.5));
      g = floor(min(255, g + specBlend * specG * 0.5));
      b = floor(min(255, b + specBlend * specB * 0.5));
    }

    // ── CONTOUR LINE RENDERING: darken at contour positions ──
    const totalContour = contourFlux + contourField + contourEther + contourCS;
    const contourDarken = 1 - min(0.65, totalContour);
    r = floor(max(0, r * contourDarken));
    g = floor(max(0, g * contourDarken));
    b = floor(max(0, b * contourDarken));
    // Inertia plane contour: golden tint instead of darken
    if (contourInertia > 0.005) {
      r = floor(min(255, r + contourInertia * 120));
      g = floor(min(255, g + contourInertia * 100));
      b = floor(min(255, b + contourInertia * 30));
    }

    // ── Atmospheric haze ──
    const hazeDepth = Math.max(0, (q.depth + 200) / 400);
    const hazeOp = ATMOSPHERE.hazeOpacity(hazeDepth * 300);
    const [hR, hG, hB] = ATMOSPHERE.scatterColor(hazeDepth);
    const pT = ATMOSPHERE.pressureColorTemp();
    r = floor(r * (1 - hazeOp) + (hR * 80 + pT.r * 30) * hazeOp);
    g = floor(g * (1 - hazeOp) + (hG * 120 + pT.g * 20) * hazeOp);
    b = floor(b * (1 - hazeOp) + (hB * 200 + pT.b * 40) * hazeOp);

    // Final clamp
    r = max(0, min(255, r));
    g = max(0, min(255, g));
    b = max(0, min(255, b));

    ctx.fillStyle = `rgba(${r},${g},${b},0.96)`;
    ctx.beginPath();
    ctx.moveTo(q.p0.sx, q.p0.sy);
    ctx.lineTo(q.p1.sx, q.p1.sy);
    ctx.lineTo(q.p2.sx, q.p2.sy);
    ctx.lineTo(q.p3.sx, q.p3.sy);
    ctx.closePath();
    ctx.fill();
  }

  // ── DIELECTRIC INERTIA PLANE: bright golden ring at φ = π/2 ──
  // This is Wheeler's "plane of inertia" where centripetal = centrifugal
  // Double-pass: glow + core for visibility
  ctx.globalAlpha = 0.35;
  ctx.strokeStyle = 'rgba(235,200,80,0.5)';
  ctx.lineWidth = 3.5;
  ctx.beginPath();
  const inertiaSteps = 120;
  for (let s = 0; s <= inertiaSteps; s++) {
    const theta = (s / inertiaSteps) * TAU;
    const pt = torusToScreen(theta, WHEELER.inertiaPlane, cw/2, ch/2);
    if (s === 0) ctx.moveTo(pt.sx, pt.sy); else ctx.lineTo(pt.sx, pt.sy);
  }
  ctx.stroke();
  // Core pass — brighter, thinner
  ctx.strokeStyle = 'rgba(255,225,120,0.6)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  for (let s = 0; s <= inertiaSteps; s++) {
    const theta = (s / inertiaSteps) * TAU;
    const pt = torusToScreen(theta, WHEELER.inertiaPlane, cw/2, ch/2);
    if (s === 0) ctx.moveTo(pt.sx, pt.sy); else ctx.lineTo(pt.sx, pt.sy);
  }
  ctx.stroke();
  ctx.globalAlpha = 1.0;
}

