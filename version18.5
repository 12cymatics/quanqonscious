function buildPanel() {
  const list = document.getElementById('sutra-list');
  list.innerHTML = '';
  SUTRAS.forEach((s, i) => {
    const el = document.createElement('div');
    el.className = 'st';
    const label = document.createElement('div');
    label.style.cssText = 'display:flex;align-items:center;gap:4px;cursor:pointer;flex:1;min-width:0';
    label.innerHTML = `<div class="led"></div><span class="sid">S${s.id}</span><span class="sname" style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${s.sk} ${s.name}</span>`;
    label.addEventListener('click', () => {
      s.strength = s.strength > 0 ? 0 : 50;
      s.on = s.strength > 0;
      slider.value = s.strength; val.textContent = s.strength;
      el.classList.toggle('active', s.on);
    });
    const slider = document.createElement('input');
    slider.type = 'range'; slider.min = '0'; slider.max = '100'; slider.value = s.strength;
    slider.style.cssText = 'width:50px;height:10px;flex-shrink:0';
    const val = document.createElement('span');
    val.style.cssText = 'color:#666;font-size:7px;width:18px;text-align:right;flex-shrink:0';
    val.textContent = s.strength;
    slider.addEventListener('input', () => {
      s.strength = parseInt(slider.value);
      s.on = s.strength > 0; val.textContent = s.strength;
      el.classList.toggle('active', s.on);
    });
    el.appendChild(label); el.appendChild(slider); el.appendChild(val);
    list.appendChild(el);
  });
}

const center = document.getElementById('center');
center.addEventListener('mousemove', e => {
  if (!isDrag) return;
  camRY += (e.clientX - lastMX) * 0.005;
  camRX += (e.clientY - lastMY) * 0.005;
  lastMX = e.clientX; lastMY = e.clientY;
});
center.addEventListener('mousedown', e => { isDrag = true; lastMX = e.clientX; lastMY = e.clientY; autoRotate = false; });
center.addEventListener('mouseup', () => { isDrag = false; setTimeout(() => autoRotate = true, 8000); });
// Scroll wheel zoom
center.addEventListener('wheel', e => {
  e.preventDefault();
  ZOOM *= e.deltaY > 0 ? 0.92 : 1.08;
  ZOOM = max(0.05, min(3.0, ZOOM));
  const sl = document.getElementById('amp-zoom');
  if (sl) { sl.value = floor(ZOOM * 100); }
  const d = document.getElementById('amp-zoom-v');
  if (d) d.textContent = ZOOM.toFixed(2);
}, { passive: false });
// ── Touch rotation for mobile ──
let touchId = null, touchX = 0, touchY = 0;
center.addEventListener('touchstart', e => {
  if (e.touches.length === 1) {
    e.preventDefault();
    touchId = e.touches[0].identifier;
    touchX = e.touches[0].clientX;
    touchY = e.touches[0].clientY;
    autoRotate = false;
  }
}, {passive: false});
center.addEventListener('touchmove', e => {
  if (touchId === null) return;
  for (const t of e.changedTouches) {
    if (t.identifier === touchId) {
      e.preventDefault();
      camRY += (t.clientX - touchX) * 0.008;
      camRX += (t.clientY - touchY) * 0.008;
      touchX = t.clientX; touchY = t.clientY;
    }
  }
}, {passive: false});
center.addEventListener('touchend', e => {
  for (const t of e.changedTouches) {
    if (t.identifier === touchId) { touchId = null; setTimeout(() => autoRotate = true, 8000); }
  }
});


let frameTime = 0;
function frame(t) {
  frameTime = t;
  cw = W / devicePixelRatio; ch = H / devicePixelRatio;

  try {
  if (autoRotate) { camRY += 0.00012; camRX += sin(t * 0.000004) * 0.00003; }

  // PRE-SANITIZE: Lean-verified QI interval bounds (Interval.lean: contains_add, contains_sub)
  // QI.clampLambda() removed — canonical state unclamped

  // Sync Lean State from lambda BEFORE evolves
  LeanState.syncFromLambda();

  // ── VERTEX FIELD SUBSTRATE: λ → Ψ[16] ──────────────────────────────────
  // Forward transform: project 4-vector into 16-vertex tesseract field
  VTX.forward();

  // ── USO ENERGY INJECTION ──────────────────────────────────────────────
  // VERTEX INJECTION: Hamming-layer patterned energy from USO
  // Every frame at ÷4 amplitude (same total energy, no stutter)
  {
    const P = USO.P, S = USO.S;
    const drive = (P - 1) * 0.125; // ÷4 from old 0.5 (was only every 4th frame)
    for (let i = 0; i < 16; i++) {
      const hw = VTX.hw(i);
      const sign = (hw % 2 === 0) ? 1 : -1;
      const inject = drive * sign * (1 + hw * 0.2) * abs(S) * 0.3;
      if (isFinite(inject) && abs(inject) < 50) {
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(inject * 10000), 10000n));
      }
    }
  }

  // ── ‖Ψ‖² CONSERVATION + INTERLEAVED GRVQ + DISTRIBUTED COUPLING ───────
  const E_pre_all = Q.fl(VTX.normSq());
  const active = SUTRAS.filter(s => s.on);
  for (const s of active) {
    try {
      const E_before = Q.fl(VTX.normSq());
      s.lastResult = s.evolve(1);
      const E_after_sutra = Q.fl(VTX.normSq());
      VTX.normalize(4000); // GRVQ vertex-level damping interleaved
      const E_after_grvq = Q.fl(VTX.normSq());
      s._lastE = { before: E_before, afterSutra: E_after_sutra, afterGRVQ: E_after_grvq,
        deltaS: E_after_sutra - E_before, deltaG: E_after_grvq - E_after_sutra };
      LeanState.act(s.id);
    }
    catch (e) { s.lastResult = `[ERR: ${e.message}]`; }
  }
  const E_post_all = Q.fl(VTX.normSq());
  if (!window._CONSERV) window._CONSERV = { log: [], maxLen: 200, violations: 0 };
  const dE_frame = E_post_all - E_pre_all;
  const relE = E_pre_all > 1e-15 ? dE_frame / E_pre_all : 0;
  if (abs(relE) > 0.5) window._CONSERV.violations++;
  if (cycle % 10 === 0) {
    window._CONSERV.log.push({ cycle, E_pre: E_pre_all, E_post: E_post_all, dE: dE_frame, relE,
      active: active.map(s => ({ id: s.id, dS: s._lastE?.deltaS || 0, dG: s._lastE?.deltaG || 0 })) });
    if (window._CONSERV.log.length > window._CONSERV.maxLen) window._CONSERV.log.shift();
  }
  // Record ALL actual co-active sutra pairs (not hardcoded partners)
  if (active.length >= 2) {
    for (let a = 0; a < active.length; a++)
      for (let b = a + 1; b < active.length; b++)
        INTER_SUTRA.recordInteraction(active[a].id, active[b].id);
  }

  // ── DISTRIBUTED GRVQ — equal share for ALL active sutras ──────────────
  // No minimum active count required. Equal 1/N weighting, not sid/435.
  {
    const invN = 1 / max(1, active.length);
    for (const s of active) {
      if (s.id !== 1 && s.id !== 5 && s.id !== 9 && s.id !== 14) {
        const k = (s.id - 1) % 4;
        const grvqShare = GRVQ.evolve(lambda, k, simTime) * invN;
        if (isFinite(grvqShare)) {
          lambda[k] = Q.add(lambda[k], Q.mk(Bi(grvqShare * 10000), 10000n));
        }
      }
    }
  }

  // ── DISTRIBUTED MSTVQ + WHEELER + TGCR for all active sutras ────────
  if (active.length >= 1) {
    const psiMean = Q.fl(VTX.mean());
    const psiNorm = Q.fl(VTX.normSq());
    const bScale = 0.15 / max(1, active.length);
    MSTVQ.setB(psiMean * bScale, sqrt(psiNorm) * bScale * 0.1, abs(SUPPRESS.alpha(1)));
    MSTVQ.compute();
    MSTVQ.feedbackToTGCR();
    MSTVQ.feedbackToLambda(lambda);
    const wheelerMod = WHEELER.radialFactor(abs(psiMean) * 0.1, 0.1);
    vortexOmega += (wheelerMod - 1) * 0.002 * active.length;
  }

  // ── INVERSE TRANSFORM: Ψ[16] → λ ─────────────────────────────────────
  // Energy conservation: bound ‖Ψ‖² to prevent blowup from compound operators
  // Max energy = 16 × 500² = 4,000,000 (generous ceiling)

  // ── MAGNETIC FIELD DYNAMICS ──
  MAGFIELD.update();
  MAGFIELD.applyLorentz();
  MAGFIELD.detectReconnection();
  MAGFIELD.feedToMSTVQ();

  // ── 8×8 ENGINE EVOLUTION ──
  // Order: sync IN → accumulate sutras → evolve → sync OUT → rebuild
  ENGINE.syncFromVTX();        // (1) absorb sutra-modified VTX state
  ENGINE.accumulateSutras();   // (2) accumulate sutra displacements (drains every 10 frames)
  ENGINE.evolve();             // (3) unitary evolution under H
  ENGINE.syncToVTX();          // (4) push ENGINE state back to VTX
  if (cycle % 15 === 0) ENGINE.rebuild(); // (5) rebuild H every 30 frames (was 60)

  // ── JET PROPULSION ──
  JET.update();

  // ── WORMHOLE FORMATION PROTOCOL ──
  WORMHOLE_PROTO.update();
  // Bridge WORMHOLE_DETECT consecutive tracking → WORMHOLE_PROTO.stableFrames
  // WORMHOLE_DETECT tracks actual formation criteria; PROTO.stableFrames feeds the gauge
  WORMHOLE_PROTO.stableFrames = WORMHOLE_DETECT.consecutiveCount;

  VTX.normalize(4000); // raised from 400: max vertex ≈ 10 vs 5
  // Reconstruct 4-vector from transformed vertex field
  VTX.inverse();

  // ── OSCILLATORY LAMBDA DRIVER ──────────────────────────────────────
  // AFTER inverse (so it's not overwritten). φ-incommensurate frequencies
  // create persistent non-repeating dynamics that sutras modulate.
  {
    const t = simTime * 0.001;
    const P = USO.P, S = USO.S;
    const targets = [
      (3 + P * 2) * sin(t * 1.0000),
      (4 + S * 2) * sin(t * C.phi_f + PI * 0.25),
      (5 + P * 1.5) * cos(t * C.phi_f * C.phi_f + PI * 0.5),
      (6 + S * 1.5) * sin(t * C.sqrt2_f + PI * 0.75)
    ];
    // Oscillatory driver strength scales INVERSELY with active sutra count
    // More sutras active → less external driving needed → sutras dominate
    const activeCount = SUTRAS.filter(s => s.on).length;
    const driverStrength = activeCount > 0 ? Math.max(1, 4 - activeCount) : 4;
    for (let k = 0; k < 4; k++) {
      const target = Q.mk(Bi(targets[k] * 1000), 1000n);
      const diff = Q.sub(target, lambda[k]);
      lambda[k] = Q.add(lambda[k], Q.mul(diff, Q.mk(BigInt(driverStrength), 4000n)));
    }
  }

  CASCADE.update();

  // POST-SANITIZE: QI interval bounds again after evolves
  // QI.clampLambda() removed — canonical state unclamped

  // Advance deterministic simulation time (decoupled from wall clock)
  simTime += SIM_DT;
  cycle++;
  computeR4();
  if (cycle % 10 === 0) computeUSO();

  // TGCR: clamp vortex omega to prevent energy divergence
  TGCR.clampOmega();

  // Update TGCR from current vortex state — coupled to Lean momentum (State.lean: X'=X+x*k)
  if (cycle % 5 === 0) {
    const theta_avg = (cycle * 0.01) % TAU;
    const phi_avg = (cycle * 0.007) % TAU;
    // Momentum coupling: soft saturate to [0,1] for stable TGCR speed
    const momContrib = abs(LeanState.momX()) / (1 + abs(LeanState.momX()));
    TGCR.setVortex(theta_avg, phi_avg, abs(vortexOmega) + 0.1 + momContrib * 0.5);
    TGCR.computeEnergy();
    TGCR.checkPhaseLock(theta_avg, 0.333); // a=1/3 for θ/(3a)=1
  }

  // Update MSTVQ tensor — coupled to Lean momentum (State.lean: Y'=Y+y*k, Z'=Z+z*k)
  if (cycle % 8 === 0) {
    const mY = LeanState.momY(), mZ = LeanState.momZ();
    const momYn = mY / (1 + abs(mY)) * 0.1;
    const momZn = mZ / (1 + abs(mZ)) * 0.1;
    const feNorm = fieldEnergy() / (1 + fieldEnergy()) * 0.02;
    MSTVQ.setB(Q.fl(lambda[0]) * 0.15 + momYn, Q.fl(lambda[1]) * 0.15 + momZn, feNorm);
    MSTVQ.compute();
    // FEEDBACK LOOP: MSTVQ trace → TGCR κ + MSTVQ stress → λ
    MSTVQ.feedbackToTGCR();
    MSTVQ.feedbackToLambda(lambda);
  }

  // Update Ansatz with FEEDBACK to λ
  if (cycle % 30 === 0) {
    ANSATZ.computeEnergy(lambda);
    // VQE optimization: update circuit parameters toward lower energy
    if (cycle % 60 === 0) ANSATZ.updateParams(lambda, 0.01);
    // Ansatz energy gradient feeds back into λ
    ANSATZ.feedbackToLambda(lambda);
  }

  updateField(simTime);
  projectTorus(simTime);

  // ── ATMOSPHERE UPDATE ──
  ATMOSPHERE.update();
  
  // ── ATMOSPHERIC BACKGROUND RENDERING ──
  // Base: near-black with slight blue from Rayleigh scattering
  const atPC = ATMOSPHERE.pressureColorTemp();
  const rawEnergy = fieldEnergy();
  const energy = rawEnergy / (1 + rawEnergy); // [0,1)
  const ionF = ATMOSPHERE.ionFraction;
  
  // Deep space base color (Rayleigh-tinted)
  const bgR = floor(3 + atPC.r * 8 + ionF * 15);
  const bgG = floor(3 + atPC.g * 5);
  const bgB = floor(8 + atPC.b * 12);
  ctx.fillStyle = `rgb(${bgR},${bgG},${bgB})`;
  ctx.fillRect(0, 0, cw, ch);
  
  // Atmospheric haze layers — concentric from torus center
  // Layer 1: Near-field (ionization glow — pink/purple when ionized)
  const glowR1 = 80 + energy * 80 + abs(vortexOmega) * 30;
  const grd1 = ctx.createRadialGradient(cw/2, ch/2, 0, cw/2, ch/2, glowR1);
  grd1.addColorStop(0, `rgba(${floor(20 + ionF * 120 + energy * 30)},${floor(8 + ionF * 30)},${floor(30 + ionF * 80 + energy * 20)},${(0.2 + ionF * 0.3).toFixed(2)})`);
  grd1.addColorStop(0.7, `rgba(${floor(10 + atPC.r * 15)},${floor(5 + atPC.g * 8)},${floor(20 + atPC.b * 15)},0.08)`);
  grd1.addColorStop(1, 'rgba(3,3,8,0)');
  ctx.fillStyle = grd1;
  ctx.fillRect(0, 0, cw, ch);
  
  // Layer 2: Pressure halo — orange when overpressure, blue when underpressure
  const pRatio = ATMOSPHERE.P_local / ATMOSPHERE.P0;
  const glowR2 = 150 + energy * 60;
  const grd2 = ctx.createRadialGradient(cw/2, ch/2, glowR1 * 0.5, cw/2, ch/2, glowR2);
  const pressR = floor(Math.min(255, pRatio > 1 ? 15 + (pRatio - 1) * 60 : 5));
  const pressG = floor(Math.min(255, 5 + abs(pRatio - 1) * 10));
  const pressB = floor(Math.min(255, pRatio < 1 ? 15 + (1 - pRatio) * 80 : 8));
  grd2.addColorStop(0, `rgba(${pressR},${pressG},${pressB},0.06)`);
  grd2.addColorStop(1, 'rgba(3,3,8,0)');
  ctx.fillStyle = grd2;
  ctx.fillRect(0, 0, cw, ch);

  renderTorus();
  renderTesseract(simTime);

  // ── Detection systems + visual log overlay ──
  if (cycle % 2 === 0) {
    ENERGY_DETECT.update();
    WORMHOLE_DETECT.update();
    GEO_LOG.analyzeFrame();
    VISUAL_LOG.update();
  }
  if (showOverlay) VISUAL_LOG.draw(ctx, cw, ch);

  // (Recording replaced by JSON export)

  if (cycle % 8 === 0) updateHUD();

  } catch (frameErr) {
    // Frame error recovery — reset lambda to safe values, keep running
    for (let k = 0; k < 4; k++) lambda[k] = Q.mk(BigInt(k + 3));
    LeanState.reset(); // Reset verified state too
    console.warn('Frame recovery:', frameErr.message);
  }
  RECORDER.tick(); // 30-second field recorder
  requestAnimationFrame(frame);
}

