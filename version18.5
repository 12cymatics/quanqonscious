// §2b EXACT TRANSCENDENTAL EVALUATION IN ℚ — Taylor Series
//
// sin(x) = Σₙ₌₀ (-1)ⁿ x^(2n+1) / (2n+1)!
// cos(x) = Σₙ₌₀ (-1)ⁿ x^(2n) / (2n)!
//
// All computation in exact BigInt rationals. No IEEE-754 contamination.
// Factorial computed as BigInt. Convergent for all x (but best for |x| ≤ π).
// For MSTVQ: |B|/B_tensor is tiny → rapid convergence in ≤ 6 terms.
// ═══════════════════════════════════════════════════════════════════════════════
const QTaylor = {
  _factCache: [1n, 1n, 2n, 6n, 24n, 120n, 720n, 5040n, 40320n, 362880n,
               3628800n, 39916800n, 479001600n, 6227020800n, 87178291200n,
               1307674368000n, 20922789888000n, 355687428096000n,
               6402373705728000n, 121645100408832000n, 2432902008176640000n,
               51090942171709440000n, 1124000727777607680000n,
               25852016738884976640000n, 620448401733239439360000n],

  fact(n) {
    if (n < this._factCache.length) return this._factCache[n];
    let f = this._factCache[this._factCache.length - 1];
    for (let i = this._factCache.length; i <= n; i++) {
      f *= BigInt(i);
      this._factCache.push(f);
    }
    return f;
  },

  // sin(x) exact in ℚ — x is Rat {n, d}
  sin(x, order = 10) {
    let sum = Q.ZERO;
    let sign = 1n;
    for (let k = 0; k <= order; k++) {
      const exp = 2 * k + 1;
      const xPow = Q.pow(x, exp);
      const denom = Q.mk(this.fact(exp));
      const term = Q.div(xPow, denom);
      sum = sign === 1n ? Q.add(sum, term) : Q.sub(sum, term);
      sign = -sign;
    }
    return sum;
  },

  // cos(x) exact in ℚ
  cos(x, order = 10) {
    let sum = Q.ZERO;
    let sign = 1n;
    for (let k = 0; k <= order; k++) {
      const exp = 2 * k;
      const xPow = exp === 0 ? Q.ONE : Q.pow(x, exp);
      const denom = Q.mk(this.fact(exp));
      const term = Q.div(xPow, denom);
      sum = sign === 1n ? Q.add(sum, term) : Q.sub(sum, term);
      sign = -sign;
    }
    return sum;
  },

  // sqrt(x) via Newton in ℚ — quadratic convergence
  sqrt(x, iters = 8) {
    if (x.n === 0n) return Q.ZERO;
    if (x.n < 0n) return Q.ZERO; // guard
    let guess = Q.mk(isqrt(x.n * x.d), x.d);
    for (let i = 0; i < iters; i++) {
      const xg = Q.div(x, guess);
      guess = Q.div(Q.add(guess, xg), Q.TWO);
    }
    return guess;
  },

  // |v| = sqrt(vx²+vy²+vz²) for 3-vectors of Rat
  mag3(a, b, c) {
    return this.sqrt(Q.add(Q.add(Q.mul(a,a), Q.mul(b,b)), Q.mul(c,c)));
  }
};
