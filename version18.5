// ═══════════════════════════════════════════════════════════════════════════════
// §17 ENERGY CONSERVATION DETECTOR
//
// Tracks ‖Ψ‖² across frames. Conservation detected when:
//   |ΔE/E| < threshold over N consecutive frames
//
// Also tracks: total λ-energy Σ|λₖ|², σ stability, USO P·S invariant
// ═══════════════════════════════════════════════════════════════════════════════
const ENERGY_DETECT = {
  history: [],        // recent ‖Ψ‖² values
  maxHistory: 120,    // ~2 seconds at 60fps
  threshold: 0.005,   // 0.5% relative change
  consecutiveNeeded: 60, // 1 second of stability
  consecutiveCount: 0,
  conserved: false,
  lastE: 0,
  lambdaE: 0,        // Σ|λₖ|²

  update() {
    const E = Q.fl(VTX.normSq());
    this.lambdaE = lambda.reduce((s, l) => s + Q.fl(Q.mul(l, l)), 0);
    this.history.push(E);
    if (this.history.length > this.maxHistory) this.history.shift();

    if (this.lastE > 0.01 && E > 0.01) {
      const relChange = abs(E - this.lastE) / this.lastE;
      if (relChange < this.threshold) {
        this.consecutiveCount++;
      } else {
        this.consecutiveCount = 0;
      }
    } else {
      this.consecutiveCount = 0;
    }
    this.lastE = E;
    this.conserved = this.consecutiveCount >= this.consecutiveNeeded;

    const badge = document.getElementById('energy-badge');
    if (this.conserved) {
      badge.classList.add('active');
      badge.textContent = `⚡ ENERGY CONSERVED  E=${E.toFixed(0)}  ΔE/E<${(this.threshold*100).toFixed(1)}%  (${this.consecutiveCount} frames)`;
    } else {
      badge.classList.remove('active');
    }
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §18 STABLE WORMHOLE DETECTOR
//
// A "wormhole" = topological throat where the torus tube radius approaches zero
// or the σ field creates a through-connection between inner/outer torus regions.
//
// Detection criteria:
//   1. Complementary vertex pairs (i, comp(i)) have OPPOSITE sign Ψ fields
//   2. The throat ratio |Ψ_min/Ψ_max| stays stable (not oscillating wildly)
//   3. σ suppression < 0.3 (low σ = throat formation geometry)
//   4. The field gradient concentrates at specific torus angles (throat location)
//
// "Stable" = all criteria met for N consecutive frames
// ═══════════════════════════════════════════════════════════════════════════════
const WORMHOLE_DETECT = {
  consecutiveNeeded: 90, // 1.5 seconds
  consecutiveCount: 0,
  stable: false,
  throatAngle: 0,     // where on the torus the throat forms
  throatRatio: 0,     // |Ψ_min/Ψ_max| at throat
  pairCoherence: 0,   // how many complementary pairs have opposite signs

  update() {
    const vpsi = VTX.psi.map(p => Q.fl(p));
    const r4 = Q.fl(R4val);

    // 1. Count complementary pairs with opposite signs
    let oppositePairs = 0;
    for (let i = 0; i < 8; i++) {
      const j = VTX.comp(i);
      if (vpsi[i] * vpsi[j] < 0) oppositePairs++;
    }
    this.pairCoherence = oppositePairs / 8;

    // 2. Throat ratio: |min|/|max|
    let psiMin = Infinity, psiMax = 0;
    for (let i = 0; i < 16; i++) {
      const a = abs(vpsi[i]);
      if (a < psiMin && a > 0.001) psiMin = a;
      if (a > psiMax) psiMax = a;
    }
    this.throatRatio = psiMax > 0.01 ? psiMin / psiMax : 0;

    // 3. Find throat angle (where field crosses zero)
    let maxGradAngle = 0, maxGradVal = 0;
    for (let i = 0; i < 16; i++) {
      for (const j of VTX.neighbors(i)) {
        if (j <= i) continue;
        const grad = abs(vpsi[i] - vpsi[j]);
        if (grad > maxGradVal) {
          maxGradVal = grad;
          maxGradAngle = (i + j) / 32 * TAU;
        }
      }
    }
    this.throatAngle = maxGradAngle;

    // 4. Wormhole criteria
    const criteria = (
      this.pairCoherence > 0.5 &&     // majority of pairs have opposite signs
      this.throatRatio < 0.4 &&        // strong asymmetry (throat-like)
      this.throatRatio > 0.001 &&      // but not zero (collapsed)
      r4 < 0.5                         // near-singularity region
    );

    if (criteria) {
      this.consecutiveCount++;
    } else {
      this.consecutiveCount = max(0, this.consecutiveCount - 2); // slow decay
    }
    this.stable = this.consecutiveCount >= this.consecutiveNeeded;

    const badge = document.getElementById('wormhole-badge');
    if (this.stable) {
      badge.classList.add('active');
      badge.textContent = `◉ STABLE WORMHOLE  θ=${sf(this.throatAngle,2)}  ratio=${sf(this.throatRatio,3)}  pairs=${oppositePairs}/8  (${this.consecutiveCount}f)`;
    } else if (this.consecutiveCount > 20) {
      badge.classList.add('active');
      badge.textContent = `◎ FORMING WORMHOLE  coherence=${sf(this.pairCoherence,2)}  ratio=${sf(this.throatRatio,3)}  (${this.consecutiveCount}/${this.consecutiveNeeded}f)`;
      badge.style.opacity = 0.5 + 0.5 * (this.consecutiveCount / this.consecutiveNeeded);
    } else {
      badge.classList.remove('active');
    }
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §19 ON-CANVAS VISUAL LOG OVERLAY
//
// Draws field state directly onto the canvas — visible even with panels collapsed.
// Formats: sparkline history, vertex field heatbar, operator type activity
// ═══════════════════════════════════════════════════════════════════════════════
const VISUAL_LOG = {
  energyHistory: [],
  r4History: [],
  lambdaHistory: [[], [], [], []],
  usoP_History: [],
  usoS_History: [],
  alphaHistory: [],   // SUPPRESS.alpha(1) per frame
  tgcrHistory: [],
  mstvqHistory: [],
  geoRHistory: [],    // R range per frame
  georHistory: [],    // r range per frame
  bfieldHistory: [],  // |B| total per frame
  helicityHistory: [], // magnetic helicity per frame
  thrustHistory: [],  // jet thrust per frame
  maxHist: 200,

  update() {
    const E = Q.fl(VTX.normSq());
    this.energyHistory.push(E);
    if (this.energyHistory.length > this.maxHist) this.energyHistory.shift();

    this.r4History.push(Q.fl(R4val));
    if (this.r4History.length > this.maxHist) this.r4History.shift();

    for (let k = 0; k < 4; k++) {
      this.lambdaHistory[k].push(Q.fl(lambda[k]));
      if (this.lambdaHistory[k].length > this.maxHist) this.lambdaHistory[k].shift();
    }

    this.usoP_History.push(USO.P);
    if (this.usoP_History.length > this.maxHist) this.usoP_History.shift();
    this.usoS_History.push(USO.S);
    if (this.usoS_History.length > this.maxHist) this.usoS_History.shift();

    this.alphaHistory.push(SUPPRESS.alpha(1));
    if (this.alphaHistory.length > this.maxHist) this.alphaHistory.shift();

    this.tgcrHistory.push(TGCR.energy);
    if (this.tgcrHistory.length > this.maxHist) this.tgcrHistory.shift();

    this.mstvqHistory.push(MSTVQ.trace());
    if (this.mstvqHistory.length > this.maxHist) this.mstvqHistory.shift();

    this.geoRHistory.push(GEO_LOG.frameRmax - GEO_LOG.frameRmin);
    if (this.geoRHistory.length > this.maxHist) this.geoRHistory.shift();
    this.georHistory.push(GEO_LOG.framerMax - GEO_LOG.framerMin);
    if (this.georHistory.length > this.maxHist) this.georHistory.shift();

    this.bfieldHistory.push(MAGFIELD.active ? MAGFIELD.totalB : 0);
    if (this.bfieldHistory.length > this.maxHist) this.bfieldHistory.shift();
    this.helicityHistory.push(MAGFIELD.active ? MAGFIELD.helicity : 0);
    if (this.helicityHistory.length > this.maxHist) this.helicityHistory.shift();
    this.thrustHistory.push(JET.active ? JET.thrust : 0);
    if (this.thrustHistory.length > this.maxHist) this.thrustHistory.shift();
  },

  draw(ctx, cw, ch) {
    ctx.save();
    const PW = 380, PH = 380; // panel dimensions (expanded for mag/jet data)
    const x0 = 10, y0 = ch - PH - 5;
    let y = y0;

    // Background panel
    ctx.fillStyle = 'rgba(5,5,16,0.82)';
    ctx.fillRect(x0, y0, PW, PH);
    ctx.strokeStyle = 'rgba(40,40,80,0.4)';
    ctx.strokeRect(x0, y0, PW, PH);
    ctx.font = '8px JetBrains Mono, monospace';

    // ── ROW 1: Vertex field heatbar Ψ[16] ──
    const vpsi = VTX.psi.map(p => Q.fl(p));
    let pMax = 0.001;
    for (const v of vpsi) pMax = max(pMax, abs(v));
    ctx.fillStyle = '#777';
    ctx.fillText('Ψ[16]', x0 + 3, y + 10);
    for (let i = 0; i < 16; i++) {
      const norm = vpsi[i] / pMax;
      const bx = x0 + 36 + i * 18;
      if (norm > 0) {
        ctx.fillStyle = `rgb(${floor(180+norm*75)},${floor(130+norm*100)},${floor(40+norm*40)})`;
      } else {
        const n = abs(norm);
        ctx.fillStyle = `rgb(${floor(40+n*60)},${floor(140+n*90)},${floor(200+n*55)})`;
      }
      ctx.fillRect(bx, y + 3, 16, 8);
      // Numerical value under bar
      ctx.fillStyle = '#555';
      ctx.fillText(sf(vpsi[i], 0), bx, y + 20);
    }
    y += 24;

    // ── ROW 2: Energy + σ sparklines ──
    this._sparkline(ctx, x0 + 4, y, 160, 22, this.energyHistory, '#4aff4a', '‖Ψ‖²');
    this._sparkline(ctx, x0 + 174, y, 160, 22, this.r4History, '#ff4aff', 'σ');
    y += 32;

    // ── ROW 3: λ sparklines (4 across) ──
    const lC = ['#ffaa44', '#44aaff', '#ff44aa', '#aaff44'];
    const lN = ['λ₀', 'λ₁', 'λ₂', 'λ₃'];
    for (let k = 0; k < 4; k++)
      this._sparkline(ctx, x0 + 4 + k * 84, y, 78, 16, this.lambdaHistory[k], lC[k], lN[k]);
    y += 26;

    // ── ROW 4: USO P/S + α + TGCR + MSTVQ sparklines ──
    this._sparkline(ctx, x0 + 4, y, 62, 14, this.usoP_History, '#ffcc00', 'P');
    this._sparkline(ctx, x0 + 72, y, 62, 14, this.usoS_History, '#cc88ff', 'S');
    this._sparkline(ctx, x0 + 140, y, 62, 14, this.alphaHistory, '#ff6644', 'α₁');
    this._sparkline(ctx, x0 + 208, y, 62, 14, this.tgcrHistory, '#44ff88', 'ℰ');
    this._sparkline(ctx, x0 + 276, y, 58, 14, this.mstvqHistory, '#88aaff', 'Tr');
    y += 24;

    // ── ROW 5: Geometry range sparklines ──
    this._sparkline(ctx, x0 + 4, y, 106, 14, this.geoRHistory, '#ffaa00', 'ΔR');
    this._sparkline(ctx, x0 + 118, y, 82, 14, this.georHistory, '#00aaff', 'Δr');
    // Magnetic and jet sparklines (only if active)
    if (MAGFIELD.active) this._sparkline(ctx, x0 + 208, y, 82, 14, this.bfieldHistory, '#8888ff', '|B|');
    else if (JET.active) this._sparkline(ctx, x0 + 208, y, 82, 14, this.thrustHistory, '#ffaa44', 'T');
    if (MAGFIELD.active) this._sparkline(ctx, x0 + 298, y, 76, 14, this.helicityHistory, '#aa88ff', 'H');
    y += 24;

    // ── ROW 6: Numerical readouts (dense) ──
    ctx.fillStyle = '#888';
    const E = this.energyHistory.length > 0 ? this.energyHistory[this.energyHistory.length - 1] : 0;
    const r4 = this.r4History.length > 0 ? this.r4History[this.r4History.length - 1] : 0;
    ctx.fillText(`E=${E.toFixed(0)}  σ=${r4.toFixed(4)}  P=${USO.P.toFixed(3)}  S=${USO.S.toFixed(3)}  ω=${sf(vortexOmega,3)}`, x0 + 4, y);
    y += 10;
    ctx.fillText(`λ=[${lambda.map(l=>sf(Q.fl(l),2)).join(', ')}]  Σλ²=${lambda.reduce((s,l)=>s+Q.fl(Q.mul(l,l)),0).toFixed(1)}`, x0 + 4, y);
    y += 10;
    ctx.fillText(`TGCR ℰ=${sf(TGCR.energy,3)}  κ=${sf(TGCR.kappa,3)}  Tr(M)=${sf(MSTVQ.trace(),3)}  αΨ=${sf(SUPPRESS.alpha(1),4)}`, x0 + 4, y);
    y += 10;
    ctx.fillText(`Ψ_max=${sf(pMax,2)}  Geo R:[${sf(GEO_LOG.frameRmin,0)},${sf(GEO_LOG.frameRmax,0)}]  r:[${sf(GEO_LOG.framerMin,0)},${sf(GEO_LOG.framerMax,0)}]`, x0 + 4, y);
    y += 10;

    // ── ROW 7: Operator type distribution ──
    const opTypes = ['MULT','REFL','CONV','DIV','DIFF','PERM','MOD','CONS'];
    const opColors = ['#ffaa44','#44aaff','#ff44aa','#aaff44','#ff8844','#44ffaa','#aa44ff','#ffffff'];
    const activeOps = SUTRAS.filter(s => s.on);
    const typeCounts = {};
    for (const s of activeOps) {
      const m = s.desc.match(/^(\w+):/);
      if (m) typeCounts[m[1]] = (typeCounts[m[1]] || 0) + 1;
    }
    let ox = x0 + 4;
    for (let i = 0; i < opTypes.length; i++) {
      const key = opTypes[i] === 'CONS' ? 'CONSERVATION' : opTypes[i].slice(0, 4);
      const fullKey = Object.keys(typeCounts).find(k => k.startsWith(key)) || '';
      const count = typeCounts[fullKey] || 0;
      ctx.fillStyle = count > 0 ? opColors[i] : '#222';
      ctx.fillRect(ox, y, max(count * 7, 3), 5);
      ctx.fillStyle = count > 0 ? '#888' : '#333';
      ctx.fillText(`${opTypes[i].slice(0,2)}${count}`, ox, y + 14);
      ox += max(count * 7, 14) + 6;
    }
    y += 18;

    // ── ROW 8: Detection status ──
    ctx.fillStyle = ENERGY_DETECT.conserved ? '#4aff4a' : (ENERGY_DETECT.consecutiveCount > 10 ? '#226622' : '#333');
    ctx.fillText(`⚡ENERGY ${ENERGY_DETECT.conserved ? 'CONSERVED' : 'tracking'} ${ENERGY_DETECT.consecutiveCount}/${ENERGY_DETECT.consecutiveNeeded}f  ΔE/E=${((ENERGY_DETECT.lastE > 0 ? abs(Q.fl(VTX.normSq()) - ENERGY_DETECT.lastE) / ENERGY_DETECT.lastE : 0) * 100).toFixed(2)}%`, x0 + 4, y);
    y += 10;
    ctx.fillStyle = WORMHOLE_DETECT.stable ? '#ff4aff' : (WORMHOLE_DETECT.consecutiveCount > 20 ? '#664466' : '#333');
    ctx.fillText(`◉WORMHOLE ${WORMHOLE_DETECT.stable ? 'STABLE' : 'scanning'} ${WORMHOLE_DETECT.consecutiveCount}/${WORMHOLE_DETECT.consecutiveNeeded}f  pairs=${sf(WORMHOLE_DETECT.pairCoherence,2)}  throat=${sf(WORMHOLE_DETECT.throatRatio,3)}`, x0 + 4, y);
    y += 10;

    // ── ROW 8b: Magnetic dynamics ──
    if (MAGFIELD.active) {
      ctx.fillStyle = '#88aaff';
      ctx.fillText(`🧲 |B|=${sf(MAGFIELD.totalB,1)}  ∇B=${sf(MAGFIELD.curlMag,2)}  H=${sf(MAGFIELD.helicity,1)}  P=${MAGFIELD.pressure>1e4?MAGFIELD.pressure.toExponential(1):sf(MAGFIELD.pressure,0)}  F_L=${sf(MAGFIELD.lorentz.reduce((s,v)=>s+v,0),1)}`, x0 + 4, y);
      y += 10;
      if (MAGFIELD.reconnectCount > 0) {
        ctx.fillStyle = MAGFIELD.reconnectEnergy > 0.5 ? '#ff8844' : '#664422';
        ctx.fillText(`💥 RECONNECT events=${MAGFIELD.reconnectCount}  E_release=${sf(MAGFIELD.reconnectEnergy,2)}`, x0 + 4, y);
        y += 10;
      }
    }

    // ── ROW 8c: Jet propulsion ──
    if (JET.active) {
      ctx.fillStyle = JET.thrust > 0 ? '#ffaa44' : '#44aaff';
      ctx.fillText(`🚀 JET ${JET.mode}  thrust=${sf(JET.thrust,1)}  η=${sf(JET.efficiency,2)}  nozzle→exhaust`, x0 + 4, y);
      y += 10;
    }

    // ── ROW 8d: Wormhole protocol ──
    if (WORMHOLE_PROTO.active) {
      const phases = ['off', 'POLARIZING', 'CONCENTRATING', 'STABILIZING'];
      ctx.fillStyle = '#ff4aff';
      ctx.fillText(`🕳 WORMHOLE PROTOCOL phase=${phases[WORMHOLE_PROTO.phase]}  t=${WORMHOLE_PROTO.phaseTimer}/${WORMHOLE_PROTO.phaseDuration[WORMHOLE_PROTO.phase]}`, x0 + 4, y);
      y += 10;
    }

    // ── ROW 8e: 8×8 ENGINE ──
    if (CONTRACTS.lastResults) {
      const cr = CONTRACTS.lastResults;
      const idOk = cr.filter(r => r.identity).length;
      const maxDe = Math.max(...cr.map(r => Math.abs(r.dE_rel || 0)));
      ctx.fillStyle = idOk === cr.length ? '#44ff44' : '#ff8844';
      ctx.fillText(`CONTRACTS #${CONTRACTS.runCount}: ${idOk}/${cr.length} id-ok  |dE/E|=${sf(maxDe,4)}  Q-cap=${Q._compressionCount}  safe=${SAFETY.corrections}`, x0 + 4, y);
      y += 16;
    }
    if (ENGINE.coupling > 0.001) {
      const mags = ENGINE.psi8.map(z => CX.abs(z));
      const mIdx = mags.indexOf(max(...mags));
      const ph = atan2(ENGINE.psi8[mIdx][1], ENGINE.psi8[mIdx][0]);
      ctx.fillStyle = '#a0f0a0';
      ctx.fillText(`⊗ ENG8×8: |Ψ${mIdx}|=${mags[mIdx].toFixed(3)}  φ=${(ph*180/PI).toFixed(0)}°  ZPE=${ENGINE.zpe[0].toFixed(3)}  ‖H‖=${ENGINE.normH.toFixed(2)}  K=Q(√2,i)`, x0 + 4, y);
      y += 10;
    }

    // ── ROW 9: Geometry events ──
    const geoRecent = GEO_LOG.recent(3);
    if (geoRecent.length > 0) {
      ctx.fillStyle = '#555';
      ctx.fillText('GEO:', x0 + 4, y);
      const geoColors = { THROAT:'#ff4aff', EXPANSION:'#ffaa44', 'VORTEX-LOCK':'#44ffaa',
        'TUBE-RIPPLE':'#44aaff', 'VERTICAL-WAVE':'#aaff44', 'HIGH-ENERGY':'#ff4444' };
      for (const e of geoRecent) {
        y += 9;
        ctx.fillStyle = geoColors[e.type] || '#666';
        ctx.fillText(`C${e.cycle} ${e.type} ${e.detail} R${e.R} λ=[${e.lam}]`, x0 + 4, y);
      }
    }

    // ── Footer ──
    y += 12;
    ctx.fillStyle = '#d4af37';
    ctx.fillText(`${activeOps.length}/29 active  cycle=${cycle}  t=${(simTime*0.001).toFixed(1)}s  zoom=${ZOOM.toFixed(2)}`, x0 + 4, y);

    ctx.restore();
  },

  _sparkline(ctx, x, y, w, h, data, color, label) {
    if (data.length < 2) return;
    let mn = Infinity, mx = -Infinity;
    for (const v of data) { if (isFinite(v)) { mn = min(mn, v); mx = max(mx, v); } }
    if (!isFinite(mn)) mn = 0;
    if (!isFinite(mx)) mx = 1;
    const range = mx - mn || 1;

    ctx.fillStyle = '#444';
    ctx.fillText(label, x, y + h + 8);
    ctx.fillStyle = color;
    const last = data[data.length - 1];
    ctx.fillText(abs(last) > 999 ? last.toExponential(1) : sf(last, 2), x + 18, y + h + 8);

    ctx.strokeStyle = color;
    ctx.lineWidth = 1;
    ctx.globalAlpha = 0.8;
    ctx.beginPath();
    for (let i = 0; i < data.length; i++) {
      const v = isFinite(data[i]) ? data[i] : 0;
      const px = x + (i / (data.length - 1)) * w;
      const py = y + h - ((v - mn) / range) * h;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    ctx.globalAlpha = 1;
  }
};

