// ═══════════════════════════════════════════════════════════════════════════════
// §12C  SULBA GEOMETRIC ENGINE
//
// Śulbasūtra: Ancient Indian geometric constructions
// π_sulba = √10 — exact via QTaylor.sqrt(Q.mk(10n)) in ℚ (Baudhāyana)
// Square, circle, Pythagorean triple, geometric mean constructions — all exact rational
// ═══════════════════════════════════════════════════════════════════════════════
const SULBA = {
  // Baudhāyana Śulbasūtra π approximation: √10
  // EXACT via QTaylor Newton's method in ℚ (8 iterations → ~256 bits precision)
  PI_SULBA_exact: null, // set in init()
  PI_SULBA: 0,          // float projection
  // Rational convergent of √10: see Āpastamba 3.162277660168...
  PI_RAT: Q.mk(31623n, 10000n), // 4-digit convergent

  init() {
    this.PI_SULBA_exact = QTaylor.sqrt(Q.mk(10n));
    this.PI_SULBA = Q.fl(this.PI_SULBA_exact);
  },

  // Square construction: side → {area, perimeter, diagonal}
  squareConstruction(side) {
    const s = (typeof side === 'bigint') ? side : BigInt(Math.round(Number(side)));
    return {
      area: s * s,
      perimeter: 4n * s,
      diagonal_sq: 2n * s * s  // d² = 2s² (exact, no √2 needed)
    };
  },

  // Circle construction with exact Sulba π = √10
  circleConstruction(radius) {
    if (typeof radius === 'object' && radius.n !== undefined) {
      // Exact rational path
      const r_sq = Q.mul(radius, radius);
      return {
        circumference: Q.mul(Q.mul(Q.TWO, this.PI_SULBA_exact), radius),
        area: Q.mul(this.PI_SULBA_exact, r_sq),
        circumference_f: Q.fl(Q.mul(Q.mul(Q.TWO, this.PI_SULBA_exact), radius)),
        area_f: Q.fl(Q.mul(this.PI_SULBA_exact, r_sq))
      };
    }
    const r = Number(radius);
    return {
      circumference: 2 * this.PI_SULBA * r,
      area: this.PI_SULBA * r * r
    };
  },

  // Pythagorean triple generator: m²-n², 2mn, m²+n² for m>n>0
  pythagoreanTriples(limit) {
    const triples = [];
    for (let m = 2n; m * m < BigInt(limit); m++) {
      for (let n = 1n; n < m; n++) {
        const a = m * m - n * n, b = 2n * m * n, c = m * m + n * n;
        if (c <= BigInt(limit)) triples.push([a, b, c]);
      }
    }
    return triples;
  },

  // Geometric mean: √(a×b) — EXACT in ℚ via QTaylor.sqrt()
  geometricMean(a, b) {
    if (typeof a === 'object' && a.n !== undefined) {
      // Exact rational path
      return QTaylor.sqrt(Q.mul(a, b));
    }
    // BigInt path
    const aR = Q.mk(typeof a === 'bigint' ? a : BigInt(Math.round(Number(a))));
    const bR = Q.mk(typeof b === 'bigint' ? b : BigInt(Math.round(Number(b))));
    return QTaylor.sqrt(Q.abs(Q.mul(aR, bR)));
  },

  // Altar area computations (falcon/śyena, wheel/rathacakra, tortoise/kūrma)
  // Areas in units of square puruṣa — exact rational fractions
  altarArea(type, unit) {
    const u = (typeof unit === 'object' && unit.n !== undefined) ? unit : Q.mk(BigInt(Math.round(Number(unit))));
    const u_sq = Q.mul(u, u);
    // Traditional altar ratios (exact rational)
    const areas = {
      falcon: Q.mk(15n, 2n),     // 7.5 sq puruṣa
      wheel: Q.mk(707n, 100n),   // 7.07 sq puruṣa (√50)
      tortoise: Q.mk(13n, 2n)    // 6.5 sq puruṣa
    };
    const ratio = areas[type] || areas.falcon;
    return Q.mul(ratio, u_sq);
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §12D  VILOKANAM PATTERN RECOGNITION ENGINE
//
// Detects: perfect squares, difference of squares, Pythagorean triples,
//          arithmetic progressions, geometric progressions
// All operations use BigInt for exact integer detection
// ═══════════════════════════════════════════════════════════════════════════════
const VILOKANAM = {
  // Perfect square test via BigInt Newton isqrt
  isPerfectSquare(n) {
    n = bigAbs(n); if (n < 2n) return true;
    const s = bigISqrt(n);
    return s * s === n;
  },

  // Difference of squares: n = a² - b² = (a+b)(a-b)
  isDiffOfSquares(n) {
    n = bigAbs(n); if (n === 0n) return true;
    // n = a²-b² iff n is not ≡ 2 mod 4
    return n % 4n !== 2n;
  },

  // Pythagorean triple test: is (a,b,c) a valid triple?
  isPythTriple(a, b, c) {
    return a * a + b * b === c * c;
  },

  // Arithmetic progression test
  isArithProg(arr) {
    if (arr.length < 3) return true;
    const d = arr[1] - arr[0];
    for (let i = 2; i < arr.length; i++) {
      if (arr[i] - arr[i - 1] !== d) return false;
    }
    return true;
  },

  // Geometric progression test
  isGeoProg(arr) {
    if (arr.length < 3) return true;
    if (arr[0] === 0) return false;
    const r0num = arr[1], r0den = arr[0]; // ratio = arr[1]/arr[0]
    for (let i = 2; i < arr.length; i++) {
      // Check arr[i]/arr[i-1] = r0num/r0den
      // i.e. arr[i] * r0den === arr[i-1] * r0num
      if (arr[i] * r0den !== arr[i - 1] * r0num) return false;
    }
    return true;
  },

  // Comprehensive pattern recognition on a BigInt value
  recognize(n) {
    n = bigAbs(n);
    const patterns = [];
    if (this.isPerfectSquare(n)) patterns.push('□');
    if (this.isDiffOfSquares(n)) patterns.push('□²-□²');
    if (n > 0n && n % 2n === 0n) patterns.push('2|n');
    if (n > 0n && n % 3n === 0n) patterns.push('3|n');
    if (n > 0n && n % 7n === 0n) patterns.push('7|n');
    return patterns.length > 0 ? patterns.join(',') : '∅';
  }
};

