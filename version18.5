// σ(r) = ∏ₖ₌₁⁴ [λₖ⁴ / (r⁴ + λₖ⁴)] — smooth suppression function ∈ [0,1]
// ═══════════════════════════════════════════════════════════════════════════════
const GRVQ = {
  g: 1.0,       // Laplacian coupling (diffusion on λ-array)
  r: 0.5,       // Ollivier-Ricci curvature coefficient
  v: 0.3,       // Gaussian damping strength
  q: 0.7,       // Oscillation amplitude
  lambda: 0.2,  // Linear scaling (Λ-like)
  alpha: 0.6,   // Sinusoidal forcing amplitude
  beta: 0.4,    // Cubic damping coefficient
  gamma: 0.8,   // Neighbor coupling strength
  delta: 0.1,   // Perturbation amplitude
  epsilon: 0.9, // Sigmoid regularizer scale
  // Exact ℚ scaling factors (replace IEEE-754 * 0.01 literals)
  scale_100: Q.mk(1n, 100n),    // 1/100 — g,r,lam,del,eps terms
  scale_1k:  Q.mk(1n, 1000n),   // 1/1000 — gamma coupling

  // 4D discrete Laplacian on lambda array with PERIODIC boundary conditions
  // Standard stencil: ∇²f_k = f_{k-1} + f_{k+1} - 2f_k
  // For N=4 with periodic BC: indices wrap via modular arithmetic
  laplacian4D(lam, k) {
    const N = lam.length;
    const prev = Q.fl(lam[((k - 1) % N + N) % N]);
    const curr = Q.fl(lam[k]);
    const next = Q.fl(lam[(k + 1) % N]);
    return prev + next - 2 * curr;
  },

  // Discrete Ricci curvature (Ollivier-Ricci on periodic array)
  // Unlike the Laplacian (which is Δf = f'' second derivative),
  // Ollivier-Ricci curvature measures how DISTANCES change under flow.
  // κ(k) = 1 - W₁(μₖ, μ_{k+1}) / d(k, k+1)
  // For a 1D periodic array, this simplifies to a curvature that depends on
  // the ratio of neighbor differences (not their sum).
  // Positive curvature = neighbors converge, negative = diverge.
  // Ollivier-Ricci curvature on 1D periodic lattice — EXACT in ℚ
  // κ(k) = 1 - W₁(μₖ, μ_{k+1}) / d(k, k+1)
  // For 1D periodic array with unit spacing d=1:
  //   W₁ approximated by |dL - dR| / (|dL| + |dR| + 1)
  //   κ = 1 - W₁ → positive when neighbors converge, negative when diverge
  //
  // Sectional curvature: κ = -dL·dR / (1 + curr²)
  //   Negative when gradients same sign (saddle), positive when opposite (bowl)
  ricciTerm(lam, k) {
    const N = lam.length;
    const prev = lam[((k - 1) % N + N) % N];
    const curr = lam[k];
    const next = lam[(k + 1) % N];
    // Exact rational: dL = curr - prev, dR = next - curr
    const dL = Q.sub(curr, prev);
    const dR = Q.sub(next, curr);
    // κ = -dL·dR / (1 + curr²) — exact rational
    const product = Q.mul(dL, dR);
    const denom = Q.add(Q.ONE, Q.mul(curr, curr));
    return Q.fl(Q.neg(Q.div(product, denom)));
  },

  // Gaussian-damped restoring term: f(v) = v·exp(-v²/10)
  // Peaks at v=±√5, decays for large |v|. Models attraction toward moderate values.
  vacuumTerm(lam, k) {
    const v = Q.fl(lam[k]);
    return exp(-v * v * 0.1) * v * this.v;
  },

  // Damped oscillation: f(v,t) = q·exp(-|v|/2)·sin(ωt)
  // Amplitude decays exponentially with field magnitude. Phase varies per index k.
  // Not a WKB tunneling amplitude — just exponential-decay × sinusoidal driving.
  quantumTerm(lam, k, t) {
    const v = Q.fl(lam[k]);
    const tunneling = exp(-abs(v) * 0.5);
    const phase = sin(t * 0.001 * (k + 1));
    return tunneling * phase * this.q;
  },

  // Cubic damping: f(v) = -β·v³·0.001
  // Stabilizes large field values (v³ grows fast, pulls them back).
  // Structurally similar to -bg³ in QCD beta function but without the
  // gauge theory derivation (11N_c - 2N_f)/(48π²). Here it's just cubic drag.
  betaFunction(lam, k) {
    const v = Q.fl(lam[k]);
    return -this.beta * v * v * v * 0.01;
  },

  // Nearest-neighbor product coupling: f(k) = γ·(λ_{k-1}·λ_k + λ_{k+1}·λ_k)·0.0001
  // Standard lattice interaction term. NOT a QFT vertex function Γ.
  gammaCoupling(lam, k) {
    const N = lam.length;
    const vk = Q.fl(lam[k]);
    // Nearest-neighbor coupling (periodic): only adjacent indices
    const prev = Q.fl(lam[((k - 1) % N + N) % N]);
    const next = Q.fl(lam[(k + 1) % N]);
    return (prev * vk + next * vk) * this.gamma * 0.001;
  },

  // Bounded sigmoid: f(v) = ε·v/(v²+1) — maps ℝ → [-ε/2, ε/2]
  // Prevents extreme values from growing further. NOT a UV cutoff
  // (which would be a momentum-space operation). This is a soft clamp.
  regularize(lam, k) {
    const v = Q.fl(lam[k]);
    return this.epsilon * v / (v * v + 1);
  },

  // FULL GRVQ EVOLUTION: all 10 parameters applied to lambda[k]
  // Uses simTime (deterministic) not performance.now() (frame-dependent)
  evolve(lam, k, t) {
    const g_term = this.g * this.laplacian4D(lam, k) * 0.05;
    const r_term = this.r * this.ricciTerm(lam, k) * 0.05;
    const v_term = this.vacuumTerm(lam, k);
    const q_term = this.quantumTerm(lam, k, t);
    const lam_term = this.lambda * Q.fl(lam[k]) * 0.05;
    const alph_term = this.alpha * sin(t * 0.001) * C.alpha_f;
    const beta_term = this.betaFunction(lam, k);
    const gam_term = this.gammaCoupling(lam, k);
    const del_term = this.delta * (sin(t * 0.0037 + k * 1.7) * 0.05);
    const eps_term = this.regularize(lam, k) * 0.05;

    return (g_term + r_term + v_term + q_term - lam_term +
            alph_term + beta_term + gam_term + del_term + eps_term);
    // OUTPUT GATE REMOVED: was ×0.1, killing 90% of already-attenuated signal
