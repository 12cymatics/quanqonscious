// Field computation: Vertex field Ψ[16] projected onto torus surface
// Each vertex has a position on the torus via tessVertexToTorus.
// The torus surface field = IDW interpolation from nearest vertex fields.
function updateField(t) {
  const time = t * 0.001;
  // Maya Illusion Sutra — evolve phase and compute modulation factor
  MAYA.evolvePhase(0.01);
  const mayaMod = MAYA.modulationFactor();

  // Compute current torus positions of all 16 vertices
  const vpos = TESS_V.map(v => tessVertexToTorus(v, t));
  const vpsi = VTX.psi.map(p => Q.fl(p));

  // Temporal rendering stabiliser: SMOOTH controls how fast the DISPLAY
  // grid tracks the exact field values computed by the sutra/GRVQ engine.
  // This is NOT a mathematical approximation — it prevents frame-to-frame
  // visual jitter in the pixel colour lookup. The exact field lives in VTX.psi[].
  // 0.65 = 3-frame convergence to true value (90% within 50ms at 60fps)
  const SMOOTH = 0.65;

  for (let i = 0; i < FIELD_TH; i++) {
    const theta = (i / FIELD_TH) * TAU;
    for (let j = 0; j < FIELD_PH; j++) {
      const phi = (j / FIELD_PH) * TAU;

      // IDW interpolation from 16 vertex fields
      let wSum = 0, vSum = 0;
      for (let v = 0; v < 16; v++) {
        let dth = abs(theta - vpos[v].theta);
        if (dth > PI) dth = TAU - dth;
        let dph = abs(phi - vpos[v].phi);
        if (dph > PI) dph = TAU - dph;
        const dist2 = dth * dth + dph * dph + 0.01; // tightened: sharper vertex field projection
        const w = 1 / dist2; // 1/r² weighting — smoother than 1/r⁴
        wSum += w;
        vSum += w * vpsi[v];
      }
      let val = vSum / wSum;

      // Wheeler φ³ hyperboloid contribution
      val += WHEELER.fieldDistortion(theta, phi, 1.0, t) * 0.03;
      
      // MAGFIELD B contribution: magnetic pressure modulates surface field
      // IDW-weighted B from nearest vertices → visible magnetic topology
      let bSum = 0, bWsum = 0;
      for (let v = 0; v < 16; v++) {
        let dth2 = abs(theta - vpos[v].theta);
        if (dth2 > PI) dth2 = TAU - dth2;
        let dph2 = abs(phi - vpos[v].phi);
        if (dph2 > PI) dph2 = TAU - dph2;
        const bd2 = dth2 * dth2 + dph2 * dph2 + 0.01;
        const bw = 1 / bd2;
        bWsum += bw;
        bSum += bw * MAGFIELD.B[v];
      }
      const bLocal = bSum / bWsum;
      // B-field adds signed perturbation: positive B → warm ridge, negative → cool trough
      val += bLocal * 0.3 * AMP.bfield;
      
      // Maya modulation
      val *= mayaMod;

      // Temporal rendering stabiliser: SMOOTH blends new exact value with display state
      const idx = i * FIELD_PH + j;
      fieldGrid[idx] = fieldGrid[idx] * (1 - SMOOTH) + val * SMOOTH;
    }
  }

  // TGCR vortex advection
  advectField();
}

function sampleField(theta, phi) {
  const ti = ((theta % TAU + TAU) % TAU) / TAU * FIELD_TH;
  const pi = ((phi % TAU + TAU) % TAU) / TAU * FIELD_PH;
  const i0 = floor(ti) % FIELD_TH, i1 = (i0 + 1) % FIELD_TH;
  const j0 = floor(pi) % FIELD_PH, j1 = (j0 + 1) % FIELD_PH;
  const ft = ti - floor(ti), fp = pi - floor(pi);
  return (fieldGrid[i0 * FIELD_PH + j0] * (1 - ft) * (1 - fp) +
          fieldGrid[i1 * FIELD_PH + j0] * ft * (1 - fp) +
          fieldGrid[i0 * FIELD_PH + j1] * (1 - ft) * fp +
          fieldGrid[i1 * FIELD_PH + j1] * ft * fp);
}

function fieldEnergy() {
  let e = 0;
  for (let k = 0; k < fieldGrid.length; k++) e += fieldGrid[k] * fieldGrid[k];
  return sqrt(e / fieldGrid.length);
}


// ═══════════════════════════════════════════════════════════════════════════════
// §12A  VEDIC DIGIT-LEVEL HELPERS — BigInt exact arithmetic
//
// These implement the fundamental digit-extraction and recombination
// operations that Bharati Krishna Tirthaji's sutra system operates on.
// All functions: BigInt → BigInt (zero IEEE-754 contamination)
// ═══════════════════════════════════════════════════════════════════════════════

// Exact integer square root (Newton's method, BigInt)
function bigISqrt(n) {
  if (n < 0n) return 0n; if (n < 2n) return n;
  let x = n, y = (x + 1n) / 2n;
  while (y < x) { x = y; y = (x + n / x) / 2n; }
  return x;
}
// BigInt abs
function bigAbs(n) { return n < 0n ? -n : n; }
// Duplex (Dvandva-yoga): D(n) for squaring sutra
// For digits [d₁,d₂,...,dₖ]: D = d₁×dₖ + d₂×d_{k-1} + ... (pairs from outside in)
// + middle² if odd count
function duplex(digits) {
  const k = digits.length;
  let d = 0n;
  for (let i = 0; i < Math.floor(k / 2); i++) d += digits[i] * digits[k - 1 - i] * 2n;
  if (k % 2 === 1) d += digits[Math.floor(k / 2)] ** 2n;
  return d;
}

