  // ═══════════════════════════════════════════════════════════════════════════
  // S11: Vyaṣṭisamaṣṭiḥ — "Part and Whole"
  // TYPE: CONVOLUTIVE
  // Hamming weight layers are parts; total field is whole.
  // Convolution: each vertex gets weighted average of its layer and total.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:11, name:'Vyaṣṭisamaṣṭiḥ', sk:'व्यष्टि', m:2, n:1, amp:0.35, freq:0.9, strength:0,
    desc:'CONVOLUTIVE: part-whole by Hamming weight layers',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(11);
      // Compute layer sums by Hamming weight
      const layerSum = [Q.ZERO, Q.ZERO, Q.ZERO, Q.ZERO, Q.ZERO];
      const layerCnt = [0, 0, 0, 0, 0];
      for (let i = 0; i < 16; i++) {
        const h = VTX.hw(i);
        layerSum[h] = Q.add(layerSum[h], VTX.psi[i]);
        layerCnt[h]++;
      }
      const whole = VTX.mean();
      // Each vertex: blend layer mean with whole mean
      for (let i = 0; i < 16; i++) {
        const h = VTX.hw(i);
        const partMean = Q.div(layerSum[h], Q.mk(BigInt(layerCnt[h])));
        // Target: (part + whole)/2 — balanced part-whole relation
        const target = Q.div(Q.add(partMean, whole), Q.mk(2n));
        const diff = Q.sub(target, VTX.psi[i]);
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(11, 26);
      return `S11: CONV layers=[${layerSum.map(s=>sf(Q.fl(s),1)).join(',')}] α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S12: Veṣṭanaṃ — "Osculation / Casting out nines"
  // TYPE: REFLECTIVE
  // Digital root: Ψ → dr(Ψ) = 1 + ((|Ψ|-1) mod 9). Reflect toward digital root.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:12, name:'Veṣṭanaṃ', sk:'वेष्टनम्', m:3, n:0, amp:0.3, freq:0.75, strength:0,
    desc:'REFLECTIVE: reflect vertex fields toward their digital root mod 9',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(12);
      for (let i = 0; i < 16; i++) {
        const v = abs(floor(Q.fl(VTX.psi[i])));
        const dr = v === 0 ? 0 : 1 + ((v - 1) % 9); // digital root
        const sign = Q.fl(VTX.psi[i]) >= 0 ? 1 : -1;
        const target = Q.mk(Bi(sign * dr * 1000), 1000n);
        const diff = Q.sub(target, VTX.psi[i]);
        // REFLECTIVE: Ψ' = Ψ + α·(dr - Ψ) → Ψ when α→0
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(12, 14);
      return `S12: REFL digital root α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S13: Sopāntyadvayamantyam — "Penultimate and Ultimate"
  // TYPE: DIVISIVE
  // Continued fraction convergents from vertex pair ratios.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:13, name:'Sopāntyadvayamantyam', sk:'सोपान्त्य', m:1, n:3, amp:0.35, freq:0.85, strength:0,
    desc:'DIVISIVE: continued fraction convergents on vertex pair ratios',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(13);
      // Continued fraction on EACH complementary pair (i, comp(i))
      // Each pair's ratio drives toward its CF convergent
      for (let pi = 0; pi < 8; pi++) {
        const pj = VTX.comp(pi);
        const num = bigAbs(VTX.psi[pi].n) || 1n;
        const den = bigAbs(VTX.psi[pj].n) || 1n;
        // Compute CF: [a₀; a₁, a₂, ...]
        let n = num, d = den;
        const cf = [];
        for (let step = 0; step < 8 && d > 0n; step++) {
          cf.push(n / d);
          const r = n % d; n = d; d = r;
        }
        // Compute convergent p/q from CF
        let p0 = 1n, p1 = cf[0] || 0n, q0 = 0n, q1 = 1n;
        for (let k = 1; k < cf.length; k++) {
          const a = cf[k];
          const p2 = a * p1 + p0, q2 = a * q1 + q0;
          p0 = p1; p1 = p2; q0 = q1; q1 = q2;
        }
        // Drive BOTH vertices toward convergent ratio p/q
        if (q1 !== 0n) {
          const convTarget = Q.mk(p1, q1);
          const actual = VTX.psi[pj].n !== 0n ? Q.div(VTX.psi[pi], VTX.psi[pj]) : Q.ONE;
          const diff = Q.sub(convTarget, actual);
          VTX.psi[pi] = Q.add(VTX.psi[pi], Q.mul(diff, Q.mk(Bi(α * 5000), 10000n)));
          VTX.psi[pj] = Q.sub(VTX.psi[pj], Q.mul(diff, Q.mk(Bi(α * 2500), 10000n)));
        }
      }
      INTER_SUTRA.recordInteraction(13, 4);
      return `S13: DIV CF convergent on 8 pairs α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S14: Ekanyūnena Pūrveṇa — "By one less than the previous"
  // TYPE: MULTIPLICATIVE
  // Ψ'ᵢ = Ψᵢ · (1 - α/|Ψ_{nb}|) — "one less" as multiplicative decrement
  // ═══════════════════════════════════════════════════════════════════════════
  { id:14, name:'Ekanyūnena Pūrveṇa', sk:'एकन्यूनेन', m:0, n:0, amp:0.3, freq:0.95, strength:0,
    desc:'MULTIPLICATIVE: Ψ\'ᵢ = Ψᵢ·(1 - α/|Ψ_{nb}|) — one less decrement',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(14);
      // GRVQ FEEDBACK: S14 drives lambda[3] — completing the 4-vector coverage
      const grvq3 = GRVQ.evolve(lambda, 3, simTime);
      if (abs(grvq3) > 1e-8 && abs(grvq3) < 5.0) {
        lambda[3] = Q.add(lambda[3], Q.mk(Bi(grvq3 * 10000), 10000n));
      }
      for (let i = 0; i < 16; i++) {
        const nb = VTX.psi[i ^ 8]; // neighbor along axis 3 (complementary to S1's axis 0)
        const nbMag = abs(Q.fl(nb)) + 1; // prevent division by zero
        const factor = -1.0 / nbMag; // "one less"
        VTX.psi[i] = Q.mul(VTX.psi[i], Q.add(Q.ONE, Q.mk(Bi(α * factor * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(14, 1);
      return `S14: MULT one-less α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S15: Guṇitasamuccayaḥ — "Product of sum = sum of products"
  // TYPE: MULTIPLICATIVE
  // Vertex pairs along each axis: Ψ₊·Ψ₋ should equal sum-of-pair-products.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:15, name:'Guṇitasamuccayaḥ', sk:'गुणित', m:2, n:2, amp:0.4, freq:1.1, strength:0,
    desc:'MULTIPLICATIVE: enforce (Σ)(Σ) = ΣΠ on vertex edge pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(15);
      // For each axis: compute Σ₊·Σ₋ vs Σ(Ψ₊·Ψ₋)
      for (let axis = 0; axis < 4; axis++) {
        const mask = 1 << axis;
        let sumPlus = Q.ZERO, sumMinus = Q.ZERO, sumProd = Q.ZERO;
        for (let base = 0; base < 16; base++) {
          if (base & mask) continue;
          sumMinus = Q.add(sumMinus, VTX.psi[base]);
          sumPlus = Q.add(sumPlus, VTX.psi[base | mask]);
          sumProd = Q.add(sumProd, Q.mul(VTX.psi[base], VTX.psi[base | mask]));
        }
        const prodSum = Q.mul(sumPlus, sumMinus);
        // Residual: (Σ₊)(Σ₋) - Σ(Ψ₊Ψ₋)
        const residual = Q.fl(Q.sub(prodSum, sumProd));
        if (isFinite(residual) && abs(residual) > 1e-6) {
          const corr = -residual;
          for (let base = 0; base < 16; base++) {
            if (base & mask) continue;
            // MULTIPLICATIVE: scale BOTH vertex products to enforce identity
            VTX.psi[base | mask] = Q.mul(VTX.psi[base | mask],
              Q.add(Q.ONE, Q.mk(Bi(α * corr * 10000), 10000n)));
            VTX.psi[base] = Q.mul(VTX.psi[base],
              Q.add(Q.ONE, Q.mk(Bi(-α * corr * 5000), 10000n)));
          }
        }
      }
      INTER_SUTRA.recordInteraction(15, 3);
      return `S15: MULT Π-Σ identity α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S16: Guṇakasamuccayaḥ — "Factor of sum = sum of factors"
  // TYPE: DIVISIVE
  // Extended GCD on vertex magnitude pairs → Bézout combination.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:16, name:'Guṇakasamuccayaḥ', sk:'गुणक', m:3, n:3, amp:0.35, freq:0.8, strength:0,
    desc:'DIVISIVE: Extended GCD Bézout coefficients on vertex pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(16);
      // Extended GCD Bézout on ALL 8 complementary pairs
      for (let pi = 0; pi < 8; pi++) {
        const pj = VTX.comp(pi);
        const a = bigAbs(VTX.psi[pi].n) || 1n, b = bigAbs(VTX.psi[pj].n) || 1n;
        let r0 = a, r1 = b, s0 = 1n, s1 = 0n, t0 = 0n, t1 = 1n;
        while (r1 > 0n) {
          const q = r0 / r1;
          [r0, r1] = [r1, r0 - q * r1];
          [s0, s1] = [s1, s0 - q * s1];
          [t0, t1] = [t1, t0 - q * t1];
        }
        const g = r0; // gcd
        if (g > 1n) {
          // Divisive: drive both vertices toward GCD-reduced form
          const reducedI = Q.div(VTX.psi[pi], Q.mk(g));
          const reducedJ = Q.div(VTX.psi[pj], Q.mk(g));
          const diffI = Q.sub(reducedI, VTX.psi[pi]);
          const diffJ = Q.sub(reducedJ, VTX.psi[pj]);
          VTX.psi[pi] = Q.add(VTX.psi[pi], Q.mul(diffI, Q.mk(Bi(α * 10000), 10000n)));
          VTX.psi[pj] = Q.add(VTX.psi[pj], Q.mul(diffJ, Q.mk(Bi(α * 10000), 10000n)));
        } else {
          // Coprime: Bézout sa + tb = 1 → use (s,t) to redistribute
          // The Bézout coefficients encode the factoring structure
          // Correction: Ψᵢ += α·t·Ψⱼ/N, Ψⱼ += α·s·Ψᵢ/N (cross-Bézout coupling)
          const sF = Number(s0); // bounded Bézout coefficient
          const tF = Number(t0);
          const vi = Q.fl(VTX.psi[pi]), vj = Q.fl(VTX.psi[pj]);
          // Cross-coupling: each vertex gets fractional contribution from its pair
          const corrI = α * tF * vj;
          const corrJ = α * sF * vi;
          if (isFinite(corrI)) {
            VTX.psi[pi] = Q.add(VTX.psi[pi], Q.mk(Bi(corrI * 10000), 10000n));
          }
          if (isFinite(corrJ)) {
            VTX.psi[pj] = Q.add(VTX.psi[pj], Q.mk(Bi(corrJ * 10000), 10000n));
          }
        }
      }
      INTER_SUTRA.recordInteraction(16, 24);
      return `S16: DIV GCD-Bézout on 8 pairs α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S17: Ānurūpyeṇa — "Proportionately"
  // TYPE: DIFFUSIVE
  // φ-weighted gradient flow along tesseract edges.
  // Each edge carries flow proportional to φ^(Hamming distance).
  // ═══════════════════════════════════════════════════════════════════════════
  { id:17, name:'Ānurūpyeṇa', sk:'आनुरूप्येण', m:1, n:1, amp:0.3, freq:0.9, strength:0,
    desc:'DIFFUSIVE: φ-weighted gradient flow along tesseract edges',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(17);
      // Catalogue: On every edge (i,j), compute gradient Ψ_j-Ψ_i, sum over 4 edges at i.
      // Scale by φ/4. Update Ψ_i = Ψ_i + α·Σ(Ψ_j-Ψ_i)/4.
      // φ-weighted anisotropic diffusion — exact ℚ
      for (let i = 0; i < 16; i++) {
        let gradSum = Q.ZERO;
        for (const j of VTX.neighbors(i)) {
          gradSum = Q.add(gradSum, Q.sub(VTX.psi[j], VTX.psi[i]));
        }
        // Scale by φ/4: exact via C.phi rational constant
        const phiScaled = Q.div(Q.mul(gradSum, C.phi), Q.mk(4n));
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(phiScaled, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(17, 6);
      return `S17: DIFF φ-weighted gradient α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S18: Śiṣyate Śeṣasaṃjñaḥ — "The remainder stays"
  // TYPE: MODULAR
  // CRT: vertices grouped by Hamming weight class mod (5,7).
  // ═══════════════════════════════════════════════════════════════════════════
  { id:18, name:'Śiṣyate Śeṣasaṃjñaḥ', sk:'शिष्यते', m:0, n:1, amp:0.25, freq:0.85, strength:0,
    desc:'MODULAR: CRT on Hamming-weight classes mod (5,7)',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(18);
      // Group vertices by hw mod 5 and hw mod 7
      for (let i = 0; i < 16; i++) {
        const hw = VTX.hw(i);
        const r5 = hw % 5, r7 = hw % 7;
        const v = abs(floor(Q.fl(VTX.psi[i])));
        const vr5 = v % 5, vr7 = v % 7;
        // CRT target: vertex value should have residue matching its Hamming class
        if (vr5 !== r5 || vr7 !== r7) {
          // Find smallest adjustment to fix both residues
          const target5 = (r5 - vr5 + 5) % 5;
          const adj = Q.mk(BigInt(target5), 1n);
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(adj, Q.mk(Bi(α * 10000), 10000n)));
        }
      }
      INTER_SUTRA.recordInteraction(18, 20);
      return `S18: MOD CRT(5,7) α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S19: Kevalaih Saptakam Guṇyāt — "Multiply by 7 only"
  // TYPE: DIVISIVE
  // Vieta's formulas: vertex pairs as roots of quadratic.
  // Sum of roots = -b/a, product = c/a.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:19, name:'Kevalaih Saptakam Guṇyāt', sk:'केवलैः', m:2, n:0, amp:0.3, freq:0.8, strength:0,
    desc:'DIVISIVE: Vieta relations on complementary vertex root pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(19);
      // For each complementary pair (i, comp(i)):
      // Treat as roots r₁=Ψᵢ, r₂=Ψ_c of x²-Sx+P=0
      // Vieta: S=r₁+r₂, P=r₁·r₂
      // Enforce: |r₂/r₁| → φ (golden root spacing)
      for (let i = 0; i < 8; i++) {
        const j = VTX.comp(i);
        const vi = Q.fl(VTX.psi[i]), vj = Q.fl(VTX.psi[j]);
        const sum = Q.add(VTX.psi[i], VTX.psi[j]);
        const prod = Q.mul(VTX.psi[i], VTX.psi[j]);
        const disc = Q.sub(Q.mul(sum, sum), Q.mul(Q.mk(4n), prod));
        const discF = Q.fl(disc);
        if (discF < 0) {
          // Negative disc → drive both vertices toward real-root boundary
          const corr = Q.mul(disc, Q.mk(Bi(-α * 5000), 10000n));
          VTX.psi[i] = Q.add(VTX.psi[i], corr);
          VTX.psi[j] = Q.sub(VTX.psi[j], corr);
        } else {
          // Positive disc → enforce φ-ratio between |roots|
          // For antisymmetric pairs (sum≈0): use magnitude ratio directly
          const ai = abs(vi), aj = abs(vj);
          const ratio = ai > aj ? ai / aj : aj / ai;
          const err = ratio - C.phi_f; // target: |r₂/r₁| = φ
          if (ai > 0 && aj > 0) {
            const scale = α * err * 0.1;
            // Larger root shrinks, smaller root grows
            if (ai > aj) {
              VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(-scale * 10000), 10000n));
              VTX.psi[j] = Q.add(VTX.psi[j], Q.mk(Bi(scale * 10000), 10000n));
            } else {
              VTX.psi[j] = Q.add(VTX.psi[j], Q.mk(Bi(-scale * 10000), 10000n));
              VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(scale * 10000), 10000n));
            }
          }
        }
      }
      INTER_SUTRA.recordInteraction(19, 13);
      return `S19: DIV Vieta φ-ratio α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S20: Vilokanam — "By mere observation"
  // TYPE: MODULAR
  // Base-7 residue correction: drive vertex values toward divisibility by 7.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:20, name:'Vilokanam', sk:'विलोकनम्', m:3, n:2, amp:0.25, freq:0.75, strength:0,
    desc:'MODULAR: base-7 residue correction on vertex magnitudes',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(20);
      for (let i = 0; i < 16; i++) {
        const v = abs(floor(Q.fl(VTX.psi[i])));
        const r7 = v % 7;
        if (r7 !== 0) {
          const adj = r7 <= 3 ? -r7 : (7 - r7); // nearest multiple of 7
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(α * adj * 10000), 10000n));
        }
      }
      INTER_SUTRA.recordInteraction(20, 18);
      return `S20: MOD base-7 α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S21: Guṇitasamuccayah Samuccayaguṇitaḥ — "Osculation"
  // TYPE: MODULAR
  // Oscillatory modular composition: vertex values at Hamming-adjacent pairs
  // should satisfy divisibility by 7 after osculation.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:21, name:'Guṇitasamuccayah Samuccayaguṇitaḥ', sk:'गुणितसमुच्चयः', m:1, n:3, amp:0.3, freq:0.8, strength:0,
    desc:'MODULAR: oscillatory divisibility by 7 on edge pairs',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(21);
      const osculator = 5; // for divisibility by 7: osculator = (7+1)/2 rounded
      for (let i = 0; i < 16; i++) {
        const v = abs(floor(Q.fl(VTX.psi[i])));
        // Osculation: split last digit, multiply by osculator, add to remaining
        const lastDigit = v % 10;
        const remaining = floor(v / 10);
        const osculated = remaining + lastDigit * osculator;
        const target = osculated % 7 === 0 ? v : v + (7 - osculated % 7);
        const diff = target - v;
        if (diff !== 0) {
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(α * diff * 10000), 10000n));
        }
      }
      INTER_SUTRA.recordInteraction(21, 20);
      return `S21: MOD osculation α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S22: Dvandvayogaḥ — "Duplex / Double"
  // TYPE: REFLECTIVE
  // Double complement: reflect each vertex toward mean of it + its complement.
  // Ψ'ᵢ = (1-α)·Ψᵢ + α·(Ψᵢ+Ψ_c)/2 — balance with complement
  // ═══════════════════════════════════════════════════════════════════════════
  { id:22, name:'Dvandvayogaḥ', sk:'द्वन्द्वयोगः', m:0, n:2, amp:0.35, freq:0.9, strength:0,
    desc:'REFLECTIVE: balance vertex with its complement (Ψᵢ+Ψ_c)/2',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(22);
      for (let i = 0; i < 16; i++) {
        const c = VTX.comp(i);
        const balanced = Q.div(Q.add(VTX.psi[i], VTX.psi[c]), Q.mk(2n));
        const diff = Q.sub(balanced, VTX.psi[i]);
        // REFLECTIVE: → identity when α→0
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(22, 2);
      return `S22: REFL duplex balance α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S23: Antyayordaśake'pi — "Terminal digit coherence"
  // TYPE: REFLECTIVE
  // Terminal digits of complementary vertex pairs should sum to 10.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:23, name:"Antyayordaśake'pi", sk:'अन्त्ययोः', m:1, n:0, amp:0.25, freq:0.85, strength:0,
    desc:'REFLECTIVE: terminal digits of vertex complement pairs sum to 10',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(23);
      for (let i = 0; i < 8; i++) {
        const j = VTX.comp(i);
        const di = abs(floor(Q.fl(VTX.psi[i]))) % 10;
        const dj = abs(floor(Q.fl(VTX.psi[j]))) % 10;
        const sum = di + dj;
        if (sum !== 10 && sum !== 0) {
          const adj = (10 - sum) / 2;
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(α * adj * 10000), 10000n));
          VTX.psi[j] = Q.add(VTX.psi[j], Q.mk(Bi(α * adj * 10000), 10000n));
        }
      }
      INTER_SUTRA.recordInteraction(23, 12);
      return `S23: REFL terminal-10 α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S24: Lopanasthāpanābhyām — "By elimination and retention"
  // TYPE: MODULAR
  // GCD of vertex field tails (last N digits) — common factors eliminated.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:24, name:'Lopanasthāpanābhyām', sk:'लोपन', m:2, n:3, amp:0.25, freq:0.8, strength:0,
    desc:'MODULAR: GCD of vertex tails for factor elimination',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(24);
      // Extract last 2 digits from each vertex magnitude
      const tails = [];
      for (let i = 0; i < 16; i++) tails.push(BigInt(abs(floor(Q.fl(VTX.psi[i]))) % 100));
      // Find GCD of all tails
      let g = tails[0] || 1n;
      for (let i = 1; i < 16; i++) {
        let a = g, b = tails[i] || 1n;
        while (b > 0n) { [a, b] = [b, a % b]; }
        g = a;
      }
      // If common tail factor > 1: divide it out (elimination)
      if (g > 1n) {
        for (let i = 0; i < 16; i++) {
          const tailV = tails[i];
          const reduced = tailV / g;
          const correction = Number(reduced - tailV);
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(α * correction * 10000), 10000n));
        }
      } else {
        // g=1 (coprime): compute digital root of each 2-digit tail
        // Drive fractional part toward digital root — no fallback/noise
        for (let i = 0; i < 16; i++) {
          let dr = Number(tails[i]);
          while (dr > 9) { let s = 0; while (dr > 0) { s += dr % 10; dr = floor(dr / 10); } dr = s; }
          const v = Q.fl(VTX.psi[i]);
          if (abs(v) > 0.01) {
            const fractPart = v - floor(v);
            const target = dr / 9; // normalize digital root to [0,1)
            const err = fractPart - target;
            VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(-α * err * 10000), 10000n));
          }
        }
      }
      INTER_SUTRA.recordInteraction(24, 16);
      return `S24: MOD tail gcd=${g} α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S25: Samuccayaguṇitaḥ — "Sum of products = product of sums"
  // TYPE: CONVOLUTIVE
  // Newton's identity: Σ Ψᵢ·Ψⱼ should relate to (Σ Ψᵢ)².
  // Drive ratio toward the algebraic identity.
  // ═══════════════════════════════════════════════════════════════════════════
