// ═══════════════════════════════════════════════════════════════════════════════
// vedic_v18.5 — THREE-LAYER ARCHITECTURE
//
// Layer 1: core_exact    — Authoritative exact state and evolution
// Layer 2: projection_ui — Read-only float projections for display
// Layer 3: sandbox_approx — Optional approximate preview helpers
//
// Policy A: exact→float is one-way (display only)
// Policy B: undefined operations throw (no silent fallback)
// Policy C: browser survival is not a canonical invariant
// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════
// VEDIC VERTEX SUBSTRATE v17 — TESSERACT FIELD ENGINE
//
// CORE MATH (proven correct):
//   VTX:     Hadamard transform Ψ[16] ↔ λ[4] on Z₂⁴ tesseract graph
//   SUTRAS:  29 discrete operators with identity-preservation guarantee
//   Q:       Exact rational arithmetic (BigInt numerator/denominator)
//   S9:      Graph Laplacian (textbook discrete heat equation)
//   S3:      Walsh-Hadamard XOR-convolution (N=16 normalization)
//
// PARAMETRIC FRAMEWORKS (structured numerics, not physics solvers):
//   GRVQ:    10-parameter λ-driver (Laplacian, Ollivier-Ricci, cubic damping, etc.)
//   ENGINE:  Exact 8×8 Hamiltonian on Z₂³, K=Q(√2,i), ζ=e^{iπ/4}, matrix exponential
//   TGCR:    Beltrami flow framework (energy functional correct, prescribed not solved)
//   MSTVQ:   Maxwell stress tensor algebra (simulation-scale μ=1, prescribed B)
//   WHEELER: φ-scaled parametric torus distortion functions
//   MAGFIELD: Discrete Exterior Calculus (1-forms on edges, 2-forms on faces via Stokes)
//
// MAYA:    Vigesimal base-20, Tzolkin(260), Haab(365), CalendarRound(18980)
// ANSATZ:  |ψ(θ)⟩ = U(θ)|0⟩, E(θ) = Σ αᵢ⟨Pᵢ⟩, Grover amplitude O(√N)
// ═══════════════════════════════════════════════════════════════════════════════

const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');
let W, H;
function resize() {
  const r = canvas.parentElement.getBoundingClientRect();
  W = canvas.width = r.width * devicePixelRatio;
  H = canvas.height = r.height * devicePixelRatio;
  ctx.setTransform(devicePixelRatio, 0, 0, devicePixelRatio, 0, 0);
}
resize();
addEventListener('resize', resize);

const TAU = Math.PI * 2, PI = Math.PI;
const sin = Math.sin, cos = Math.cos, sqrt = Math.sqrt, abs = Math.abs;
const floor = Math.floor, min = Math.min, max = Math.max, exp = Math.exp;
const atan2 = Math.atan2;
const clamp = (v, lo, hi) => v < lo ? lo : v > hi ? hi : v;
const cosh = x => (exp(x) + exp(-x)) / 2;
const sinh = x => (exp(x) - exp(-x)) / 2;

// ═══════════════════════════════════════════════════════════════════════════════
// §1 EXACT RATIONAL ARITHMETIC — BigInt, zero IEEE-754 in core
// ═══════════════════════════════════════════════════════════════════════════════
const gcd = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a || 1n; };
// MAXD removed — canonical Q.mk has no compression
// MAXN removed — canonical Q.mk has no compression
const safeBi = v => { try { const x = Number(v); if (!isFinite(x)) return 0n; return BigInt(Math.round(x)); } catch { return 0n; } };
const Q = {
  mk(n, d = 1n) {
    if (typeof n !== 'bigint') n = safeBi(n);
    if (typeof d !== 'bigint') d = safeBi(d) || 1n;
    if (d === 0n) return { n: 0n, d: 1n };
    const g = gcd(n < 0n ? -n : n, d < 0n ? -d : d);
    const s = d < 0n ? -1n : 1n;
    let nn = s * n / g, dd = s * d / g;
    return { n: nn, d: dd };
  },
  add: (a, b) => Q.mk(a.n * b.d + b.n * a.d, a.d * b.d),
  sub: (a, b) => Q.mk(a.n * b.d - b.n * a.d, a.d * b.d),
  mul: (a, b) => Q.mk(a.n * b.n, a.d * b.d),
  // Division: returns {n:0n, d:0n} on divide-by-zero (NaN rational) — propagates explicitly
  div: (a, b) => b.n === 0n ? { n: 0n, d: 0n } : Q.mk(a.n * b.d, a.d * b.n),
  // NaN check: d===0n signals undefined (0/0) — use before any downstream computation
  isNaN: r => r.d === 0n,
  // Safe division: returns fallback on divide-by-zero instead of NaN rational
  safeDiv: (a, b, fallback) => b.n === 0n ? (fallback || Q.ZERO) : Q.mk(a.n * b.d, a.d * b.n),
  fl: r => {
    if (r.d === 0n) return 0;
    // Handle BigInts that exceed Number.MAX_SAFE_INTEGER (2^53)
    // by scaling both num and denom down to safe range
    const an = r.n < 0n ? -r.n : r.n;
    const ad = r.d;
    if (an < 9007199254740992n && ad < 9007199254740992n) {
      // Both fit in Float64 — direct conversion
      const v = Number(r.n) / Number(r.d);
      return (v !== v || v === Infinity || v === -Infinity) ? 0 : v;
    }
    // Scale down: find shift so both fit in ~50 bits
    const nBits = an.toString(2).length;
    const dBits = ad.toString(2).length;
    const maxBits = nBits > dBits ? nBits : dBits;
    const shift = maxBits > 50 ? BigInt(maxBits - 50) : 0n;
    const ns = Number(r.n >> shift);
    const ds = Number(r.d >> shift);
    if (ds === 0) return r.n > 0n ? Infinity : -Infinity;
    const v = ns / ds;
    return (v !== v || v === Infinity || v === -Infinity) ? 0 : v;
  },
  str: r => r.d === 0n ? 'NaN' : r.d === 1n ? String(r.n) : `${r.n}/${r.d}`,
  abs: r => Q.mk(r.n < 0n ? -r.n : r.n, r.d),
  neg: r => Q.mk(-r.n, r.d),
  gt: (a, b) => a.n * b.d > b.n * a.d,
  lt: (a, b) => a.n * b.d < b.n * a.d,
  eq: (a, b) => a.n * b.d === b.n * a.d,
  pow: (r, e) => { let res = Q.ONE; for (let i = 0; i < e; i++) res = Q.mul(res, r); return res; },
  ZERO: { n: 0n, d: 1n }, ONE: { n: 1n, d: 1n }, TWO: { n: 2n, d: 1n }, HALF: { n: 1n, d: 2n },
  _compressionCount: 0,
  // flStrict: returns NaN on d===0n (for audit/logging — NOT for runtime math)
  flStrict: r => { if (r.d === 0n) return NaN; const v = Number(r.n) / Number(r.d); return isFinite(v) ? v : NaN; },
};
const Bi = v => { try { const x = Number(v); if (!isFinite(x)) return 0n; return BigInt(Math.round(x)); } catch { return 0n; } };
const isqrt = n => { n = n < 0n ? -n : n; if (n < 2n) return n; let x = n, y = (x + 1n) / 2n; while (y < x) { x = y; y = (x + n / x) / 2n; } return x; };
const digitSum = n => { n = n < 0n ? -n : n; let s = 0n; while (n > 0n) { s += n % 10n; n /= 10n; } return s; };
// Safe .toFixed — returns "0.0000" on NaN/Infinity instead of throwing TypeError
const sf = (v, d = 4) => { const x = Number(v); return (x !== x || !isFinite(x)) ? (0).toFixed(d) : x.toFixed(d); };

// ═══════════════════════════════════════════════════════════════════════════════
// §1a ALGEBRAIC FIELD EXTENSIONS — K = ℚ(√2, i) for ENGINE8K
// Rat = strict rational (delegates to Q), Quad = ℚ(√2), CQuad = ℚ(√2,i)
// PROJECTION BOUNDARY: all float conversions explicitly marked
// ═══════════════════════════════════════════════════════════════════════════════

// ── Rat: strict rational alias with explicit projection ──
const Rat = {
  mk: (n, d=1n) => Q.mk(n, d),
  add: Q.add, sub: Q.sub, mul: Q.mul, div: Q.div,
  neg: Q.neg, abs: Q.abs,
  eq: Q.eq, lt: Q.lt, gt: Q.gt,
  isNaN: Q.isNaN,
  ZERO: Q.ZERO, ONE: Q.ONE, TWO: Q.TWO, HALF: Q.HALF,
  toString: Q.str,
  // PROJECTION BOUNDARY — marked float conversion for UI/control only
  toFloat: Q.fl,
  fromFloatRounded(x, scale=1000000n) {
    if (!isFinite(x)) return Q.ZERO;
    return Q.mk(Bi(x * Number(scale)), scale);
  }
};

// ── Quad: ℚ(√2) = a + b√2, a,b ∈ ℚ ──
const Quad = (() => {
  const mk = (a, b) => ({ a, b });
  const ZERO = mk(Q.ZERO, Q.ZERO);
  const ONE  = mk(Q.ONE, Q.ZERO);
  const SQRT2 = mk(Q.ZERO, Q.ONE); // 0 + 1·√2
  const isNaN = q => Q.isNaN(q.a) || Q.isNaN(q.b);
  const add = (x, y) => mk(Q.add(x.a, y.a), Q.add(x.b, y.b));
  const sub = (x, y) => mk(Q.sub(x.a, y.a), Q.sub(x.b, y.b));
  const neg = x => mk(Q.neg(x.a), Q.neg(x.b));
  // (a+b√2)(c+d√2) = (ac+2bd) + (ad+bc)√2
  const mul = (x, y) => {
    const ac = Q.mul(x.a, y.a), bd = Q.mul(x.b, y.b);
    return mk(Q.add(ac, Q.mul(Q.TWO, bd)), Q.add(Q.mul(x.a, y.b), Q.mul(x.b, y.a)));
  };
  // inv: 1/(a+b√2) = (a-b√2)/(a²-2b²)
  const inv = x => {
    const den = Q.sub(Q.mul(x.a, x.a), Q.mul(Q.TWO, Q.mul(x.b, x.b)));
    if (Q.isNaN(den) || den.n === 0n) return mk(Q.mk(0n,0n), Q.mk(0n,0n));
    return mk(Q.div(x.a, den), Q.div(Q.neg(x.b), den));
  };
  const div = (x, y) => mul(x, inv(y));
  const toFloat = x => isNaN(x) ? NaN : Q.fl(x.a) + Q.fl(x.b) * Math.SQRT2;
  return { mk, ZERO, ONE, SQRT2, isNaN, add, sub, neg, mul, inv, div, toFloat };
})();

// ── CQuad: ℚ(√2,i) = (a+b√2) + i(c+d√2) ──
const CQuad = (() => {
  const mk = (re, im) => ({ re, im });
  const ZERO = mk(Quad.ZERO, Quad.ZERO);
  const ONE  = mk(Quad.ONE, Quad.ZERO);
  const I    = mk(Quad.ZERO, Quad.ONE);
  const isNaN = z => Quad.isNaN(z.re) || Quad.isNaN(z.im);
  const add = (x, y) => mk(Quad.add(x.re, y.re), Quad.add(x.im, y.im));
  const sub = (x, y) => mk(Quad.sub(x.re, y.re), Quad.sub(x.im, y.im));
  const neg = x => mk(Quad.neg(x.re), Quad.neg(x.im));
  // (a+ib)(c+id) = (ac-bd) + i(ad+bc)
  const mul = (x, y) => mk(
    Quad.sub(Quad.mul(x.re, y.re), Quad.mul(x.im, y.im)),
    Quad.add(Quad.mul(x.re, y.im), Quad.mul(x.im, y.re))
  );
  const conj = x => mk(x.re, Quad.neg(x.im));
  const abs2 = x => Quad.add(Quad.mul(x.re, x.re), Quad.mul(x.im, x.im));
  const inv = x => {
    const d = abs2(x), di = Quad.inv(d);
    if (Quad.isNaN(di)) return mk(Quad.mk(Q.mk(0n,0n),Q.mk(0n,0n)), Quad.mk(Q.mk(0n,0n),Q.mk(0n,0n)));
    return mk(Quad.mul(x.re, di), Quad.mul(Quad.neg(x.im), di));
  };
  const div = (x, y) => mul(x, inv(y));
  const scaleRat = (z, r) => mk(Quad.mk(Q.mul(z.re.a, r), Q.mul(z.re.b, r)), Quad.mk(Q.mul(z.im.a, r), Q.mul(z.im.b, r)));
  const toFloatPair = z => [Quad.toFloat(z.re), Quad.toFloat(z.im)];
  return { mk, ZERO, ONE, I, isNaN, add, sub, neg, mul, conj, abs2, inv, div, scaleRat, toFloatPair };
})();

// ── KConsts: ζ = e^{iπ/4} = (√2/2)(1+i) exact in K ──
const KConsts = (() => {
  const half = Q.mk(1n, 2n);
  const s2o2 = Quad.mk(Q.ZERO, half); // (1/2)√2
  const zeta = CQuad.mk(s2o2, s2o2);  // ζ = (√2/2) + i(√2/2)
  const _cache = [CQuad.ONE];
  const powZeta = k => {
    const kk = ((k % 8) + 8) % 8;
    while (_cache.length <= kk) _cache.push(CQuad.mul(_cache[_cache.length-1], zeta));
    return _cache[kk];
  };
  return { half, zeta, powZeta };
})();

// ── Mat8K: 8×8 matrices over K (CQuad) — exact Hamiltonian construction ──
const Mat8K = (() => {
  const create = () => Array.from({length:64}, () => CQuad.ZERO);
  const get = (M,i,j) => M[i*8+j];
  const set = (M,i,j,v) => { M[i*8+j] = v; };
  const identity = () => { const M=create(); for(let i=0;i<8;i++) set(M,i,i,CQuad.ONE); return M; };
  const diag = vals => { const M=create(); for(let i=0;i<8;i++) set(M,i,i,vals[i]); return M; };
  const add = (A,B) => A.map((z,k) => CQuad.add(z, B[k]));
  const sub = (A,B) => A.map((z,k) => CQuad.sub(z, B[k]));
  const scaleRat = (A,r) => A.map(z => CQuad.scaleRat(z, r));
  const mul = (A,B) => {
    const C=create();
    for(let i=0;i<8;i++) for(let j=0;j<8;j++){
      let s=CQuad.ZERO;
      for(let k=0;k<8;k++) s=CQuad.add(s, CQuad.mul(A[i*8+k], B[k*8+j]));
      C[i*8+j]=s;
    }
    return C;
  };
  const trace = A => { let t=CQuad.ZERO; for(let i=0;i<8;i++) t=CQuad.add(t,A[i*8+i]); return t; };
  const mulVec = (A,v) => {
    const r=Array.from({length:8},()=>CQuad.ZERO);
    for(let i=0;i<8;i++) for(let j=0;j<8;j++) r[i]=CQuad.add(r[i], CQuad.mul(A[i*8+j], v[j]));
    return r;
  };
  const factBig = n => { let f = 1n; for (let k = 2n; k <= BigInt(n); k++) f *= k; return f; };
  const exp = (A, order = 6) => {
    let result = identity(), power = identity();
    for (let n = 1; n <= order; n++) {
      power = mul(power, A);
      result = add(result, scaleRat(power, Q.mk(1n, factBig(n))));
    }
    return result;
  };
  const mulVecK = (A, v) => {
    const r = Array.from({length:8}, () => CQuad.ZERO);
    for (let i = 0; i < 8; i++)
      for (let j = 0; j < 8; j++)
        r[i] = CQuad.add(r[i], CQuad.mul(A[i*8+j], v[j]));
    return r;
  };
  return { create, get, set, identity, diag, add, sub, scaleRat, mul, trace, mulVec, exp, mulVecK, factBig };
})();

// ═══════════════════════════════════════════════════════════════════════════════
// §1c SAFETY POLICY [SANDBOX_APPROX: browser preview only] — explicit runtime bounds (not scattered clamps)
// ═══════════════════════════════════════════════════════════════════════════════
const SAFETY = {
  corrections: 0,
  clampRatToIntBound(r, B) {
    if (Q.isNaN(r)) return Q.mk(0n, 0n);
    const dAbs = r.d < 0n ? -r.d : r.d, nAbs = r.n < 0n ? -r.n : r.n;
    const boundN = B * dAbs;
    if (nAbs <= boundN) return r;
    this.corrections++;
    return Q.mk(r.n < 0n ? -boundN : boundN, dAbs);
  },
  limitRatDigits(r, maxDN=12, maxDD=10) {
    if (Q.isNaN(r)) return r;
    let n=r.n, d=r.d;
    const dig = x => { x=x<0n?-x:x; if(x===0n) return 1; let c=0; while(x>0n){c++;x/=10n;} return c; };
    const dn=dig(n), dd=dig(d), over=Math.max(0, dn-maxDN, dd-maxDD);
    if (over===0) return r;
    this.corrections++;
    let s=1n; for(let i=0;i<over;i++) s*=10n;
    n/=s; d/=s; if(d===0n) d=1n;
    return Q.mk(n,d);
  },
  sanitizeLambda(arr) {
    for(let k=0;k<arr.length;k++) {
      arr[k] = this.clampRatToIntBound(arr[k], 500n);
      arr[k] = this.limitRatDigits(arr[k]);
    }
  },
  sanitizePsi(psi) {
    for(let i=0;i<psi.length;i++) {
      psi[i] = this.clampRatToIntBound(psi[i], 500n);
      psi[i] = this.limitRatDigits(psi[i]);
    }
  },
  applyFrame() {
    this.sanitizeLambda(lambda);
    this.sanitizePsi(VTX.psi);
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §1d OPERATOR CONTRACTS — identity collapse + energy verification
// ═══════════════════════════════════════════════════════════════════════════════
const CONTRACTS = {
  lastResults: null, runCount: 0,
  snapshotPsi() { return VTX.psi.map(r => ({n:r.n, d:r.d})); },
  restorePsi(snap) { for(let i=0;i<16;i++) VTX.psi[i] = Q.mk(snap[i].n, snap[i].d); },
  energyFloat() { let s=0; for(let i=0;i<16;i++){const v=Q.fl(VTX.psi[i]); s+=v*v;} return s; },
  countNaN() { let c=0; for(let i=0;i<16;i++) if(Q.isNaN(VTX.psi[i])) c++; return c; },
  complementCoherence() {
    let opp=0;
    for(let i=0;i<8;i++){if(Q.fl(VTX.psi[i])*Q.fl(VTX.psi[i^15])<0) opp++;}
    return opp/8;
  },
  testIdentity(op) {
    const snap=this.snapshotPsi(), nan0=this.countNaN();
    const saved=AMP.sutraAlpha; AMP.sutraAlpha=0;
    let maxErr=0;
    try { op.evolve(1);
      for(let i=0;i<16;i++){const d=Math.abs(Q.fl(Q.sub(VTX.psi[i],Q.mk(snap[i].n,snap[i].d))));if(isFinite(d)&&d>maxErr)maxErr=d;}
    } catch(e) { maxErr=Infinity; }
    AMP.sutraAlpha=saved; this.restorePsi(snap);
    return {ok:maxErr<1e-10&&this.countNaN()===nan0, err:maxErr};
  },
  testEnergy(op) {
    const snap=this.snapshotPsi(), E0=this.energyFloat();
    let E1=E0;
    try{op.evolve(1); E1=this.energyFloat();}catch(e){E1=NaN;}
    this.restorePsi(snap);
    return {E0,E1,dE:E1-E0,rel:(E0>1e-18&&isFinite(E1))?(E1-E0)/E0:0};
  },
  testComplement(op) {
    const snap=this.snapshotPsi(), c0=this.complementCoherence();
    let c1=c0;
    try{op.evolve(1); c1=this.complementCoherence();}catch(e){c1=NaN;}
    this.restorePsi(snap);
    return {c0,c1,dc:c1-c0};
  },
  runAll() {
    if (typeof SUTRAS === 'undefined' || typeof VTX === 'undefined') return [];
    const results=[];
    for(let sid=0;sid<SUTRAS.length;sid++){
      const s=SUTRAS[sid]; if(!s || !s.on) continue;
      const identity=this.testIdentity(s);
      const energy=this.testEnergy(s);
      const complement=this.testComplement(s);
      results.push({id:s.id,name:s.name,
        identity:identity.ok,identityErr:identity.err,
        dE_rel:energy.rel,dc:complement.dc,nanCount:this.countNaN()});
    }
    this.lastResults=results; this.runCount++;
    return results;
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §1e CENTRAL ALPHA — control signal (explicit float→Rat boundary)
// ═══════════════════════════════════════════════════════════════════════════════
const ALPHA = {
  amax: 0.25,
  compute(sid, rAbs, delta, sutraAlpha) {
    const decay = Math.exp(-rAbs / (sid + 1));
    const softDelta = Math.sign(delta) * Math.sqrt(Math.abs(delta) + 0.001);
    const a = decay * softDelta * 0.08 * sutraAlpha;
    return Math.max(-this.amax, Math.min(this.amax, a));
  },
  toRat(sid, rAbs, delta, sutraAlpha) {
    return Rat.fromFloatRounded(this.compute(sid, rAbs, delta, sutraAlpha));
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §3c ATMOSPHERE — Earth-like gaseous medium [SANDBOX_APPROX: non-canonical] surrounding the toroid
//
// COMPOSITION (dry air, sea level):
//   N₂:  78.09%  (MW 28.014 g/mol)   — Rayleigh scattering dominant
//   O₂:  20.95%  (MW 31.998 g/mol)   — paramagnetic, absorbs UV
//   Ar:   0.93%  (MW 39.948 g/mol)   — noble, pressure ballast
//   CO₂:  0.04%  (MW 44.009 g/mol)   — IR absorber, greenhouse tracer
//
// PHYSICS:
//   P = ρRT/M_avg    (ideal gas law, M_avg = 28.97 g/mol)
//   T(r) = T₀ · (1 - Γ·h)  where h = distance from torus surface
//   ρ(r) = P/(R_specific · T)
//   Rayleigh: I ∝ 1/λ⁴ → blue-shifted scattering near surface
//   Compressibility: κ = -V(∂P/∂V)_T = γP  (γ=1.4 for diatomic)
//
// COUPLING TO FIELD:
//   Field energy → local heating (T increases near active regions)
//   σ suppression → pressure drop (throat = low-pressure zone)
//   Vortex ω → convective circulation (Hadley-cell analogue)
//   ENGINE ZPE → ionization fraction (high ZPE = partial plasma)
// ═══════════════════════════════════════════════════════════════════════════════
const ATMOSPHERE = {
  // Composition mass fractions
  N2: 0.7809, O2: 0.2095, Ar: 0.0093, CO2: 0.0004,
  
  // Reference state (sea level, ISA standard)
  P0: 101325,    // Pa
  T0: 288.15,    // K
  rho0: 1.225,   // kg/m³
  M_avg: 0.02897, // kg/mol
  R_gas: 8.314,   // J/(mol·K)
  gamma: 1.4,     // heat capacity ratio (diatomic dominant)
  lapse: 0.0065,  // K/m temperature lapse rate
  
  // Dynamic state (driven by field)
  T_local: 288.15,   // local temperature near torus
  P_local: 101325,    // local pressure
  rho_local: 1.225,   // local density
  ionFraction: 0.0,   // partial ionization from ENGINE ZPE
  
  // Rayleigh scattering coefficients (relative, not absolute)
  // I_scatter ∝ (1 + cos²θ) / λ⁴
  // For RGB: λ_R≈650nm, λ_G≈550nm, λ_B≈450nm
  rayleighR: 1.0 / (0.650 ** 4),  //  5.63
  rayleighG: 1.0 / (0.550 ** 4),  // 10.94
  rayleighB: 1.0 / (0.450 ** 4),  // 24.39
  
  // Compressibility: κ_S = γP (adiabatic bulk modulus)
  bulkModulus() { return this.gamma * this.P_local; },
  
  // Speed of sound: c = √(γRT/M)
  soundSpeed() { return Math.sqrt(this.gamma * this.R_gas * this.T_local / this.M_avg); },
  
  // Update from field state — called once per frame
  update() {
    const E = fieldEnergy();
    const sigma = Q.fl(R4val);
    const omega = abs(vortexOmega);
    const zpeMag = ENGINE.zpe ? Math.sqrt(ENGINE.zpe[0]**2 + ENGINE.zpe[1]**2) : 0;
    
    // Temperature: base + field heating + vortex friction - σ cooling + B heating
    // Active field → local heating (energy dissipation into medium)
    // Low σ (near singularity) → adiabatic expansion → cooling
    // Strong B → ohmic/reconnection heating (like solar corona)
    // Strong vortex → adiabatic compression on leading edge, expansion on trailing
    const fieldHeat = E * 12;           // field energy → heating (K)
    const vortexFriction = omega * 8;   // vortex shear → friction heat
    const sigmaCool = (1 - sigma) * 25; // throat approach → expansion cooling
    const bHeat = MAGFIELD.pressure * 40; // magnetic reconnection heating
    const vorCompression = omega * omega * 5; // vortex adiabatic compression
    this.T_local = this.T0 + fieldHeat + vortexFriction - sigmaCool + bHeat + vorCompression;
    this.T_local = Math.max(180, Math.min(800, this.T_local)); // 180K–800K (higher ceiling for B heating)
    
    // Pressure: ideal gas with field-driven density perturbation
    // High field energy → radiation pressure → local overpressure
    // Low σ → geometric contraction → pressure drop
    // Strong B → magnetic pressure (P_mag = B²/2μ₀)
    // Vortex → dynamic pressure (P_dyn = ½ρv²)
    const radiationPressure = E * E * 50; // quadratic: radiation pressure ∝ E²
    const throatVacuum = (1 - sigma) * this.P0 * 0.3; // σ→0 creates partial vacuum
    const magneticPressure = MAGFIELD.pressure * this.P0 * 0.1; // B² term
    const dynamicPressure = omega * omega * this.rho0 * 500; // ½ρv² vortex term
    this.P_local = this.P0 + radiationPressure - throatVacuum + magneticPressure + dynamicPressure;
    this.P_local = Math.max(10000, Math.min(400000, this.P_local)); // 10–400 kPa (higher for B+vortex)
    
    // Density from ideal gas law: ρ = PM/(RT)
    this.rho_local = this.P_local * this.M_avg / (this.R_gas * this.T_local);
    
    // Ionization: ENGINE ZPE drives partial ionization
    // High ZPE → UV-equivalent radiation → N₂/O₂ dissociation/ionization
    this.ionFraction = Math.min(0.15, zpeMag * 0.05);
  },
  
  // Rayleigh scattering color at a given optical depth
  // Returns [r, g, b] in 0–1 range
  // depth: 0 = no scatter (transparent), 1 = deep scatter (blue haze)
  scatterColor(depth) {
    const scatter = depth * 0.012; // optical depth coefficient
    const norm = this.rayleighB; // normalize to blue peak
    const r = 1 - Math.exp(-scatter * this.rayleighR / norm);
    const g = 1 - Math.exp(-scatter * this.rayleighG / norm);
    const b = 1 - Math.exp(-scatter * this.rayleighB / norm);
    return [r, g, b];
  },
  
  // Atmospheric haze opacity at distance d from torus surface
  // Beer-Lambert: I/I₀ = exp(-α·d·ρ)
  hazeOpacity(d) {
    const alpha = 0.0008 * (this.rho_local / this.rho0); // extinction coefficient
    return 1 - Math.exp(-alpha * d * this.rho_local);
  },
  
  // Pressure-driven color temperature (for glow rendering)
  // Low pressure (throat) → blue shift, high pressure → orange/red
  pressureColorTemp() {
    const pRatio = this.P_local / this.P0;
    // pRatio < 1: cool (blue), pRatio > 1: hot (orange)
    return {
      r: Math.min(1, 0.3 + pRatio * 0.4 + this.ionFraction * 2),
      g: Math.min(1, 0.2 + 0.3 / (1 + Math.abs(pRatio - 1))),
      b: Math.min(1, 0.6 - pRatio * 0.2 + (1 - this.ionFraction) * 0.3)
    };
  }
};

