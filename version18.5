// ═══════════════════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════════════
// §12X  VERTEX FIELD SUBSTRATE — Ψ[16] = V·λ
//
// The 16 vertices of the tesseract are the ACTUAL field substrate.
// Sutras transform vertex fields, NOT the flat 4-vector.
//
// Forward:  Ψᵢ = Σₖ sᵢₖ·λₖ   where sᵢₖ = (i & (1<<k)) ? +1 : -1
// Inverse:  λₖ = (1/16) Σᵢ sᵢₖ·Ψᵢ   (VᵀV = 16·I₄ orthogonality)
//
// Operators work in vertex space. Lambda is reconstructed ONCE after all sutras.
// ═══════════════════════════════════════════════════════════════════════════════
const VTX = {
  psi: Array.from({length:16}, () => Q.ZERO),
  signs: Array.from({length:16}, (_, i) => [
    (i & 1) ? 1n : -1n, (i & 2) ? 1n : -1n,
    (i & 4) ? 1n : -1n, (i & 8) ? 1n : -1n
  ]),
  forward() {
    for (let i = 0; i < 16; i++) {
      this.psi[i] = Q.ZERO;
      for (let k = 0; k < 4; k++)
        this.psi[i] = Q.add(this.psi[i], Q.mul(Q.mk(this.signs[i][k]), lambda[k]));
    }
  },
  inverse() {
    for (let k = 0; k < 4; k++) {
      let s = Q.ZERO;
      for (let i = 0; i < 16; i++)
        s = Q.add(s, Q.mul(Q.mk(this.signs[i][k]), this.psi[i]));
      lambda[k] = Q.div(s, Q.mk(16n));
    }
  },
  // Hamming weight of vertex index
  hw(i) { let c=0,n=i; while(n){c+=n&1;n>>=1;} return c; },
  // Complement vertex (bitwise NOT on 4 bits)
  comp(i) { return i ^ 15; },
  // 4 neighbors (Hamming distance 1)
  neighbors(i) { return [i^1, i^2, i^4, i^8]; },
  // Mean of all 16 vertex fields
  mean() { let s=Q.ZERO; for(const p of this.psi) s=Q.add(s,p); return Q.div(s,Q.mk(16n)); },
  // Norm²: Σ Ψᵢ²
  normSq() { let s=Q.ZERO; for(const p of this.psi) s=Q.add(s,Q.mul(p,p)); return s; },
  // NaN/Infinity guard only — no energy cap, no magnitude cap
  normalize(maxEnergy) {
    // ENERGY CONSERVATION: rescale ALL vertices proportionally when total
    // energy exceeds maxEnergy. This preserves the SHAPE of the field —
    // all ratios Ψᵢ/Ψⱼ are maintained. Only the overall scale is bounded.
    // This is physical energy conservation, not dampening or clamping.
    const E = Q.fl(this.normSq());
    if (isFinite(E) && E > maxEnergy) {
      const scale = sqrt(maxEnergy / E);
      const sB = Bi(scale * 10000);
      for (let i = 0; i < 16; i++)
        this.psi[i] = Q.mul(this.psi[i], Q.mk(sB, 10000n));
    }
    // Runtime safety: NaN/Infinity repair + BigInt numerator cap
    for (let i = 0; i < 16; i++) {
      const v = Q.fl(this.psi[i]);
      if (!isFinite(v)) this.psi[i] = Q.ZERO;
      const an = this.psi[i].n < 0n ? -this.psi[i].n : this.psi[i].n;
      if (an > MAXN) this.psi[i] = Q.mk(Bi(v));
    }
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §12Y  STRUCTURAL SINGULARITY SUPPRESSION
//
// α(n) = σ · decay · Δₙ — controls operator deviation from identity
//
// σ = ∏ₖ λₖ⁴/(r⁴+λₖ⁴) ∈ [0,1] — smooth suppression function (NOT Kretschner R⁴)
// decay = e^(-|r|/(n+1))              — radial decay from USO formula
// Δₙ = USO delta                      — field-coherent modulation
//
// STRUCTURAL GUARANTEE: every operator type collapses to identity when α→0:
//   MULTIPLICATIVE:  Ψ' = Ψ·(1 + α·(M-1))       → Ψ·1 = Ψ
//   REFLECTIVE:      Ψ' = (1-α)·Ψ + α·R(Ψ)      → 1·Ψ + 0 = Ψ
//   CONVOLUTIVE:     Ψ' = Ψ + α·(C⊛Ψ - Ψ)       → Ψ + 0 = Ψ
//   DIFFUSIVE:       Ψ' = Ψ + α·ΔΨ               → Ψ + 0 = Ψ
//   DIVISIVE:        Ψ' = Ψ + α·(Q(Ψ) - Ψ)      → Ψ + 0 = Ψ
//   PERMUTATIVE:     Ψ' = (1-α)·Ψ + α·P(Ψ)      → Ψ
//   MODULAR:         Ψ' = Ψ + α·(Ψ mod B - Ψ)   → Ψ
//   CONSERVATION:    Ψ' = Ψ + α·(target - Ψ)     → Ψ
// ═══════════════════════════════════════════════════════════════════════════════
const SUPPRESS = {
  // Structural alpha: decay · sqrt(|Δₙ|) · sign(Δₙ)
  //
  // NO σ factor — the vertex field substrate already encodes suppression geometry.
  // σ in alpha was double-gating: small λ → small σ → small α → operators freeze.
  //
  // Identity guarantee: when Δₙ→0 (field coherent), α→0 → operator→identity
  // Radial decay: operators weaken at large radius (USO formula)
  // Delegates to ALPHA module (MD §4.1: single source of truth)
  alpha(sid) {
    const R = abs(Q.fl(r_param));
    const delta = USO.delta(sid);
    const sutra = SUTRAS[sid - 1];
    const strength = sutra ? sutra.strength / 100 : 0;
    return ALPHA.compute(sid, R, delta, strength);
  },
  alphaPhi(sid) {
    return this.alpha(sid) * Q.fl(SUTRA_COEFF[sid] || Q.ONE);
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §12Z  VERTEX-FIELD SUTRA OPERATORS
//
// SEVEN genuinely different operator types on Ψ[16]:
//
//   MULTIPLICATIVE — Ψ'ᵢ = Ψᵢ · (1 + α·fₘ(Ψ))     [S1, S10, S14, S15]
//   REFLECTIVE     — Ψ'ᵢ = (1-α)·Ψᵢ + α·R(Ψᵢ)     [S2, S5, S12, S22, S23]
//   CONVOLUTIVE    — Ψ'ᵢ = Ψᵢ + α·(C⊛Ψ - Ψ)ᵢ      [S3, S11, S25]
//   DIVISIVE       — Horner/polynomial on Hamming layers [S4, S8, S13, S16, S19]
//   DIFFUSIVE      — Graph Laplacian/gradient on edges  [S9, S17, S27, S28]
//   PERMUTATIVE    — Symmetry operations on vertex sets  [S6, S7, S26]
//   MODULAR        — Residue/congruence on vertex vals   [S18, S20, S21, S24, S29]
//
// Each type has STRUCTURALLY DIFFERENT coupling to the vertex field.
// ═══════════════════════════════════════════════════════════════════════════════
const SUTRAS = [
  // ═══════════════════════════════════════════════════════════════════════════
  // S1: Ekādhikena Pūrveṇa — "By one more than the previous"
  // TYPE: MULTIPLICATIVE
  // Each vertex amplified by (1 + neighbor/|neighbor|²) along axis-0 edge
  // The "one more" IS the multiplicative increment on the tesseract graph
  // ═══════════════════════════════════════════════════════════════════════════
  { id:1, name:'Ekādhikena Pūrveṇa', sk:'एकाधिकेन', m:1, n:0, amp:0.5, freq:1.0, strength:0,
    desc:'MULTIPLICATIVE: Ψ\'ᵢ = Ψᵢ·(1+α·Ψ_{i⊕1}/|Ψ_{i⊕1}|²) on axis-0 edges',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(1);
      const grvq = GRVQ.evolve(lambda, 0, simTime);
      // GRVQ FEEDBACK: apply δλ to lambda[0] (not just display)
      if (abs(grvq) > 1e-8 && abs(grvq) < 5.0) {
        lambda[0] = Q.add(lambda[0], Q.mk(Bi(grvq * 10000), 10000n));
      }
      for (let i = 0; i < 16; i++) {
        const nb = VTX.psi[i ^ 1]; // neighbor along axis 0 (Ekā = "one")
        const nbMag = Q.fl(Q.mul(nb, nb)) + 1; // |Ψ|² + 1 prevents division by zero
        const factor = Q.fl(nb) / nbMag;
        // Ψ' = Ψ·(1 + α·f) → Ψ when α→0
        VTX.psi[i] = Q.mul(VTX.psi[i], Q.add(Q.ONE, Q.mk(Bi(α * factor * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(1, 10);
      return `S1: MULT Ψ₀=${sf(Q.fl(VTX.psi[0]),3)} Ψ₁₅=${sf(Q.fl(VTX.psi[15]),3)} α=${sf(α,4)} δλ₀=${sf(grvq,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S2: Nikhilam — "All from 9, last from 10"
  // TYPE: REFLECTIVE
  // Ψ'ᵢ = (1-α)·Ψᵢ + α·(B-Ψᵢ) — interpolate toward complement from base B
  // The "all from 9" IS the reflection toward the complement.
  //
  // FIXED: Base B is now latched per order-of-magnitude epoch.
  // In Vedic arithmetic the base is fixed (10^n). A moving base breaks
  // the involution property (applying twice ≠ identity). We only update B
  // when the field magnitude crosses a power-of-10 boundary.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:2, name:'Nikhilam', sk:'निखिलं', m:0, n:1, amp:0.6, freq:0.9, strength:0,
    desc:'REFLECTIVE: Ψ\'ᵢ = (1-α)Ψᵢ + α(B-Ψᵢ) — complement reflection',
    _cachedB: null, _cachedOrder: -1,
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(2);
      let maxM = 0;
      for (let i = 0; i < 16; i++) maxM = max(maxM, abs(Q.fl(VTX.psi[i])));
      // Only update B when order-of-magnitude changes (stable base)
      const order = floor(Math.log10(max(1, maxM)) + 1);
      if (order !== this._cachedOrder || !this._cachedB) {
        this._cachedB = Q.mk(Bi(Math.pow(10, order) * 1000), 1000n);
        this._cachedOrder = order;
      }
      const B = this._cachedB;
      for (let i = 0; i < 16; i++) {
        const comp = Q.sub(B, VTX.psi[i]); // "all from B"
        // Ψ' = (1-α)·Ψ + α·comp = Ψ + α·(comp - Ψ)
        const diff = Q.sub(comp, VTX.psi[i]);
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      MSTVQ.setB(Q.fl(Q.sub(B, VTX.psi[0])) * 0.15, Q.fl(Q.sub(B, VTX.psi[5])) * 0.01, α * 0.1);
      MSTVQ.compute();
      INTER_SUTRA.recordInteraction(2, 22);
      return `S2: REFL B=${sf(Q.fl(B),0)} Ψ₀=${sf(Q.fl(VTX.psi[0]),2)} α=${sf(α,4)} T=${sf(MSTVQ.trace(),3)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S3: Ūrdhva-Tiryagbhyām — "Vertically and Crosswise"
  // TYPE: CONVOLUTIVE
  // XOR-convolution on vertex fields: Ψ'ᵢ = Ψᵢ + α·(Σⱼ Ψⱼ·Ψᵢ⊕ⱼ/N - Ψᵢ)
  // The "crosswise" IS the XOR operation on Z₂⁴ vertex indices
  // This is the Walsh-Hadamard convolution on the tesseract
  // ═══════════════════════════════════════════════════════════════════════════
  { id:3, name:'Ūrdhva-Tiryagbhyām', sk:'ऊर्ध्व', m:2, n:3, amp:0.55, freq:1.2, strength:0,
    desc:'CONVOLUTIVE: XOR-convolution Ψ\'ᵢ = Ψᵢ+α·(Σⱼ Ψⱼ·Ψᵢ⊕ⱼ/N - Ψᵢ)',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(3);
      const conv = new Array(16);
      // Walsh-Hadamard convolution on Z₂⁴: conv[i] = Σⱼ Ψⱼ · Ψ_{i⊕j}
      // Normalization: divide by N=16 to match convolution theorem
      // (H(f⊛g) = H(f)·H(g) pointwise requires 1/N factor)
      const N16 = Q.mk(16n);
      for (let i = 0; i < 16; i++) {
        conv[i] = Q.ZERO;
        for (let j = 0; j < 16; j++) conv[i] = Q.add(conv[i], Q.mul(VTX.psi[j], VTX.psi[i ^ j]));
        conv[i] = Q.div(conv[i], N16); // proper 1/N normalization
      }
      for (let i = 0; i < 16; i++) {
        const diff = Q.sub(conv[i], VTX.psi[i]);
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      MSTVQ.setB(Q.fl(conv[0]) * 1e-4, Q.fl(conv[5]) * 1e-4, α * 0.01);
      MSTVQ.compute();
      INTER_SUTRA.recordInteraction(3, 15);
      return `S3: CONV c₀=${sf(Q.fl(conv[0]),2)} c₁₅=${sf(Q.fl(conv[15]),2)} α=${sf(α,4)} T=${sf(MSTVQ.trace(),3)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S4: Parāvartya Yojayet — "Transpose and Adjust"
  // TYPE: DIVISIVE
  // Treats Hamming-weight layers as polynomial coefficients.
  // Horner evaluation at x=σ (suppression function), quotient coefficients redistributed to vertices.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:4, name:'Parāvartya Yojayet', sk:'परावर्त्य', m:3, n:2, amp:0.4, freq:0.8, strength:0,
    desc:'DIVISIVE: Horner on Hamming layers c[h], evaluated at σ',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(4);
      // Layer means by Hamming weight: hw=0(1v), hw=1(4v), hw=2(6v), hw=3(4v), hw=4(1v)
      const layers = [[], [], [], [], []];
      for (let i = 0; i < 16; i++) layers[VTX.hw(i)].push(i);
      const c = layers.map(L => {
        let s = Q.ZERO; for (const i of L) s = Q.add(s, VTX.psi[i]);
        return L.length > 0 ? Q.div(s, Q.mk(BigInt(L.length))) : Q.ZERO;
      });
      // Catalogue: σ_i = r_i/(1+r_i) where r_i = hw(i)/4
      // Horner: P(σ) = c_0 + c_1·σ + c_2·σ² + c_3·σ³ + c_4·σ⁴
      for (let i = 0; i < 16; i++) {
        const h = VTX.hw(i);
        const r = Q.mk(BigInt(h), 4n); // r_i = hw(i)/4
        const sigma = Q.div(r, Q.add(Q.ONE, r)); // σ_i = r/(1+r)
        // Horner evaluation: P = c[4], then P = c[k] + σ·P for k=3..0
        let P = c[4];
        for (let k = 3; k >= 0; k--) P = Q.add(c[k], Q.mul(sigma, P));
        const diff = Q.sub(P, VTX.psi[i]);
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 10000), 10000n)));
      }
      INTER_SUTRA.recordInteraction(4, 13);
      return `S4: DIV Horner(σ) α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S5: Śūnyam Sāmyasamuccaye — "If the Samuccaya is the same, it is zero"
  // TYPE: REFLECTIVE
  // Complementary vertex pairs (i, i⊕15) are driven toward zero-sum.
  // Ψ'ᵢ = (1-α)·Ψᵢ + α·(-Ψ_{comp(i)}) — the "zero" IS the target
  // ═══════════════════════════════════════════════════════════════════════════
  { id:5, name:'Śūnyam Sāmyasamuccaye', sk:'शून्यं', m:1, n:1, amp:0.45, freq:1.0, strength:0,
    desc:'REFLECTIVE: drive complementary vertex pairs to zero-sum',
