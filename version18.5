// §1d  UNIQUE GEOMETRY LOGGER
//
// Tracks distinctive geometric configurations: extreme R, throat pinches,
// symmetry breaks, energy spikes. Logs timestamped entries for analysis.
// ═══════════════════════════════════════════════════════════════════════════════
const GEO_LOG = {
  entries: [],
  maxEntries: 50,
  lastLogCycle: 0,
  cooldown: 30,  // minimum frames between logs

  // Track extremes per frame
  frameRmin: Infinity, frameRmax: -Infinity,
  framerMin: Infinity, framerMax: -Infinity,
  frameYmin: Infinity, frameYmax: -Infinity,
  frameTwistMax: 0,

  resetFrame() {
    this.frameRmin = Infinity; this.frameRmax = -Infinity;
    this.framerMin = Infinity; this.framerMax = -Infinity;
    this.frameYmin = Infinity; this.frameYmax = -Infinity;
    this.frameTwistMax = 0;
  },

  trackPoint(R, r, yOff, twist) {
    this.frameRmin = min(this.frameRmin, R);
    this.frameRmax = max(this.frameRmax, R);
    this.framerMin = min(this.framerMin, r);
    this.framerMax = max(this.framerMax, r);
    this.frameYmin = min(this.frameYmin, yOff);
    this.frameYmax = max(this.frameYmax, yOff);
    this.frameTwistMax = max(this.frameTwistMax, abs(twist));
  },

  analyzeFrame() {
    if (cycle - this.lastLogCycle < this.cooldown) return;
    const Rrange = this.frameRmax - this.frameRmin;
    const rRange = this.framerMax - this.framerMin;
    const yRange = this.frameYmax - this.frameYmin;
    const E = Q.fl(VTX.normSq());

    // Detect unusual geometries
    let event = null;
    if (this.framerMin < 5) {
      event = { type: 'THROAT', detail: `r_min=${this.framerMin.toFixed(1)}`, severity: 3 };
    } else if (Rrange > 400) {
      event = { type: 'EXPANSION', detail: `ΔR=${Rrange.toFixed(0)}`, severity: 2 };
    } else if (this.frameTwistMax > 1.0) {
      event = { type: 'VORTEX-LOCK', detail: `twist=${this.frameTwistMax.toFixed(2)}`, severity: 2 };
    } else if (rRange > 150) {
      event = { type: 'TUBE-RIPPLE', detail: `Δr=${rRange.toFixed(0)}`, severity: 1 };
    } else if (yRange > 200) {
      event = { type: 'VERTICAL-WAVE', detail: `Δy=${yRange.toFixed(0)}`, severity: 1 };
    } else if (E > 90000) {
      event = { type: 'HIGH-ENERGY', detail: `E=${E.toFixed(0)}`, severity: 1 };
    }

    if (event) {
      event.cycle = cycle;
      event.time = (simTime * 0.001).toFixed(1);
      event.R = `[${this.frameRmin.toFixed(0)},${this.frameRmax.toFixed(0)}]`;
      event.r = `[${this.framerMin.toFixed(0)},${this.framerMax.toFixed(0)}]`;
      event.r4 = Q.fl(R4val).toFixed(4);
      event.lam = lambda.map(l => Q.fl(l).toFixed(1)).join(',');
      this.entries.push(event);
      if (this.entries.length > this.maxEntries) this.entries.shift();
      this.lastLogCycle = cycle;
    }
  },

  // Get recent entries for overlay display
  recent(n) { return this.entries.slice(-n); }
};

function computeR4() {
  const r4 = Q.mul(Q.mul(r_param, r_param), Q.mul(r_param, r_param));
  let prod = Q.ONE;
  for (let k = 0; k < 4; k++) {
    const lk = lambda[k];
    const l2 = Q.mul(lk, lk), l4 = Q.mul(l2, l2);
    const denom = Q.add(r4, l4);
    if (denom.n !== 0n) prod = Q.mul(prod, Q.div(l4, denom));
  }
  R4val = prod;
}

// §12B SUTRA COUPLING: Σ delta(S_n) = Σn(1..29) = 435
// Each sutra's natural weight = delta(n)/435 = n/435
// This is exact rational: Q.mk(BigInt(id), 435n)
// Conservation: Σ_{n=1}^{29} n/435 = 435/435 = 1 ✓
const SUTRA_SUM = 435n;

// ═══════════════════════════════════════════════════════════════════════════════
// §12A  UNIVERSAL SUTRA OPERATOR (USO)
//
// Δᵢ = G_equiv(i/29) · sin[(i+1)πR/r_eq + iπ/4] · e^(-R/(i+1))
//
// P = 1 + Σᵢ₌₁²⁹ Δᵢ         [Parallel — additive influence]
// S = ∏ᵢ₌₁²⁹ (1 + Δᵢ)       [Series — cascaded multiplication]
// Cₙ = 1 + γₙ(P⁽ⁿ⁾-1)/S⁽ⁿ⁾   [Concurrent — recursive feedback]
//
// 𝒰ₙ = P · S · Cₙ            [Unified correction operator]
//
// Source: Vedic Algorithm Architecture — original formulation
// ═══════════════════════════════════════════════════════════════════════════════
const USO = {
  r_eq: 1.0,  // equilibrium radius
  gammas: new Float64Array(30), // γₙ adaptive coefficients (index 1-29)
  deltas: new Float64Array(30), // cached Δᵢ values
  P: 1.0, S: 1.0, // parallel/series accumulators

  init() {
    for (let i = 1; i <= 29; i++) this.gammas[i] = 1.0 / i;
  },

  // G_equiv(x) = x·(1-x) — normalized coupling that peaks at x=0.5
  G_equiv(x) { return Math.max(0.03, 4 * x * (1 - x)); }, // floor=0.03: no sutra silenced at boundary

  // Compute Δᵢ for sutra i given field radius R
  computeDelta(i, R) {
    const x = i / 29;
    const G = this.G_equiv(x);
    const phase = (i + 1) * PI * R / this.r_eq + i * PI / 4 + i * 0.1; // φ-offset breaks sin() zeros
    const decay = exp(-abs(R) / (i + 1));
    return G * sin(phase) * decay;
  },

  // Full USO cycle: compute all Δᵢ, then P, S, Cₙ, 𝒰ₙ
  cycle(R) {
    let P = 1.0, S = 1.0;
    for (let i = 1; i <= 29; i++) {
      const d = this.computeDelta(i, R);
      this.deltas[i] = d;
      P += d;               // Parallel: additive
      S *= (1 + d);         // Series: multiplicative cascade
    }
    this.P = P; this.S = S;
    return { P, S };
  },

  // Concurrent feedback for sutra n: Cₙ = 1 + γₙ·(P-1)/S
  concurrent(n) {
    const denom = abs(this.S) > 1e-15 ? this.S : 1.0;
    return 1.0 + this.gammas[n] * (this.P - 1.0) / denom;
  },

  // Unified correction operator: 𝒰ₙ = P · S · Cₙ
  unified(n) {
    return this.P * this.S * this.concurrent(n);
  },

  // Per-sutra Δ value (cached from last cycle)
  delta(i) { return this.deltas[i] || 0; }
};
USO.init();

