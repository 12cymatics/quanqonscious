  conj: (a) => [a[0], -a[1]],
  abs2: (a) => a[0]*a[0]+a[1]*a[1],
  abs: (a) => sqrt(a[0]*a[0]+a[1]*a[1]),
  neg: (a) => [-a[0], -a[1]],
  ZERO: [0, 0],
  ONE: [1, 0],
  I: [0, 1],
};

// ── 8×8 complex matrix operations ──
const MAT8 = {
  create: () => Array.from({length:64}, () => [0,0]),
  get: (M, i, j) => M[i*8+j],
  set: (M, i, j, v) => { M[i*8+j] = [v[0], v[1]]; },
  copy: (M) => M.map(v => [v[0], v[1]]),

  identity: () => {
    const M = MAT8.create();
    for (let i = 0; i < 8; i++) MAT8.set(M, i, i, CX.ONE);
    return M;
  },

  diag: (vals) => {
    const M = MAT8.create();
    for (let i = 0; i < 8; i++) MAT8.set(M, i, i, vals[i]);
    return M;
  },

  add: (A, B) => A.map((v, idx) => CX.add(v, B[idx])),
  sub: (A, B) => A.map((v, idx) => CX.sub(v, B[idx])),
  scaleR: (A, s) => A.map(v => CX.scale(v, s)),
  scaleC: (A, z) => A.map(v => CX.mul(v, z)),

  mul: (A, B) => {
    const C = MAT8.create();
    for (let i = 0; i < 8; i++)
      for (let j = 0; j < 8; j++) {
        let s = [0,0];
        for (let k = 0; k < 8; k++)
          s = CX.add(s, CX.mul(A[i*8+k], B[k*8+j]));
        C[i*8+j] = s;
      }
    return C;
  },

  trace: (A) => {
    let tr = [0,0];
    for (let i = 0; i < 8; i++) tr = CX.add(tr, A[i*8+i]);
    return tr;
  },

  mulVec: (A, v) => {
    const r = Array.from({length:8}, () => [0,0]);
    for (let i = 0; i < 8; i++)
      for (let j = 0; j < 8; j++)
        r[i] = CX.add(r[i], CX.mul(A[i*8+j], v[j]));
    return r;
  },

  // Matrix exponential: e^A = Σ_{n=0}^{order} A^n/n!
  // For 8×8 complex matrices. Convergent for all A.
  exp: (A, order=8) => {
    let result = MAT8.identity();
    let power = MAT8.identity();
    let factorial = 1;
    for (let n = 1; n <= order; n++) {
      factorial *= n;
      power = MAT8.mul(power, A);
      result = MAT8.add(result, MAT8.scaleR(power, 1/factorial));
    }
    return result;
  },

  // Frobenius norm: ||A||_F = sqrt(Σ|a_ij|²)
  frobNorm: (A) => {
    let s = 0;
    for (let i = 0; i < 64; i++) s += CX.abs2(A[i]);
    return sqrt(s);
  }
};

// ── 8×8 Hamiltonian Engine ──
const ENGINE = {
  // ── 8×8 Hamiltonian Engine (Exact construction in K = ℚ(√2,i))
  // The Hamiltonian is built EXACTLY over K using Mat8K/CQuad.
  // For per-frame evolution, it is PROJECTED to Float64 (explicit boundary).
  // Periodic rebuild (every 60 frames) recomputes from exact.
  // ═══════════════════════════════════════════════════════════════════
  chi: 0.5,
  lambdas: [1, 2, 3, 4],
  D: 0.5,
  lambda0: 1/3,
  lambdaB: 1/5,
  m: 1, s: 1,
  N_TAYLOR: 8,
  zetaPow: null,
  hw3: [0, 1, 1, 2, 1, 2, 2, 3],
  qvals: null,
  gvals: null,

  // Float projection layer (CX/MAT8)
  Q_mat: null, P_mat: null, H_ENGINE: null, expNegH: null,

  // Exact K layer (CQuad/Mat8K) — the ground truth
  H_exact: null,    // Mat8K in K
  traceH_exact: null, // CQuad trace

  psi8: null,       // Float64 complex state [re,im]×8
  zpe: null,        // Float64 complex [re,im]
  traceH: null,     // Float64 complex [re,im]
  normH: 0,
  normPsi: 0,
  coupling: 0.20,
  coupling_exact: null, // Rat: exact value
  sutraAccum: null, // per-vertex accumulator: sums sutra displacements per frame
  accumFrames: 0,   // frames since last drain

  init() {
    const s2h = Math.SQRT2 / 2;
    this.zetaPow = Array.from({length: 8}, (_, k) => {
      const angle = k * PI / 4;
      return CX.mk(cos(angle), sin(angle));
    });
    this.qvals = this.hw3.map(r => (r + this.s) % 8);
    this.computeGvals();
    this.buildQ();
    this.buildP();
    this.buildHamiltonian();
    const amp = 1 / sqrt(8);
    this.psi8 = Array.from({length: 8}, () => CX.mk(amp, 0));
    this.coupling_exact = Q.mk(1n, 5n); // 1/5 exact
    this.sutraAccum = new Float64Array(8);
    this.accumFrames = 0;
  },

  // g_i = ∏_{k=1..4} [1 - r(i)⁴/(r(i)⁴ + λ_k⁴)]  — GRVQ singularity suppression
  // This is the fundamental suppression mechanism: σ-like factor per vertex
  computeGvals() {
    this.gvals = new Array(8);
    for (let k = 0; k < 4; k++) {
      this.lambdas[k] = max(0.01, abs(Q.fl(lambda[k])));
    }
    for (let i = 0; i < 8; i++) {
      const r = this.hw3[i];
      const r4 = r * r * r * r;
      let prod = 1;
      for (let k = 0; k < 4; k++) {
        const lk = this.lambdas[k];
        const lk4 = lk * lk * lk * lk;
        prod *= (1 - r4 / (r4 + lk4));
      }
      this.gvals[i] = prod;
    }
  },

  buildQ() {
    const c = this.chi;
    const T = [[[1,c],[c,1]], [[1,-c],[-c,1]], [[1,c],[-c,1]]];
    const M = MAT8.create();
    for (let i = 0; i < 8; i++) {
      const ib = [(i>>2)&1, (i>>1)&1, i&1];
      for (let j = 0; j < 8; j++) {
        const jb = [(j>>2)&1, (j>>1)&1, j&1];
        let val = 1;
        for (let d = 0; d < 3; d++) val *= T[d][ib[d]][jb[d]];
        MAT8.set(M, i, j, CX.mk(val, 0));
      }
    }
    this.Q_mat = M;

    // ── EXACT K construction of Q ──
    this._buildQ_exact();
  },

  _buildQ_exact() {
    const c = Q.HALF; // χ = 1/2 exact
    const nc = Q.neg(c);
    const one = Q.ONE;
    const T0=[[one,c],[c,one]], T1=[[one,nc],[nc,one]], T2=[[one,c],[nc,one]];
    const Ts = [T0, T1, T2];
    const M = Mat8K.create();
    for (let i=0; i<8; i++) {
      const ib=[(i>>2)&1,(i>>1)&1,i&1];
      for (let j=0; j<8; j++) {
        const jb=[(j>>2)&1,(j>>1)&1,j&1];
        let val = Q.ONE;
        for (let d=0; d<3; d++) val = Q.mul(val, Ts[d][ib[d]][jb[d]]);
        Mat8K.set(M, i, j, CQuad.mk(Quad.mk(val, Q.ZERO), Quad.ZERO));
      }
    }
    this._Q_exact = M;
  },

  buildP() {
    const P = MAT8.create();
    for (let i = 0; i < 8; i++)
      for (let j = 0; j < 8; j++) {
        const xor = i ^ j;
        if (xor === 1 || xor === 2 || xor === 4)
          MAT8.set(P, i, j, MAT8.get(this.Q_mat, i, j));
      }
    this.P_mat = P;
  },

  buildHamiltonian() {
    // ── Phase matrix Φ = diag(ζ^{q(i)}) ──
    const PhiVals = this.qvals.map(qi => this.zetaPow[qi]);
    const Phi = MAT8.diag(PhiVals);
    const PhiInv = MAT8.diag(PhiVals.map(z => CX.conj(z)));

    // ── Driven Hamiltonian: H_DRV = Φ·(D·I + λ₀·P)·Φ⁻¹ ──
    const DI = MAT8.scaleR(MAT8.identity(), this.D);
    const lP = MAT8.scaleR(this.P_mat, this.lambda0);
    const inner = MAT8.add(DI, lP);
    const H_DRV = MAT8.mul(Phi, MAT8.mul(inner, PhiInv));

    // ── GRVQ suppression diagonal: A_GRVQ = diag(g_i) ──
    const A_GRVQ = MAT8.diag(this.gvals.map(g => CX.mk(g, 0)));

    // ── Maya phase diagonal: A_Maya = diag(ζ^{mi}) ──
    const A_Maya = MAT8.diag(Array.from({length:8}, (_,i) => this.zetaPow[(this.m * i) % 8]));

    // ── Generalized Pauli: X (bit-flip), Z = diag(ζ^{r(i)}), Y = ζ²·X·Z ──
    const X = MAT8.create();
    for (let i = 0; i < 8; i++) MAT8.set(X, i, i ^ 1, CX.ONE);
    const Z = MAT8.diag(this.hw3.map(r => this.zetaPow[r]));
    const XZ = MAT8.mul(X, Z);
    const Y = MAT8.scaleC(XZ, this.zetaPow[2]);
    // A_MST = λ_B · (X + Y + Z)
    const XpYpZ = MAT8.add(MAT8.add(X, Y), Z);
    const A_MST = MAT8.scaleR(XpYpZ, this.lambdaB);

    // ── Assembly: H_pre = H_DRV + A_GRVQ + A_MST + A_Maya ──
    let H_pre = MAT8.add(MAT8.add(H_DRV, A_GRVQ), MAT8.add(A_MST, A_Maya));

    // ── ZPE shift: Z_ZPE = -(1/8)Tr(H_pre) → Tr(H_ENGINE) = 0 ──
    const tr = MAT8.trace(H_pre);
    const zpeRe = -tr[0] / 8, zpeIm = -tr[1] / 8;
    this.zpe = [zpeRe, zpeIm];
    this.traceH = tr;

    for (let i = 0; i < 8; i++) {
      const old = MAT8.get(H_pre, i, i);
      MAT8.set(H_pre, i, i, CX.add(old, CX.mk(zpeRe, zpeIm)));
    }
    this.H_ENGINE = H_pre;
    this.normH = MAT8.frobNorm(H_pre);

    // ── Evolution operator: e^{-H} via truncated Taylor (order 8) ──
    const negH = H_pre.map(z => CX.neg(z));
    this.expNegH = MAT8.exp(negH, this.N_TAYLOR);

    // ── EXACT K construction (for verification) ──
    this._buildH_exact();
  },

  _buildH_exact() {
    if (!this._Q_exact) return;
    // Build H_ENGINE exactly in K — verifiable to machine epsilon
    // Exact Φ diagonal using KConsts.powZeta
    const PhiVals = this.qvals.map(qi => KConsts.powZeta(qi));
    const PhiInv = PhiVals.map(z => CQuad.conj(z));

    // Exact P matrix from exact Q
    const P_exact = Mat8K.create();
    for (let i=0; i<8; i++) for (let j=0; j<8; j++) {
      const xor = i^j;
      if (xor===1||xor===2||xor===4) Mat8K.set(P_exact,i,j, Mat8K.get(this._Q_exact,i,j));
    }

    // Exact inner = D·I + λ₀·P
    const DI = Mat8K.scaleRat(Mat8K.identity(), Q.HALF); // D=1/2
    const lP = Mat8K.scaleRat(P_exact, Q.mk(1n,3n)); // λ₀=1/3
    const inner = Mat8K.add(DI, lP);

    // Exact H_DRV = Φ·inner·Φ⁻¹
    const Phi = Mat8K.diag(PhiVals);
    const PhiInvM = Mat8K.diag(PhiInv);
    const H_DRV = Mat8K.mul(Phi, Mat8K.mul(inner, PhiInvM));

    // Exact GRVQ diagonal (from rational lambda)
    const gExact = new Array(8);
    for (let i=0; i<8; i++) {
      const ri = BigInt(this.hw3[i]);
      const ri4 = ri*ri*ri*ri;
      let prod = Q.ONE;
      for (let k=0; k<4; k++) {
        const lk = lambda[k];
        if (Q.isNaN(lk)) { prod = Q.mk(0n,0n); break; }
        const lk4 = Q.mul(Q.mul(lk,lk), Q.mul(lk,lk));
        const ri4R = Q.mk(ri4, 1n);
        const frac = Q.div(ri4R, Q.add(ri4R, lk4));
        prod = Q.mul(prod, Q.sub(Q.ONE, frac));
      }
      gExact[i] = CQuad.mk(Quad.mk(prod, Q.ZERO), Quad.ZERO);
    }
    const A_GRVQ = Mat8K.diag(gExact);

    // Exact Maya diagonal
    const A_Maya = Mat8K.diag(Array.from({length:8}, (_,i) => KConsts.powZeta((this.m*i)%8)));

    // Exact Pauli operators
    const XK = Mat8K.create();
    for (let i=0; i<8; i++) Mat8K.set(XK, i, i^1, CQuad.ONE);
    const ZK = Mat8K.diag(this.hw3.map(r => KConsts.powZeta(r)));
    const XZK = Mat8K.mul(XK, ZK);
    const zeta2 = KConsts.powZeta(2);
    const YK = XZK.map(z => CQuad.mul(z, zeta2));
    const XpYpZK = Mat8K.add(Mat8K.add(XK, YK), ZK);
    const A_MST = Mat8K.scaleRat(XpYpZK, Q.mk(1n,5n)); // λ_B=1/5

    let H_pre = Mat8K.add(Mat8K.add(H_DRV, A_GRVQ), Mat8K.add(A_MST, A_Maya));
    const tr = Mat8K.trace(H_pre);
    this.traceH_exact = tr;

    // ZPE shift
    const minusEighth = Q.mk(-1n,8n);
    const zpe = CQuad.scaleRat(tr, minusEighth);
    for (let i=0; i<8; i++) {
      const old = Mat8K.get(H_pre,i,i);
      Mat8K.set(H_pre,i,i, CQuad.add(old, zpe));
    }
    this.H_exact = H_pre;

    // Exact exp(-H) in K for verification (MD §2.1)
    try {
      const negH_K = H_pre.map(z => CQuad.neg(z));
      this.expNegH_exact = Mat8K.exp(negH_K, 6);
      const eTr = Mat8K.trace(this.expNegH_exact);
      const [reK, imK] = CQuad.toFloatPair(eTr);
      const fTr = MAT8.trace(this.expNegH);
      this._traceDeviation = sqrt((reK-fTr[0])**2 + (imK-fTr[1])**2);
    } catch(e) { this.expNegH_exact = null; this._traceDeviation = -1; }
  },

  evolve() {
    this.psi8 = MAT8.mulVec(this.expNegH, this.psi8);
    // L² normalization (explicit projection boundary)
    let n2 = 0;
    for (let i = 0; i < 8; i++) n2 += CX.abs2(this.psi8[i]);
    this.normPsi = sqrt(n2);
    if (n2 > 1e-18 && isFinite(n2)) {
      const inv = 1 / sqrt(n2);
      for (let i = 0; i < 8; i++) this.psi8[i] = CX.scale(this.psi8[i], inv);
    }
  },

  // Sync ENGINE → VTX: map Ψ[0..7] → VTX.psi[0..7], complement → VTX.psi[8..15]
  syncToVTX() {
    if (this.coupling < 0.001) return;
    const s = this.coupling;
    for (let i = 0; i < 8; i++) {
      const val = this.psi8[i][0] * 5;
      const sgn = this.psi8[i][0] >= 0 ? 1 : -1;
      const mag = CX.abs(this.psi8[i]) * 5;
      const target_i = Q.mk(Bi(val * 1000), 1000n);
      const diff_i = Q.sub(target_i, VTX.psi[i]);
      VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff_i, Q.mk(Bi(s * 10000), 10000n)));
      // Antisymmetric complement
      const ci = i ^ 15;
      const target_c = Q.mk(Bi(-val * 1000), 1000n);
      const diff_c = Q.sub(target_c, VTX.psi[ci]);
      VTX.psi[ci] = Q.add(VTX.psi[ci], Q.mul(diff_c, Q.mk(Bi(s * 10000), 10000n)));
    }
  },

  // Sync VTX → ENGINE: bidirectional feedback (2% VTX influence)
  syncFromVTX() {
    if (this.coupling < 0.001) return;
    const fb = 0.12 * this.coupling; // raised from 0.02: 5% feedback (was 2%)
    for (let i = 0; i < 8; i++) {
      const vtxVal = Q.fl(VTX.psi[i]);
      if (isFinite(vtxVal)) {
        this.psi8[i] = CX.add(this.psi8[i], CX.scale(CX.mk(vtxVal * 0.2, 0), fb));
      }
    }
  },

  // Accumulate sutra displacement into ENGINE state
  // Called once per frame AFTER all sutras execute
  accumulateSutras() {
    // Measure VTX displacement since last accumulation
    for (let i = 0; i < 8; i++) {
      const vtxVal = Q.fl(VTX.psi[i]);
      if (isFinite(vtxVal)) {
        this.sutraAccum[i] += vtxVal;
      }
    }
    this.accumFrames++;
    
    // Every 10 frames: drain accumulator into ENGINE psi8
    // This gives sutras 10 frames to build coherent patterns
    if (this.accumFrames >= 10) {
      const scale = 0.02 * this.coupling; // 2% of coupling per drain
      for (let i = 0; i < 8; i++) {
        const avg = this.sutraAccum[i] / this.accumFrames;
        if (isFinite(avg)) {
          // Inject sutra average as real component perturbation
          this.psi8[i] = CX.add(this.psi8[i], CX.mk(avg * scale, 0));
        }
        this.sutraAccum[i] = 0;
      }
      this.accumFrames = 0;
      
      // Re-normalize after injection
      let n2 = 0;
      for (let i = 0; i < 8; i++) n2 += CX.abs2(this.psi8[i]);
      if (n2 > 1e-18 && isFinite(n2)) {
        const inv = 1 / Math.sqrt(n2);
        for (let i = 0; i < 8; i++) this.psi8[i] = CX.scale(this.psi8[i], inv);
      }
    }
  },

  rebuild() {
    this.computeGvals();
    this.buildHamiltonian();
  },

  status() {
    const mags = this.psi8.map(z => CX.abs(z));
    const maxI = mags.indexOf(max(...mags));
    const ph = atan2(this.psi8[maxI][1], this.psi8[maxI][0]) * 180 / PI;
    return `ENG8: max|Ψ${maxI}|=${mags[maxI].toFixed(3)} φ=${floor(ph)}° ZPE=${this.zpe[0].toFixed(3)}`;
  }
};
// ═══════════════════════════════════════════════════════════════════════════════
// §4 MSTVQ — Maxwell Stress Tensor (Simulation-Scale)
//
// CANONICAL FORMULA: T_ij = B_i·B_j/μ₀ - ½δ_ij|B|²/μ₀ + ℏ_m·sin(|B|/B_tensor)·δ_ij
//   The dyadic and isotropic terms are the textbook Maxwell stress tensor.
//   The sinusoidal term is the Vedic quantum correction evaluated EXACTLY
//   via QTaylor.sin() in ℚ (rational Taylor series, no IEEE-754 contamination).
//
// PHYSICAL CONSTANTS (exact rational from C module):
//   μ₀ = C.mu0 = 1256637/10¹²  (4π×10⁻⁷ H/m)
//   B_tensor = μ₀ × 10³⁶       (magnetic quantum threshold)
//   ℏ_m = B_tensor × 10⁻¹⁵     (magnetic Planck unit)
//
// DUAL COMPUTATION:
//   computeExact() — full 3×3 tensor in ℚ via QTaylor.sin()
//   compute()      — float projection using physical constants for rendering
// ═══════════════════════════════════════════════════════════════════════════════
const MSTVQ = {
  // ═══ PHYSICAL CONSTANTS (from canonical spec) ═══
  // μ₀ = 4π×10⁻⁷ H/m — permeability of free space
  mu0_physical: 4 * PI * 1e-7,
  // B_tensor = μ₀ × 10³⁶ — magnetic tensor scaling
  B_tensor_physical: 4 * PI * 1e-7 * 1e36,  // ≈ 1.257×10³⁰
  // ℏ_m = B_tensor × 10⁻¹⁵ — magnetic Planck scale
  h_m_physical: 4 * PI * 1e-7 * 1e36 * 1e-15,  // ≈ 1.257×10¹⁵

  // ═══ SIMULATION-SCALE NOTE ═══
  // Physical constants are wired via initExact() from C module (exact rationals).
  // Float compute() uses physical mu0_physical, B_tensor_physical, h_m_physical.
  // Exact computeExact() uses mu0_exact, B_tensor_exact, h_m_exact via QTaylor.sin().
  T: new Float64Array(9), // 3×3 float projection for rendering
  T_exact: null,          // 3×3 array of Rat for exact computation
  B: [0, 0, 0],
  B_exact: [null, null, null], // Rat B-field components

  // ── EXACT RATIONAL CONSTANTS (wired from C module) ──
  mu0_exact: null,      // C.mu0 = 1256637/10¹²
  B_tensor_exact: null,  // μ₀ × 10³⁶
  h_m_exact: null,       // B_tensor × 10⁻¹⁵

  initExact() {
    this.mu0_exact = C.mu0;
    this.B_tensor_exact = Q.mul(C.mu0, Q.mk(10n ** 36n));
    this.h_m_exact = Q.mul(this.B_tensor_exact, Q.mk(1n, 10n ** 15n));
    this.T_exact = Array.from({length: 9}, () => Q.ZERO);
    this.B_exact = [Q.ZERO, Q.ZERO, Q.ZERO];
  },

  setB(theta, phi, strength) {
    // Float layer (for rendering)
    this.B[0] = strength * sin(theta) * (1 + 0.5 * cos(phi));
    this.B[1] = strength * cos(theta) * sin(phi);
    this.B[2] = strength * sin(phi) * (1 + 0.3 * sin(theta));
    // Exact rational layer
    const scale = 1000000n;
    for (let i = 0; i < 3; i++) {
      this.B_exact[i] = Q.mk(Bi(this.B[i] * Number(scale)), scale);
    }
  },

  // ── EXACT COMPUTATION in ℚ ──
  // T_ij = B_i·B_j/μ₀ - ½δ_ij|B|²/μ₀ + ℏ_m·sin(|B|/B_tensor)·δ_ij
  // sin() evaluated via QTaylor.sin() — order 4 sufficient for |B|/B_tensor ≈ 10⁻³⁰
  computeExact() {
    if (!this.mu0_exact) this.initExact();
    const Bx = this.B_exact[0], By = this.B_exact[1], Bz = this.B_exact[2];
    const B_sq = Q.add(Q.add(Q.mul(Bx,Bx), Q.mul(By,By)), Q.mul(Bz,Bz));
    const B_mag = QTaylor.sqrt(B_sq);
    const mu_inv = Q.div(Q.ONE, this.mu0_exact);
    // Vedic quantum correction: ℏ_m · sin(|B| / B_tensor)
    const sinArg = Q.div(B_mag, this.B_tensor_exact);
    const sinVal = QTaylor.sin(sinArg, 4);
    const vedic = Q.mul(this.h_m_exact, sinVal);
    const Bv = [Bx, By, Bz];
    for (let i = 0; i < 3; i++) {
      for (let j = 0; j < 3; j++) {
        const idx = i * 3 + j;
        const dyadic = Q.mul(Q.mul(Bv[i], Bv[j]), mu_inv);
        const isotropic = (i === j) ? Q.neg(Q.mul(Q.HALF, Q.mul(B_sq, mu_inv))) : Q.ZERO;
        const vedic_diag = (i === j) ? vedic : Q.ZERO;
        this.T_exact[idx] = Q.add(Q.add(dyadic, isotropic), vedic_diag);
      }
    }
    return this.T_exact;
  },

  compute() {
    // Per-frame rendering path — NATURAL UNITS (μ₀ = 1, c = 1)
    // This is a legitimate unit system choice (Gaussian/Heaviside-Lorentz),
    // NOT a simplification. Physical SI constants are in computeExact().
    //
    // In natural units: T_ij = B_i·B_j - ½δ_ij|B|² + ℏ_m·sin(|B|/B_tensor)·δ_ij
    const Bx = this.B[0], By = this.B[1], Bz = this.B[2];
    const B_sq = Bx * Bx + By * By + Bz * Bz;
    const B_mag = sqrt(B_sq);
    // Vedic perturbation: ℏ_m · sin(|B| / B_tensor) — physical ratio preserved
    const perturb = this.h_m_physical * sin(B_mag / this.B_tensor_physical);
    const mu_inv = 1.0; // Natural units: μ₀ = 1

    const Bv = [Bx, By, Bz];
    for (let i = 0; i < 3; i++) {
      for (let j = 0; j < 3; j++) {
        const idx = i * 3 + j;
        const dyadic = Bv[i] * Bv[j] * mu_inv;
        const isotropic = (i === j) ? -0.5 * B_sq * mu_inv : 0;
        const diag_perturb = (i === j) ? perturb : 0;
        this.T[idx] = dyadic + isotropic + diag_perturb;
      }
    }
    return this.T;
  },

  trace() { return this.T[0] + this.T[4] + this.T[8]; },
  traceExact() {
    if (!this.T_exact || !this.T_exact[0]) return Q.ZERO;
    return Q.add(Q.add(this.T_exact[0], this.T_exact[4]), this.T_exact[8]);
  },
  norm() { let s = 0; for (let i = 0; i < 9; i++) s += this.T[i] * this.T[i]; return sqrt(s); },

  // FEEDBACK: MSTVQ trace modulates TGCR κ and feeds stress into λ
  // Called from main loop after compute() — closes the feedback loop
  feedbackToTGCR() {
    const tr = this.trace();
    // Soft-saturate trace to [-1,1] for stable κ modulation
    const trNorm = tr / (1 + abs(tr));
    // MSTVQ stress stiffens/softens cymatic spring
    TGCR.kappa = max(0.1, min(10.0, TGCR.kappa + trNorm * 0.2));
  },

  // FEEDBACK: stress tensor diagonal feeds into λ as exact rational perturbation
  feedbackToLambda(lambda) {
    for (let k = 0; k < min(3, lambda.length); k++) {
      // T_kk diagonal element — soft-saturated
      const Tkk = this.T[k * 3 + k];
      const contribution = Tkk / (1 + abs(Tkk)) * 0.005; // raised 5×
      if (isFinite(contribution) && abs(contribution) > 1e-12) {
        lambda[k] = Q.add(lambda[k], Q.mk(Bi(contribution * 1000), 1000000n));
      }
    }
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §5 TGCR — Toroidal Gravity Cymatic Resonance
//
// Energy functional: ℰ = ½|∇×v|² + ½κ|v|² + η·v·(∇×v)
// Beltrami flow: ∇×v = λv (eigenflow: vorticity ∥ velocity)
// Helical phase lock: θ/(3a) = 1 → cancels 1/r divergence at vortex core

// ═══════════════════════════════════════════════════════════════════════════════
// §4b  MAGNETIC FIELD DYNAMICS — Discrete Exterior Calculus on 4-Cube
//
// MATHEMATICAL FRAMEWORK:
//   The tesseract has 16 vertices, 32 edges, 24 square faces, 8 cubes.
//   We use DEC (Discrete Exterior Calculus) with proper form degrees:
//
//   0-forms: Ψ[16] — scalar field on vertices (already exists)
//   1-forms: A[32] — vector potential on oriented edges
//   2-forms: B[24] — magnetic flux on oriented faces
//
//   OPERATORS:
//   d⁰: 0-forms → 1-forms  (gradient): (d⁰Ψ)_e = Ψ(head) - Ψ(tail)
//   d¹: 1-forms → 2-forms  (curl):     (d¹A)_f = Σ_{e∈∂f} A_e  (Stokes)
//
//   KEY IDENTITY: d¹∘d⁰ = 0  (Poincaré lemma: curl(grad) ≡ 0)
//   Therefore B = d¹A is nonzero ONLY if A has non-gradient components.
//
//   A evolves via discrete induction + vortex source terms.
//   The vortex/TGCR terms inject non-gradient 1-forms into A.
//
// EDGE INDEXING: 32 edges = 4 axes × 8 edges per axis
//   For axis a∈{0,1,2,3}: edge connects v to v|(1<<a) where bit a of v is 0.
//   A[a*8 + edgeIdx(v,a)] stores the 1-form value.
//
// FACE INDEXING: 24 faces = 6 axis-pairs × 4 faces per pair
//   For axes (a<b): face has base vertex with bits a,b both 0.
//   Other 2 bits take 4 values → 4 faces per pair. C(4,2)×4 = 24.
//
// FACE CIRCULATION (Stokes theorem):
//   B_face = A[base,a] + A[base^(1<<a),b] - A[base^(1<<b),a] - A[base,b]
//   This is ∮_{∂F} A·dl computed exactly on the discrete mesh.
//
// HODGE STAR (2-form → 3D pseudo-vector at vertices):
//   Axis pair (0,1) →  ê_z    Axis pair (0,2) → -ê_y
//   Axis pair (1,2) →  ê_x    Axis pair (0,3) →  projected
//   Axis pair (1,3) →  projected  Axis pair (2,3) → projected
//
// HELICITY: H = Σ_edges A_e · B̄_e (signed — can be positive or negative)
//   where B̄_e = average of B on faces incident to edge e.
//   This is the discrete Chern-Simons functional.
//
// LORENTZ FORCE: F_i = Σ_{e∋i} (dΨ/dt)_e × B̄_e
//   Proper cross product of edge velocity with edge-averaged B.
//
// MAGNETIC PRESSURE: P = |B|²/(2μ_sim) with μ_sim = 1 (simulation scale)
// ═══════════════════════════════════════════════════════════════════════════════
const MAGFIELD = {
  // 1-form: vector potential on 32 oriented edges
  // Layout: A[axis * 8 + localIdx] where localIdx enumerates base vertices
  A: new Float64Array(32),
  // 2-form: magnetic flux on 24 oriented faces
  // Layout: Bface[pairIdx * 4 + localIdx]
  Bface: new Float64Array(24),
  // Aggregated 3D B-vector at each vertex (via Hodge star)
  Bvec: Array.from({length:16}, () => [0,0,0]),
  B: new Float64Array(16),       // |B| at each vertex
  prevPsi: new Float64Array(16), // previous frame Ψ for dΨ/dt
  dPsi: new Float64Array(16),    // time derivative
  lorentz: new Float64Array(16), // Lorentz force magnitude per vertex
  helicity: 0,                   // Chern-Simons helicity (SIGNED)
  pressure: 0,                   // mean magnetic pressure (simulation-scale μ=1)
  totalB: 0,
  curlMag: 0,                    // face-to-face B variation
  reconnectCount: 0,
  reconnectEnergy: 0,
  active: true, // enabled by default: B-field drives atmosphere + surface

  // Axis pair → 3D pseudo-vector direction (Hodge star)
  // Standard: (a,b) → ê_{4-a-b...} but for 4D→3D projection:
  hodge: [
    [0, 0, 1],        // pair 0: axes(0,1) → +z
    [0, -1, 0],       // pair 1: axes(0,2) → -y
    [0, -0.5, 0.5],   // pair 2: axes(0,3) → projected
    [1, 0, 0],        // pair 3: axes(1,2) → +x
    [0.5, 0, -0.5],   // pair 4: axes(1,3) → projected
    [-0.5, 0.5, 0],   // pair 5: axes(2,3) → projected
  ],

  // 6 axis pairs: [a, b] with a < b
  axisPairs: [[0,1],[0,2],[0,3],[1,2],[1,3],[2,3]],

  // Map base vertex to local index (0-7) for a given axis pair
  // Base vertex has bits a,b both 0 → other 2 bits free → 4 values
  edgeLocalIdx(v, axis) {
    // v must have bit `axis` clear. Pack remaining 3 bits into 0-7.
    // Simple: just use the vertex index with bit `axis` guaranteed 0
    // Since there are exactly 8 such vertices per axis, use lookup
    let idx = 0, shift = 0;
    for (let b = 0; b < 4; b++) {
      if (b === axis) continue;
      if (v & (1 << b)) idx |= (1 << shift);
      shift++;
    }
    return idx;
  },

  faceLocalIdx(v, a, b) {
    // v must have bits a,b both 0. Pack remaining 2 bits.
    let idx = 0, shift = 0;
    for (let bit = 0; bit < 4; bit++) {
      if (bit === a || bit === b) continue;
      if (v & (1 << bit)) idx |= (1 << shift);
      shift++;
    }
    return idx;
  },

  // Get A value for edge (base → base|(1<<axis))
  getA(base, axis) {
    return this.A[axis * 8 + this.edgeLocalIdx(base, axis)];
  },
  setA(base, axis, val) {
    this.A[axis * 8 + this.edgeLocalIdx(base, axis)] = val;
  },

  // Get B value for face with given axis pair and base
  getBface(pairIdx, base, a, b) {
    return this.Bface[pairIdx * 4 + this.faceLocalIdx(base, a, b)];
  },
  setBface(pairIdx, base, a, b, val) {
    this.Bface[pairIdx * 4 + this.faceLocalIdx(base, a, b)] = val;
  },

  update() {
    if (!this.active) return;
    const coupling = AMP.bfield;
    const psi = VTX.psi.map(p => Q.fl(p));

    // ── STEP 1: Compute dΨ/dt ──
    for (let i = 0; i < 16; i++) {
      this.dPsi[i] = psi[i] - this.prevPsi[i];
      this.prevPsi[i] = psi[i];
    }

    // ── STEP 2: Evolve vector potential A (discrete induction) ──
    // A evolves from two sources:
    //   (a) Faraday induction: ∂A/∂t += -d⁰(dΨ/dt) [gradient of field velocity]
    //   (b) Vortex source: non-gradient injection from TGCR vortex
    // Source (b) is what makes d¹A ≠ 0 (creates magnetic flux)
    const vo = vortexOmega;
    for (let axis = 0; axis < 4; axis++) {
      for (let v = 0; v < 16; v++) {
        if (v & (1 << axis)) continue; // only base vertices (bit=0)
        const head = v | (1 << axis);
        const localIdx = this.edgeLocalIdx(v, axis);
        const aIdx = axis * 8 + localIdx;

        // (a) Faraday: ∂A/∂t += -(dΨ/dt at head - dΨ/dt at tail)
        const faraday = -(this.dPsi[head] - this.dPsi[v]) * 0.1;

        // (b) Vortex source: toroidal induction (non-gradient!)
        // On the torus, the poloidal and toroidal directions create
        // non-contractible loops. Vortex rotation along θ induces
        // A along φ-direction edges. This is genuinely non-gradient
        // because the torus has nontrivial first homology H₁(T²) = Z².
        // Map axis to toroidal contribution:
        //   axes 0,1 ≈ poloidal, axes 2,3 ≈ toroidal
        // CRITICAL: induction must VARY by vertex to produce non-zero B=curl(A)
        // Uniform A → curl(A)=0 identically. Use Hamming weight for position-dependent coupling.
        const hw = VTX.hw(v);
        const posModulation = 1 + 0.3 * Math.sin(hw * 1.571 + axis * 0.785); // π/2 and π/4 offsets
        const toroidal = (axis >= 2) ? vo * 0.06 * posModulation : 0;
        const poloidal = (axis < 2) ? vo * TGCR.eta * 0.03 * posModulation : 0;

        // Decay + accumulate
        this.A[aIdx] = this.A[aIdx] * 0.998 + (faraday + toroidal + poloidal) * coupling; // longer B memory
      }
    }

    // ── STEP 3: Compute B = d¹A on 24 faces (Stokes theorem) ──
    // For face (a,b,base): B = A[base,a] + A[base^a, b] - A[base^b, a] - A[base, b]
    this.totalB = 0;
    let totalBfaceSq = 0;

    for (let p = 0; p < 6; p++) {
      const [a, b] = this.axisPairs[p];
      const maskA = 1 << a, maskB = 1 << b, maskBoth = maskA | maskB;
      for (let v = 0; v < 16; v++) {
        if (v & maskBoth) continue; // only base vertices with bits a,b both 0
        // Stokes circulation: ∮_{∂F} A·dl
        const circ =
          this.getA(v, a) +               // edge: v → v^a (axis a, positive)
          this.getA(v ^ maskA, b) -        // edge: v^a → v^a^b (axis b, positive)
          this.getA(v ^ maskB, a) -        // edge: v^b → v^a^b (axis a, negative)
          this.getA(v, b);                 // edge: v → v^b (axis b, negative)
        this.setBface(p, v, a, b, circ);
        totalBfaceSq += circ * circ;
      }
    }

    // ── STEP 4: Hodge star — aggregate face B to vertex B vectors ──
    for (let i = 0; i < 16; i++) {
      let bx = 0, by = 0, bz = 0;
      for (let p = 0; p < 6; p++) {
        const [a, b] = this.axisPairs[p];
        // Face incident to vertex i: base = i with bits a,b cleared
        const base = i & ~((1 << a) | (1 << b));
        const Bf = this.getBface(p, base, a, b);
        // Hodge dual: 2-form → pseudo-vector
        const h = this.hodge[p];
        bx += Bf * h[0];
        by += Bf * h[1];
        bz += Bf * h[2];
      }
      // Each vertex incident to 6 faces; normalize
      bx /= 6; by /= 6; bz /= 6;
      this.Bvec[i] = [bx, by, bz];
      const Bmag = sqrt(bx*bx + by*by + bz*bz);
      this.B[i] = Bmag;
      this.totalB += Bmag;
    }

    // ── STEP 5: Magnetic pressure P = |B|²/(2μ_sim) ──
    // μ_sim = 1.0 (simulation scale, NOT physical μ₀)
    this.pressure = totalBfaceSq / (2 * 24); // average face B² / 2

    // ── STEP 6: Helicity H = Σ_edges A_e · B̄_e (SIGNED) ──
    // B̄_e = average B on faces incident to edge e, projected onto edge direction
    // This is the discrete Chern-Simons functional. Can be positive or negative.
    this.helicity = 0;
    for (let axis = 0; axis < 4; axis++) {
      for (let v = 0; v < 16; v++) {
        if (v & (1 << axis)) continue;
        const Ae = this.getA(v, axis);
        // Average B from incident faces (each edge borders 3 faces in 4-cube)
        let Bbar = 0, count = 0;
        for (let p = 0; p < 6; p++) {
          const [a, b] = this.axisPairs[p];
          if (a !== axis && b !== axis) continue; // face must contain this edge's axis
          const base = v & ~((1 << a) | (1 << b));
          Bbar += this.getBface(p, base, a, b);
          count++;
        }
        if (count > 0) Bbar /= count;
        this.helicity += Ae * Bbar; // SIGNED: Ae and Bbar both carry signs
      }
    }

    // ── STEP 7: Lorentz force F_i = Σ_{e∋i} v_e × B̄_e ──
    // v_e = (dΨ/dt at head - dΨ/dt at tail) along edge direction
    // Proper cross product in 3D
    for (let i = 0; i < 16; i++) {
      let fx = 0, fy = 0, fz = 0;
      for (let axis = 0; axis < 4; axis++) {
        const nb = i ^ (1 << axis);
        // Edge velocity vector: dΨ difference projected along axis direction
        const dv = this.dPsi[nb] - this.dPsi[i];
        // Direction vector for this axis (using Hodge-consistent mapping)
        const dir = [[1,0,0],[0,1,0],[0,0,1],[0.577,0.577,0.577]][axis];
        const vx = dv * dir[0], vy = dv * dir[1], vz = dv * dir[2];
        // B at midpoint of edge ≈ average of endpoint B
        const bx = (this.Bvec[i][0] + this.Bvec[nb][0]) * 0.5;
        const by = (this.Bvec[i][1] + this.Bvec[nb][1]) * 0.5;
        const bz = (this.Bvec[i][2] + this.Bvec[nb][2]) * 0.5;
        // v × B (proper cross product)
        fx += vy * bz - vz * by;
        fy += vz * bx - vx * bz;
        fz += vx * by - vy * bx;
      }
      this.lorentz[i] = sqrt(fx*fx + fy*fy + fz*fz);
    }

    // ── STEP 8: B-field non-uniformity (face-to-face variation) ──
    this.curlMag = 0;
    for (let p = 0; p < 6; p++) {
      const [a, b] = this.axisPairs[p];
      const maskBoth = (1 << a) | (1 << b);
      let sum = 0, count = 0;
      for (let v = 0; v < 16; v++) {
        if (v & maskBoth) continue;
        sum += abs(this.getBface(p, v, a, b));
        count++;
      }
      this.curlMag += count > 0 ? sum / count : 0;
    }
    this.curlMag /= 6; // average over axis pairs
  },

  // ── MAGNETIC RECONNECTION DETECTOR ──
  // Anti-parallel B at neighboring vertices that suddenly align.
  // Uses proper signed dot product of B vectors.
  detectReconnection() {
    if (!this.active) return;
    let events = 0, released = 0;

    for (let i = 0; i < 16; i++) {
      const Bi_ = this.Bvec[i];
      const BiMag = this.B[i];
      if (BiMag < 0.001) continue;
      const nbs = VTX.neighbors(i);
      for (const j of nbs) {
        if (j <= i) continue; // count each edge once
        const Bj = this.Bvec[j];
        const BjMag = this.B[j];
        if (BjMag < 0.001) continue;
        // Normalized dot product (signed)
        const dot = (Bi_[0]*Bj[0] + Bi_[1]*Bj[1] + Bi_[2]*Bj[2]) / (BiMag * BjMag);
        if (dot < -0.7) {
          events++;
          released += BiMag * BjMag * abs(dot + 1);
        }
      }
    }

    if (events > 0) {
      this.reconnectCount += events;
      this.reconnectEnergy = released;
    } else {
      this.reconnectEnergy *= 0.95;
    }
  },

  // ── LORENTZ FEEDBACK: inject force into vertex field ──
  applyLorentz() {
    if (!this.active || AMP.bfield < 0.01) return;
    const strength = AMP.bfield * 0.06; // raised 3×: Lorentz force now shapes field
    for (let i = 0; i < 16; i++) {
      const F = this.lorentz[i];
      if (F > 0.001 && isFinite(F)) {
        // Lorentz force direction from B vector sign
        const Bsign = (this.Bvec[i][0] + this.Bvec[i][1] + this.Bvec[i][2]) > 0 ? 1 : -1;
        const inject = Bsign * min(F, 10) * strength;
        if (abs(inject) < 20) {
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(inject * 10000), 10000n));
        }
      }
    }
  },

  // Feed vertex-averaged B into MSTVQ
  feedToMSTVQ() {
    if (!this.active) return;
    let bx = 0, by = 0, bz = 0;
    for (let i = 0; i < 16; i++) {
      bx += this.Bvec[i][0]; by += this.Bvec[i][1]; bz += this.Bvec[i][2];
    }
    MSTVQ.B[0] = bx / 16; MSTVQ.B[1] = by / 16; MSTVQ.B[2] = bz / 16;
    MSTVQ.compute();
    MSTVQ.feedbackToTGCR();
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §4c  JET PROPULSION MECHANISM
//
// Asymmetric field forcing on tesseract vertex subsets creates net
// momentum — analogous to a plasma jet or magnetic nozzle.
//
// NOZZLE: vertices with Hamming weight 0,1 (5 vertices: the "front")
// CHAMBER: vertices with Hamming weight 2 (6 vertices: the "body")
// EXHAUST: vertices with Hamming weight 3,4 (5 vertices: the "rear")
//
// Thrust = boost nozzle vertices, suppress exhaust → net field momentum
// The asymmetry creates visible directional torus deformation.
//
// JET MODES:
//   THERMAL: uniform boost to nozzle (like chemical rocket)
//   MAGNETIC: use B-field to collimate (like magnetohydrodynamic thruster)
//   VEDIC: use sutra operators asymmetrically (φ-ratio differential)
// ═══════════════════════════════════════════════════════════════════════════════
const JET = {
  thrust: 0,        // current thrust magnitude
  thrustDir: 0,     // direction (angle on torus)
  efficiency: 0,    // nozzle/exhaust ratio
  mode: 'thermal',  // 'thermal', 'magnetic', 'vedic'
  active: false,

  // Classify vertices by Hamming weight
  nozzle:  [0, 1, 2, 4, 8],                    // hw=0,1
  chamber: [3, 5, 6, 9, 10, 12],               // hw=2
  exhaust: [7, 11, 13, 14, 15],                // hw=3,4

  update() {
    if (!this.active || AMP.jet < 0.01) return;
    const strength = AMP.jet;
    const psi = VTX.psi.map(p => Q.fl(p));
    const t = simTime * 0.001;

    // Compute current thrust: net momentum along "nozzle axis"
    let nozzleE = 0, exhaustE = 0;
    for (const i of this.nozzle) nozzleE += psi[i] * psi[i];
    for (const i of this.exhaust) exhaustE += psi[i] * psi[i];
    this.thrust = nozzleE - exhaustE;
    this.efficiency = exhaustE > 0.01 ? nozzleE / exhaustE : 0;

    // ── THERMAL MODE: direct vertex boost ──
    // Boost nozzle vertices with oscillating driver, suppress exhaust
    const driver = sin(t * 0.5) * 0.5 + 0.5; // always positive, oscillating
    for (const i of this.nozzle) {
      const boost = strength * (1 + driver) * (1 + VTX.hw(i) * 0.3);
      VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(boost * 10000), 10000n));
    }
    for (const i of this.exhaust) {
      // Exhaust: drain energy (reaction force)
      const drain = strength * 0.3;
      const sign = Q.fl(VTX.psi[i]) > 0 ? -1 : 1;
      VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(sign * drain * 10000), 10000n));
    }

    // ── MAGNETIC MODE: B-field collimation ──
    if (this.mode === 'magnetic' && MAGFIELD.active) {
      // Vertices with strong B get extra boost in nozzle direction
      for (const i of this.nozzle) {
        const Bboost = MAGFIELD.B[i] * strength * 0.5;
        if (isFinite(Bboost) && abs(Bboost) < 20) {
          VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(Bboost * 10000), 10000n));
        }
      }
    }

    // ── VEDIC MODE: φ-ratio differential ──
    if (this.mode === 'vedic') {
      // Golden ratio scaling: nozzle boosted by φ, exhaust by 1/φ
      for (const i of this.nozzle) {
        const vBoost = strength * C.phi_f * 0.3;
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(vBoost * 10000), 10000n));
      }
      for (const i of this.exhaust) {
        const vDrain = strength * (1 / C.phi_f) * 0.15;
        const sign = Q.fl(VTX.psi[i]) > 0 ? -1 : 1;
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mk(Bi(sign * vDrain * 10000), 10000n));
      }
    }
  }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §4d  WORMHOLE FORMATION PROTOCOL
//
// A traversable wormhole on the toroidal hypercube requires:
//
// 1. COMPLEMENTARY PAIRING: Ψᵢ · Ψ_{comp(i)} < 0 for majority of pairs
//    → Each vertex and its bitwise complement have opposite field signs.
//    → This creates a field zero-crossing "throat" on the torus surface.
//    → SUTRAS: S5 (Śūnyam: zero-sum pairs), S22 (Dvandvayoga: complement balance)
//
// 2. THROAT CONCENTRATION: The zero-crossing must be LOCALIZED, not spread.
//    → Graph Laplacian smoothing concentrates the gradient at specific angles.
//    → S9 (Calana: diffusion), S27 (Gunitasamuccayah: pattern enforcement)
//
// 3. TOPOLOGICAL STABILITY: The throat must persist for N frames.
//    → Conservation operator prevents energy dissipation.
//    → S29 (Conservation), S26 (Dhvajāṅka: suppress weak, amplify dominant)
//
// 4. EXOTIC MATTER ANALOGUE: Negative energy density at throat.
//    → Need |Ψ_min/Ψ_max| < 0.4 with strong asymmetry.
//    → S23 (Antyayor: terminal complement pairs) reinforces this.
//
// 5. σ APPROACH: Suppression proximity (σ < 0.5) indicates throat.
//    → Achieved when λ values are small → σ→0 → geometry collapses.
//
// PROTOCOL: Activate specific sutras + modulate λ targets to drive formation.
// ═══════════════════════════════════════════════════════════════════════════════
const WORMHOLE_PROTO = {
