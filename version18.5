      // Adjust symmetrically so product remains constant.
      for (let axis = 0; axis < 4; axis++) {
        const mask = 1 << axis;
        for (let base = 0; base < 16; base++) {
          if (base & mask) continue;
          const i0 = base, i1 = base | mask;
          const v0 = VTX.psi[i0], v1 = VTX.psi[i1];
          const v0f = Q.fl(v0), v1f = Q.fl(v1);
          // Explicit zero check — no +0.001 safety
          if (v0f === 0) continue;
          // Exact ratio via ℚ division
          const ratio = Q.div(v1, v0);
          const ratioF = Q.fl(ratio);
          const err = ratioF - C.phi_f * (ratioF >= 0 ? 1 : -1);
          // Correction proportional to α·(ratio - φ), distributed symmetrically
          const correction = Q.mk(Bi(-err * α * abs(v0f + v1f) * 10000), 10000n);
          VTX.psi[i1] = Q.add(VTX.psi[i1], correction);
          VTX.psi[i0] = Q.sub(VTX.psi[i0], Q.div(correction, Q.mk(2n)));
        }
      }
      INTER_SUTRA.recordInteraction(6, 17);
      return `S6: PERM φ-ratio correction α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S7: Saṅkalana-Vyavakalanābhyām — "By addition and subtraction"
  // TYPE: PERMUTATIVE
  // Decomposes vertex field into symmetric (S) and antisymmetric (A) parts
  // along each axis. Drives toward balanced S/A decomposition.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:7, name:'Saṅkalana-Vyavakalanābhyām', sk:'संकलन', m:0, n:2, amp:0.5, freq:0.95, strength:0,
    desc:'PERMUTATIVE: symmetric/antisymmetric decomposition on each axis',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(7);
      // Catalogue: For each axis k, decompose (i,j=i⊕(1<<k)) into S=(Ψ_i+Ψ_j)/2, A=(Ψ_i-Ψ_j)/2
      // Drive ratio ||S||²/||A||² toward unity via δ = α(||S||²-||A||²)·A
      for (let axis = 0; axis < 4; axis++) {
        const mask = 1 << axis;
        for (let base = 0; base < 16; base++) {
          if (base & mask) continue;
          const i0 = base, i1 = base | mask;
          const S = Q.div(Q.add(VTX.psi[i0], VTX.psi[i1]), Q.mk(2n));
          const A = Q.div(Q.sub(VTX.psi[i0], VTX.psi[i1]), Q.mk(2n));
          // Exact norms: ||S||² and ||A||²
          const Ssq = Q.mul(S, S);
          const Asq = Q.mul(A, A);
          // Drive toward unity: δ = α·(||S||²-||A||²)·A
          const diff = Q.sub(Ssq, Asq);
          const delta = Q.mul(Q.mul(diff, A), Q.mk(Bi(α * 10000), 10000n));
          // Add δ to S, subtract from A, reconstruct Ψ_i = S+A, Ψ_j = S-A
          const newS = Q.add(S, delta);
          const newA = Q.sub(A, delta);
          VTX.psi[i0] = Q.add(newS, newA);
          VTX.psi[i1] = Q.sub(newS, newA);
        }
      }
      // No kappa clamp — GRVQ handles stability
      INTER_SUTRA.recordInteraction(7, 9);
      return `S7: PERM S/A decomp α=${sf(α,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S8: Pūraṇāpūraṇābhyām — "By completion or non-completion"
  // TYPE: DIVISIVE
  // Completes the quadratic form on vertex pairs.
  // For edge pair (i,j): finds minimum of Ψ²ᵢ + bΨᵢ + c via completion.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:8, name:'Pūraṇāpūraṇābhyām', sk:'पूरणा', m:3, n:1, amp:0.4, freq:0.85, strength:0,
    desc:'DIVISIVE: complete the square on vertex-pair quadratic forms',
    evolve(dt) {
      const α = SUPPRESS.alphaPhi(8);
      // Catalogue: For each vertex i and axis k, j=i⊕(1<<k).
      // Quadratic p: p(-1)=Ψ_j, p(0)=Ψ_i, p(1)=Ψ_j → extremum at x=0: ½(Ψ_i+Ψ_j)
      // Average minimisers over 4 axes, pull with α/4
      for (let i = 0; i < 16; i++) {
        let miniSum = Q.ZERO;
        for (let axis = 0; axis < 4; axis++) {
          const j = i ^ (1 << axis);
          // Minimiser of quadratic through (-1,Ψ_j), (0,Ψ_i), (1,Ψ_j) = ½(Ψ_i + Ψ_j)
          miniSum = Q.add(miniSum, Q.div(Q.add(VTX.psi[i], VTX.psi[j]), Q.mk(2n)));
        }
        // Average of 4 minimisers
        const miniMean = Q.div(miniSum, Q.mk(4n));
        const diff = Q.sub(miniMean, VTX.psi[i]);
        // Pull toward mean minimiser with weight α/4
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diff, Q.mk(Bi(α * 2500), 10000n)));
      }
      INTER_SUTRA.recordInteraction(8, 10);
      return `S8: DIV quadratic completion α=${sf(α,4)}`;
    }},

