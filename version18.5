      for (let i = 0; i < 8; i++) { // 8 complementary pairs
        const j = VTX.comp(i);
        const targetI = Q.neg(VTX.psi[j]); // Ψᵢ should equal -Ψⱼ
        const targetJ = Q.neg(VTX.psi[i]);
        const diffI = Q.sub(targetI, VTX.psi[i]);
        const diffJ = Q.sub(targetJ, VTX.psi[j]);
        VTX.psi[i] = Q.add(VTX.psi[i], Q.mul(diffI, Q.mk(Bi(α * 10000), 10000n)));
        VTX.psi[j] = Q.add(VTX.psi[j], Q.mul(diffJ, Q.mk(Bi(α * 10000), 10000n)));
      }
      let pairSum = 0;
      for (let i = 0; i < 8; i++) pairSum += abs(Q.fl(Q.add(VTX.psi[i], VTX.psi[VTX.comp(i)])));
      INTER_SUTRA.recordInteraction(5, 29);
      return `S5: REFL Σ|Ψᵢ+Ψ_c|=${sf(pairSum,3)} α=${sf(α,4)} δλ₁=${sf(grvq,4)}`;
    }},

  // ═══════════════════════════════════════════════════════════════════════════
  // S6: Ānurūpye Śūnyamanyat — "If one ratio, the other is zero"
  // TYPE: PERMUTATIVE
  // Ratio-preserving rotation: pairs (i, j) on same edge maintain ratio.
  // Vertices with broken proportion get corrected toward geometric coherence.
  // ═══════════════════════════════════════════════════════════════════════════
  { id:6, name:'Ānurūpye Śūnyamanyat', sk:'आनुरूप्ये', m:2, n:0, amp:0.35, freq:1.1, strength:0,
    desc:'PERMUTATIVE: enforce proportionality along tesseract edges',
