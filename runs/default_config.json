{
  "simulation": {
    "name": "GRVQ-MSTVQ-TGCR Cymatic Simulation",
    "version": "1.0.0",
    "codex_version": "CODEX_GRVQ_MSTVQ_TGCR_v1"
  },
  "lattice": {
    "type": "toroidal_hypercube",
    "dimensions": [32, 32, 32],
    "r4_radius": 2
  },
  "initial_condition": {
    "type": "gaussian",
    "center": [16, 16, 16],
    "sigma": 4.0,
    "amplitude": 1.0
  },
  "arithmetic": {
    "mode": "exact",
    "precision_limit": 1000000000
  },
  "evolution": {
    "num_steps": 100,
    "dt": "1/100",
    "checkpoint_interval": 10
  },
  "operators": {
    "grvq": {
      "enabled": true,
      "shape_modes": [[1, 1], [2, 1], [2, 2]],
      "coefficients": ["1/10", "1/20", "1/30"]
    },
    "mstvq": {
      "enabled": true,
      "h_m": "1",
      "stress_coupling": "1/10",
      "tension_coupling": "1/10"
    },
    "r4": {
      "enabled": true,
      "coupling_strength": "1/10",
      "coherence_threshold": "1/100"
    },
    "sutras": {
      "enabled": true,
      "sequence": [1, 3, 5, 7, 9, 11, 13]
    }
  },
  "quantum_assist": {
    "enabled": true,
    "seed": 42,
    "max_shards": 8,
    "enable_coefficient_tuning": true,
    "enable_mode_selection": true,
    "enable_phase_template": true
  },
  "observables": {
    "compute": true,
    "export_format": "json",
    "include_fields": false
  },
  "invariants": {
    "check": true,
    "fail_fast": true,
    "max_field_bound": "1000"
  },
  "trace": {
    "enabled": true,
    "checkpoint_interval": 10
  },
  "output": {
    "directory": "runs/output",
    "save_final_state": true,
    "save_observables": true,
    "save_trace": true
  }
}
