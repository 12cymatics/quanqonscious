};

// ═══════════════════════════════════════════════════════════════════════════════
// §7 R4 FIELD STATE — EXACT BigInt Rational (ULTRATHINK CORE)
// ═══════════════════════════════════════════════════════════════════════════════
// 
// This is the EXACT computational core
// R⁴ = ∏ₖ λₖ⁴/(r⁴+λₖ⁴)
// All operations use Rat arithmetic — ZERO IEEE-754
// 

const R4 = {
    lambda: [Rat.fromInt(1), Rat.fromInt(2), Rat.fromInt(3), Rat.fromInt(4)],
    r: Rat.fromInt(1),
    value: Rat.mk(0n),
    
    // EXACT computation — no floats
    compute() {
        const r4 = Rat.pow(this.r, 4n);
        let prod = Rat.fromInt(1);
        for (let k = 0; k < 4; k++) {
            const lk4 = Rat.pow(this.lambda[k], 4n);
            const denom = Rat.add(r4, lk4);
            if (denom.n !== 0n) {
                prod = Rat.mul(prod, Rat.div(lk4, denom));
            }
        }
        this.value = prod;
        return prod;
    },
    
    // Render coupling (IEEE-754 for display only)
    getFieldCoupling() {
        const energy = CYMATIC.energy();
        let fc = energy * 0.001;
        if (fc > 1) fc = 1;
        return fc;
    },
    
    getGCoupling() {
        return this.getFieldCoupling() * abs(Rat.toFloatForRendering(this.value));
    },
    
    reset() {
        this.lambda = [Rat.fromInt(1), Rat.fromInt(2), Rat.fromInt(3), Rat.fromInt(4)];
        this.r = Rat.fromInt(1);
        this.compute();
    }
};

