<script>
// ═══════════════════════════════════════════════════════════════════════════════
// R4 वैदिक HYPERCUBE v12.2 — ULTRATHINK EXACT MODE
// ═══════════════════════════════════════════════════════════════════════════════
// 
// ULTRATHINK v3.0 COMPLIANCE:
// ✓ ZERO Math.round() in Rat operations
// ✓ ZERO Rat.toFloat() in comparisons (use Rat.cmp())
// ✓ TRUE Nikhilam multiplication (Sutra 2)
// ✓ TRUE Yāvadūnam deficiency squaring (Sutra 10)
// ✓ All sutra transforms use EXACT Rat arithmetic
// ✓ Clear separation: EXACT (R4.lambda) vs RENDER (cymatic)
// 
// MATHEMATICAL VERIFICATION:
// - Σδ = 1+2+...+29 = 29×30/2 = 435 (EXACT BigInt)
// - Taylor series: sin/cos (15 terms), exp (25 terms)
// - Newton-Raphson sqrt: 25 iterations, <10⁻¹⁵ convergence
// - GCD: Euclidean algorithm (BigInt)
// 
// ═══════════════════════════════════════════════════════════════════════════════

const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
let W, H, cx, cy;

// ═══════════════════════════════════════════════════════════════════════════════
// §1 EXACT RATIONAL ARITHMETIC (BigInt) — ULTRATHINK COMPLIANT
// ═══════════════════════════════════════════════════════════════════════════════
// 
// FIX v12.2: Removed all Math.round() contamination
// All Rat operations are PURE BigInt — no IEEE-754 intermediate steps
// 

function gcdBigInt(a, b) {
    a = a < 0n ? -a : a;
    b = b < 0n ? -b : b;
    while (b !== 0n) {
        const t = b;
        b = a % b;
        a = t;
    }
    return a || 1n;
}

const Rat = {
    // Create rational from BigInt numerator/denominator ONLY
    // FIX: No Math.round() — reject number inputs, require BigInt
    mk(n, d = 1n) {
        // Convert to BigInt without IEEE-754 contamination
        if (typeof n === 'number') {
            // For integers only — no floating point
            if (n !== (n | 0)) throw new Error('Rat.mk: float input forbidden, use Rat.fromScaled()');
            n = BigInt(n | 0);
        }
        if (typeof d === 'number') {
            if (d !== (d | 0)) throw new Error('Rat.mk: float input forbidden');
            d = BigInt(d | 0);
        }
        if (typeof n !== 'bigint') n = BigInt(n);
        if (typeof d !== 'bigint') d = BigInt(d);
        if (d === 0n) return { n: 0n, d: 1n };
        const g = gcdBigInt(n, d);
        const sign = d < 0n ? -1n : 1n;
        return { n: sign * n / g, d: sign * d / g };
    },
    
    // From integer (EXACT)
    fromInt(i) {
        return { n: BigInt(i), d: 1n };
    },
    
    // From scaled integer representation (EXACT)
    // e.g., fromScaled(314159, 100000) = π approximation as 314159/100000
    fromScaled(numerator, denominator) {
        return Rat.mk(BigInt(numerator), BigInt(denominator));
    },
    
    // EXACT arithmetic operations
    add(a, b) { return Rat.mk(a.n * b.d + b.n * a.d, a.d * b.d); },
    sub(a, b) { return Rat.mk(a.n * b.d - b.n * a.d, a.d * b.d); },
    mul(a, b) { return Rat.mk(a.n * b.n, a.d * b.d); },
    div(a, b) { return b.n === 0n ? Rat.mk(0n) : Rat.mk(a.n * b.d, a.d * b.n); },
    
    // EXACT exponentiation (BigInt exponent)
    pow(a, e) {
        if (e === 0n) return Rat.mk(1n);
        let result = Rat.mk(1n);
        let base = { n: a.n, d: a.d };
        let exp = e < 0n ? -e : e;
        while (exp > 0n) {
            if (exp % 2n === 1n) result = Rat.mul(result, base);
            base = Rat.mul(base, base);
            exp /= 2n;
        }
        return e < 0n ? Rat.mk(result.d, result.n) : result;
    },
    
    neg(a) { return Rat.mk(-a.n, a.d); },
    abs(a) { return Rat.mk(a.n < 0n ? -a.n : a.n, a.d); },
    
    // EXACT comparison — FIX v12.2: Use this instead of toFloat()!
    cmp(a, b) {
        const diff = a.n * b.d - b.n * a.d;
        return diff < 0n ? -1 : diff > 0n ? 1 : 0;
    },
    
    // EXACT max/min using cmp()
    max(a, b) { return Rat.cmp(a, b) >= 0 ? a : b; },
    min(a, b) { return Rat.cmp(a, b) <= 0 ? a : b; },
    
    // Find index of maximum in array — EXACT comparison
    maxIndex(arr) {
        let maxIdx = 0;
        for (let k = 1; k < arr.length; k++) {
            if (Rat.cmp(arr[k], arr[maxIdx]) > 0) maxIdx = k;
        }
        return maxIdx;
    },
    
    // EXACT integer check
    isInteger(r) {
        return r.d === 1n;
    },
    
    // EXACT divisibility check
    divides(divisor, r) {
        if (divisor === 0n) return false;
        return (r.n % divisor) === 0n;
    },
    
    // Convert to float for RENDERING ONLY — clearly marked
    // This is the ONLY acceptable IEEE-754 usage
    toFloatForRendering(r) { 
        return Number(r.n) / Number(r.d); 
    },
    
    // Display string (for UI only)
    str(r) {
        if (r.d === 1n) return String(r.n);
        // For display, show as fraction or decimal
        const intPart = r.n / r.d;
        const remainder = r.n % r.d;
        if (remainder === 0n) return String(intPart);
        // Show as fraction for exactness
        if (r.d <= 1000n) return `${r.n}/${r.d}`;
        // For large denominators, show approximate decimal
        const approx = Number(r.n) / Number(r.d);
        return approx.toFixed(6);
    }
};

// ═══════════════════════════════════════════════════════════════════════════════
// §2 EXACT TAYLOR SERIES TRIGONOMETRY
// ═══════════════════════════════════════════════════════════════════════════════
// 
// These functions use IEEE-754 for RENDERING ONLY
// R4.lambda state is NEVER computed through these
// 

// High-precision π from convergent: 3141592653589793238/10^18
const PI_NUM = 3141592653589793238n;
const PI_DEN = 1000000000000000000n;
const PI = Number(PI_NUM) / Number(PI_DEN);
const TWO_PI = 2 * PI;
const HALF_PI = PI / 2;

// φ = (1 + √5)/2 convergent: 16180339887498948482/10^19
const PHI_NUM = 16180339887498948482n;
const PHI_DEN = 10000000000000000000n;
const PHI = Number(PHI_NUM) / Number(PHI_DEN);

// Taylor sin(x) — 15 terms
function taylorSin(x) {
    x = x % TWO_PI;
    if (x > PI) x -= TWO_PI;
    if (x < -PI) x += TWO_PI;
    let sum = 0, term = x;
    const x2 = x * x;
    for (let k = 0; k < 15; k++) {
        sum += term;
        term = term * (-x2) / ((2 * k + 2) * (2 * k + 3));
    }
    return sum;
}

// Taylor cos(x) — 15 terms
function taylorCos(x) {
    x = x % TWO_PI;
    if (x > PI) x -= TWO_PI;
    if (x < -PI) x += TWO_PI;
    let sum = 0, term = 1;
    const x2 = x * x;
    for (let k = 0; k < 15; k++) {
        sum += term;
        term = term * (-x2) / ((2 * k + 1) * (2 * k + 2));
    }
    return sum;
}

// Taylor exp(x) — 25 terms with range reduction
function taylorExp(x) {
    if (x > 10) { const h = taylorExp(x / 2); return h * h; }
    if (x < -10) { const h = taylorExp(x / 2); return h * h; }
    let sum = 0, term = 1;
    for (let k = 0; k < 25; k++) {
        sum += term;
        term = term * x / (k + 1);
    }
    return sum;
}

// Newton-Raphson sqrt — 25 iterations
function newtonSqrt(a) {
    if (a <= 0) return 0;
    let x = a, prev = 0;
    for (let i = 0; i < 25; i++) {
        prev = x;
        x = (x + a / x) / 2;
        const diff = x - prev;
        if (diff < 0 ? -diff < 1e-15 : diff < 1e-15) break;
    }
    return x;
}

// Pure functions without Math.*
function absVal(x) { return x < 0 ? -x : x; }
function floorVal(x) { const i = x | 0; return x < 0 && x !== i ? i - 1 : i; }

// Taylor atan2
function taylorAtan2(y, x) {
    if (x === 0) {
        if (y > 0) return HALF_PI;
        if (y < 0) return -HALF_PI;
        return 0;
    }
    let angle;
    const ratio = y / x;
    if (absVal(ratio) <= 1) {
        let sum = 0, term = ratio;
        const r2 = ratio * ratio;
        for (let k = 0; k < 15; k++) {
            sum += term;
            term = -term * r2 * (2 * k + 1) / (2 * k + 3);
        }
        angle = sum;
    } else {
        const inv = x / y;
        let sum = 0, term = inv;
        const r2 = inv * inv;
        for (let k = 0; k < 15; k++) {
            sum += term;
            term = -term * r2 * (2 * k + 1) / (2 * k + 3);
        }
        angle = HALF_PI - sum;
        if (y < 0) angle = -angle;
    }
    if (x < 0) { if (y >= 0) angle += PI; else angle -= PI; }
    return angle;
}

// Aliases for rendering
const sin = taylorSin;
const cos = taylorCos;
const exp = taylorExp;
const sqrt = newtonSqrt;
const abs = absVal;
const floor = floorVal;
const atan2 = taylorAtan2;

// ═══════════════════════════════════════════════════════════════════════════════
// §3 TRUE 4D TESSERACT
// ═══════════════════════════════════════════════════════════════════════════════

const TESSERACT = {
    vertices: [],
    edges: [],
    cells: [],
    
    init() {
        this.vertices = [];
        for (let i = 0; i < 16; i++) {
            this.vertices.push({
                x: (i & 1) ? 1 : -1,
                y: (i & 2) ? 1 : -1,
                z: (i & 4) ? 1 : -1,
                w: (i & 8) ? 1 : -1
            });
        }
        this.edges = [];
        for (let i = 0; i < 16; i++) {
            for (let bit = 0; bit < 4; bit++) {
                const j = i ^ (1 << bit);
                if (i < j) this.edges.push([i, j, bit]);
            }
        }
        this.cells = [];
        for (let axis = 0; axis < 4; axis++) {
            for (let val = -1; val <= 1; val += 2) {
                const cellVerts = [];
                for (let i = 0; i < 16; i++) {
                    const v = this.vertices[i];
                    const coords = [v.x, v.y, v.z, v.w];
                    if (coords[axis] === val) cellVerts.push(i);
                }
                this.cells.push({ verts: cellVerts, axis, val });
            }
        }
    }
};

function rotate4D(v, angles) {
    let { x, y, z, w } = v;
    let c, s;
    c = cos(angles.xy); s = sin(angles.xy); [x, y] = [x*c - y*s, x*s + y*c];
    c = cos(angles.xz); s = sin(angles.xz); [x, z] = [x*c - z*s, x*s + z*c];
    c = cos(angles.xw); s = sin(angles.xw); [x, w] = [x*c - w*s, x*s + w*c];
    c = cos(angles.yz); s = sin(angles.yz); [y, z] = [y*c - z*s, y*s + z*c];
    c = cos(angles.yw); s = sin(angles.yw); [y, w] = [y*c - w*s, y*s + w*c];
    c = cos(angles.zw); s = sin(angles.zw); [z, w] = [z*c - w*s, z*s + w*c];
    return { x, y, z, w };
}

function project4Dto3D(v4, wDist) {
    const denom = wDist - v4.w;
    if (abs(denom) < 0.001) return { x: v4.x * 1000, y: v4.y * 1000, z: v4.z * 1000 };
    const scale = wDist / denom;
    return { x: v4.x * scale, y: v4.y * scale, z: v4.z * scale };
}

function rotY3D(p, a) { const c = cos(a), s = sin(a); return { x: p.x*c + p.z*s, y: p.y, z: -p.x*s + p.z*c }; }
function rotX3D(p, a) { const c = cos(a), s = sin(a); return { x: p.x, y: p.y*c - p.z*s, z: p.y*s + p.z*c }; }
function project3Dto2D(p, d) { const scale = 500 / (d + p.z); return { x: p.x * scale, y: p.y * scale, z: p.z }; }

// ═══════════════════════════════════════════════════════════════════════════════
// §4 CYMATIC FIELD — RENDER LAYER (IEEE-754 acceptable)
// ═══════════════════════════════════════════════════════════════════════════════

const CYMATIC = {
    resU: 96, resV: 48,
    field: null, velocity: null,
    modes: [], sources: [],
    vortex: { strength: 0, phase: 0 },
    showNodes: false, nodalPoints: [],
    
    init() {
        const size = this.resU * this.resV;
        this.field = new Float64Array(size);
        this.velocity = new Float64Array(size);
        this.modes = []; this.sources = [];
        this.vortex = { strength: 0, phase: 0 };
        this.nodalPoints = [];
    },
    
    idx(u, v) {
        u = ((u % this.resU) + this.resU) % this.resU;
        v = ((v % this.resV) + this.resV) % this.resV;
        return u * this.resV + v;
    },
    
    addMode(m, n, amp) { this.modes.push({ m, n, amp, phase: (m * n * PHI) % TWO_PI }); },
    addSource(theta, phi, amp, freq, decay) {
        const u = (theta / TWO_PI) * this.resU;
        const v = (phi / TWO_PI) * this.resV;
        this.sources.push({ u, v, amp, freq: freq || 0.1, decay: decay || 0.99, phase: 0, age: 0 });
    },
    igniteVortex(strength) { this.vortex.strength = strength; this.vortex.phase = 0; },
    
    update(dt) {
        const c2 = 0.35, damping = 0.996;
        const newF = new Float64Array(this.field.length);
        const newV = new Float64Array(this.velocity.length);
        
        for (let u = 0; u < this.resU; u++) {
            for (let v = 0; v < this.resV; v++) {
                const i = this.idx(u, v);
                const f0 = this.field[i];
                const lap = this.field[this.idx(u+1,v)] + this.field[this.idx(u-1,v)] +
                           this.field[this.idx(u,v+1)] + this.field[this.idx(u,v-1)] - 4*f0;
                let vortexF = 0;
                if (this.vortex.strength > 0.01) {
                    const theta = (u / this.resU) * TWO_PI;
                    const phi = (v / this.resV) * TWO_PI;
                    vortexF = this.vortex.strength * (
                        0.4 * sin(2*theta - 3*phi + this.vortex.phase) +
                        0.3 * sin(3*theta - 2*phi + this.vortex.phase * 1.5) +
                        0.2 * sin(theta + phi + this.vortex.phase * 0.7)
                    ) * 0.1;
                }
                newV[i] = (this.velocity[i] + c2 * lap * dt + vortexF) * damping;
                newF[i] = f0 + newV[i] * dt;
            }
        }
        
        for (let s = this.sources.length - 1; s >= 0; s--) {
            const src = this.sources[s];
            const ui = floor(src.u), vi = floor(src.v);
            for (let du = -4; du <= 4; du++) {
                for (let dv = -4; dv <= 4; dv++) {
                    const r2 = du*du + dv*dv;
                    if (r2 < 20) {
                        const i = this.idx(ui + du, vi + dv);
                        newF[i] += src.amp * sin(src.phase) * exp(-r2 * 0.2);
                    }
                }
            }
            src.phase += src.freq;
            src.amp *= src.decay;
            src.age++;
            if (src.amp < 0.001 || src.age > 500) this.sources.splice(s, 1);
        }
        
        for (const mode of this.modes) {
            for (let u = 0; u < this.resU; u++) {
                for (let v = 0; v < this.resV; v++) {
                    const theta = (u / this.resU) * TWO_PI;
                    const phi = (v / this.resV) * TWO_PI;
                    const standing = cos(mode.m * theta + mode.phase) * cos(mode.n * phi + mode.phase * 0.6);
                    newF[this.idx(u, v)] += mode.amp * standing * 0.015;
                }
            }
            mode.phase += 0.025;
            mode.amp *= 0.997;
        }
        this.modes = this.modes.filter(m => m.amp > 0.003);
        
        if (this.vortex.strength > 0.01) {
            this.vortex.phase += 0.06 * this.vortex.strength;
            this.vortex.strength *= 0.997;
        }
        
        this.field = newF; this.velocity = newV;
        if (this.showNodes) this.findNodalPoints();
    },
    
    sample(theta, phi) {
        const u = (theta / TWO_PI) * this.resU;
        const v = (phi / TWO_PI) * this.resV;
        const u0 = floor(u), v0 = floor(v);
        const fu = u - u0, fv = v - v0;
        return this.field[this.idx(u0,v0)] * (1-fu)*(1-fv) +
               this.field[this.idx(u0+1,v0)] * fu*(1-fv) +
               this.field[this.idx(u0,v0+1)] * (1-fu)*fv +
               this.field[this.idx(u0+1,v0+1)] * fu*fv;
    },
    
    gradient(theta, phi) {
        const eps = 0.05;
        return {
            dTheta: (this.sample(theta+eps, phi) - this.sample(theta-eps, phi)) / (2*eps),
            dPhi: (this.sample(theta, phi+eps) - this.sample(theta, phi-eps)) / (2*eps)
        };
    },
    
    findNodalPoints() {
        this.nodalPoints = [];
        const threshold = 0.015;
        for (let u = 0; u < this.resU; u += 2) {
            for (let v = 0; v < this.resV; v += 2) {
                const f = this.field[this.idx(u, v)];
                if (abs(f) < threshold) {
                    const n = [
                        this.field[this.idx(u+1,v)], this.field[this.idx(u-1,v)],
                        this.field[this.idx(u,v+1)], this.field[this.idx(u,v-1)]
                    ];
                    if (n.some(x => x > threshold) && n.some(x => x < -threshold)) {
                        this.nodalPoints.push({ theta: (u / this.resU) * TWO_PI, phi: (v / this.resV) * TWO_PI });
                    }
                }
            }
        }
    },
    
    energy() {
        let e = 0;
        for (let i = 0; i < this.field.length; i++) {
            e += this.field[i] * this.field[i] + this.velocity[i] * this.velocity[i];
        }
        return e;
    }
};

