const QUEUE = {
    items: [], mode: 0, running: false, totalDelta: 0,
    add(sutraId) { if (this.items.length < 29) { this.items.push(sutraId); this.updateUI(); } },
    remove(index) { this.items.splice(index, 1); this.updateUI(); },
    clear() { this.items = []; this.totalDelta = 0; this.updateUI(); },
    run() {
        if (this.items.length === 0 || this.running) return;
        this.running = true; this.totalDelta = 0;
        document.getElementById('cascade-state').textContent = 'RUNNING';
        const mode = this.mode;
        if (mode === 2) {
            for (const id of this.items) {
                const sutra = SUTRAS[id - 1];
                if (sutra) {
                    const cube = cubes.find(c => c.sutra.id === id);
                    if (cube) {
                        const angles = cube.toTorusAngles();
                        const delta = sutra.transform(CYMATIC, R4, mode, angles.theta, angles.phi);
                        this.totalDelta += delta;
                        cube.fire(mode);
                        addTrace(`<span class="tr-sutra">S${id}</span> ∥ δ=<span class="tr-val">${delta}</span>`);
                    }
                }
            }
            R4.compute();
            this.finishRun();
        } else {
            let delay = 0;
            const step = mode === 1 ? 100 : 60;
            for (let i = 0; i < this.items.length; i++) {
                const id = this.items[i];
                setTimeout(() => {
                    const sutra = SUTRAS[id - 1];
                    if (sutra) {
                        const cube = cubes.find(c => c.sutra.id === id);
                        if (cube) {
                            const angles = cube.toTorusAngles();
                            const delta = sutra.transform(CYMATIC, R4, mode, angles.theta, angles.phi);
                            this.totalDelta += delta;
                            cube.fire(mode);
                            R4.compute();
                            const modeStr = mode === 4 ? '⁻¹' : '→';
                            addTrace(`<span class="tr-sutra">S${id}</span> ${modeStr} δ=<span class="tr-val">${delta}</span> Σ=<span class="tr-val">${this.totalDelta}</span>`);
                            document.getElementById('sum-delta').textContent = this.totalDelta;
                        }
                    }
                    if (i === this.items.length - 1) setTimeout(() => this.finishRun(), 200);
                }, delay);
                delay += step;
            }
        }
    },
    finishRun() {
        this.running = false;
        document.getElementById('cascade-state').textContent = 'COMPLETE';
        document.getElementById('sum-delta').textContent = this.totalDelta;
        addTrace(`<span class="tr-exact">Σδ = ${this.totalDelta}</span>`);
        setTimeout(() => { document.getElementById('cascade-state').textContent = 'IDLE'; }, 2000);
    },
    cascade() { this.clear(); for (let i = 1; i <= 29; i++) this.items.push(i); this.updateUI(); this.run(); },
    updateUI() {
        const display = document.getElementById('queue-display');
        display.innerHTML = '';
        this.items.forEach((id, idx) => {
            const chip = document.createElement('span');
            chip.className = 'q-chip';
            chip.textContent = `S${id}`;
            chip.onclick = () => this.remove(idx);
            display.appendChild(chip);
        });
        document.getElementById('q-len').textContent = this.items.length;
        document.getElementById('comp-mode').textContent = MODES[this.mode];
    }
};

class SutraCube {
    constructor(idx, cellData) {
        this.idx = idx; this.sutra = SUTRAS[idx]; this.cell = cellData;
        this.selectedFace = 0; this.active = false; this.activeTime = 0;
        this.pulsePhase = (idx * PHI) % TWO_PI;
    }
    getCenter4D() {
        const verts = this.cell.verts;
        let cx = 0, cy = 0, cz = 0, cw = 0;
        for (const vi of verts) { const v = TESSERACT.vertices[vi]; cx += v.x; cy += v.y; cz += v.z; cw += v.w; }
        const n = verts.length;
        return { x: cx/n, y: cy/n, z: cz/n, w: cw/n };
    }
    toTorusAngles() {
        const c = this.getCenter4D();
        return { theta: atan2(c.w, c.x) * 0.5 + (this.idx / 29) * TWO_PI, phi: atan2(c.z, c.y) * 0.5 + PI };
    }
    fire(mode) { this.active = true; this.activeTime = Date.now(); this.selectedFace = mode; }
    getDistortion() {
        const angles = this.toTorusAngles();
        const fieldVal = CYMATIC.sample(angles.theta, angles.phi);
        const grad = CYMATIC.gradient(angles.theta, angles.phi);
        let pulse = 0;
        if (this.active) {
            const elapsed = (Date.now() - this.activeTime) / 1000;
            pulse = exp(-elapsed * 2) * sin(elapsed * 15 + this.pulsePhase);
            if (elapsed > 2) this.active = false;
        }
        return { scale: 1 + fieldVal * 0.4 + pulse * 0.3, offsetX: grad.dTheta * 10, offsetY: fieldVal * 15 + pulse * 20, offsetZ: grad.dPhi * 10, twist: fieldVal * 0.3 };
    }
}

let cubes = [];
let time = 0;
let camRotX = 0.3, camRotY = 0;
let rot4D = { xy: 0, xz: 0, xw: 0, yz: 0, yw: 0, zw: 0 };
let isDrag = false, lastM = { x: 0, y: 0 };
let selectedCube = -1;

const TORUS = {
    majorR: 160, minorR: 55,
    point(theta, phi, distortion = 0) {
        const fieldVal = CYMATIC.sample(theta, phi);
        const R = this.majorR + fieldVal * distortion * 25;
        const r = this.minorR + fieldVal * distortion * 15;
        const ct = cos(theta), st = sin(theta), cp = cos(phi), sp = sin(phi);
        return { x: (R + r * cp) * ct, y: r * sp + fieldVal * distortion * 10, z: (R + r * cp) * st, fieldVal };
    }
};

function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; cx = W / 2; cy = H / 2; }

function render() {
    ctx.fillStyle = '#030306';
    ctx.fillRect(0, 0, W, H);
    CYMATIC.update(0.5);
    GRVQ.updateStats();
    MSTVQ.update();
    rot4D.xy += 0.003; rot4D.xw += 0.002; rot4D.zw += 0.0015;
    
    const gridRes = 50;
    for (let i = 0; i < gridRes; i++) {
        for (let j = 0; j < gridRes / 2; j++) {
            const theta = (i / gridRes) * TWO_PI;
            const phi = (j / (gridRes / 2)) * TWO_PI;
            const p = TORUS.point(theta + time * 0.004, phi, 1);
            let p3 = rotY3D(p, camRotY);
            p3 = rotX3D(p3, camRotX);
            if (p3.z > -350) {
                const p2 = project3Dto2D(p3, 550);
                const fv = p.fieldVal;
                const intensity = abs(fv) * 350;
                const clampedIntensity = intensity > 255 ? 255 : intensity;
                const r = fv > 0 ? clampedIntensity : 0;
                const g = clampedIntensity * 0.25;
                const b = fv < 0 ? clampedIntensity : 0;
                ctx.fillStyle = `rgba(${floor(r)},${floor(g)},${floor(b)},${0.25 + abs(fv) * 0.4})`;
                const sz = 7 * (450 / (550 + p3.z));
                const finalSz = sz > 2 ? sz : 2;
                ctx.fillRect(cx + p2.x - finalSz/2, cy + p2.y - finalSz/2, finalSz, finalSz);
            }
        }
    }
    
    if (CYMATIC.showNodes && CYMATIC.nodalPoints.length > 0) {
        ctx.fillStyle = 'rgba(255,255,255,0.9)';
        for (const node of CYMATIC.nodalPoints) {
            const p = TORUS.point(node.theta + time * 0.004, node.phi, 1);
            let p3 = rotY3D(p, camRotY);
            p3 = rotX3D(p3, camRotX);
            if (p3.z > -300) {
                const p2 = project3Dto2D(p3, 550);
                ctx.beginPath();
                ctx.arc(cx + p2.x, cy + p2.y, 3, 0, TWO_PI);
                ctx.fill();
            }
        }
    }
    
    if (CYMATIC.vortex.strength > 0.03) {
        const numArms = 5;
        const alpha = CYMATIC.vortex.strength * 0.5;
        const clampedAlpha = alpha > 0.8 ? 0.8 : alpha;
        for (let arm = 0; arm < numArms; arm++) {
            ctx.strokeStyle = `rgba(212,175,55,${clampedAlpha})`;
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            let started = false;
            for (let t = 0; t < 25; t += 0.25) {
                const spiralTheta = t * 0.4 + CYMATIC.vortex.phase + arm * (TWO_PI / numArms);
                const spiralR = 25 + t * 10;
                const spiralY = sin(t * 0.8 + CYMATIC.vortex.phase) * 20;
                const sx = spiralR * cos(spiralTheta);
                const sz = spiralR * sin(spiralTheta);
                let p3 = rotY3D({ x: sx, y: spiralY, z: sz }, camRotY);
                p3 = rotX3D(p3, camRotX);
                const p2 = project3Dto2D(p3, 550);
                if (!started) { ctx.moveTo(cx + p2.x, cy + p2.y); started = true; }
                else ctx.lineTo(cx + p2.x, cy + p2.y);
            }
            ctx.stroke();
        }
    }
    
    const fieldCoupling = R4.getFieldCoupling();
    const scale4D = 70 * (0.6 + fieldCoupling * 0.5);
    const axisColors = ['#4a90d9', '#2ecc71', '#e67e22', '#9b59b6'];
    
    const transformedVerts = TESSERACT.vertices.map(v => {
        let v4 = { x: v.x * scale4D, y: v.y * scale4D, z: v.z * scale4D, w: v.w * scale4D };
        v4 = rotate4D(v4, rot4D);
        let v3 = project4Dto3D(v4, 200);
        v3 = rotY3D(v3, camRotY);
        v3 = rotX3D(v3, camRotX);
        return { ...project3Dto2D(v3, 550), z3: v3.z };
    });
    
    for (const [i, j, axis] of TESSERACT.edges) {
        const p1 = transformedVerts[i], p2 = transformedVerts[j];
        const avgZ = (p1.z3 + p2.z3) / 2;
        let alpha = 0.5 - avgZ / 500;
        if (alpha < 0.15) alpha = 0.15;
        const alphaHex = floor(alpha * 255).toString(16).padStart(2, '0');
        ctx.strokeStyle = axisColors[axis] + alphaHex;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(cx + p1.x, cy + p1.y);
        ctx.lineTo(cx + p2.x, cy + p2.y);
        ctx.stroke();
    }
    
    const sortedCubes = cubes.map((cube, i) => {
        const c4 = cube.getCenter4D();
        let v4 = { x: c4.x * scale4D, y: c4.y * scale4D, z: c4.z * scale4D, w: c4.w * scale4D };
        v4 = rotate4D(v4, rot4D);
        const dist = cube.getDistortion();
        v4.x += dist.offsetX; v4.y += dist.offsetY; v4.z += dist.offsetZ;
        let v3 = project4Dto3D(v4, 200);
        v3 = rotY3D(v3, camRotY);
        v3 = rotX3D(v3, camRotX);
        return { cube, v3, dist, idx: i };
    }).sort((a, b) => a.v3.z - b.v3.z);
    
    for (const { cube, v3, dist } of sortedCubes) {
        const p2 = project3Dto2D(v3, 550);
        const baseSize = 16 * dist.scale;
        const size = baseSize * (450 / (550 + v3.z));
        if (v3.z > -400) {
            const faceSize = size * 0.9;
            for (let f = 0; f < 6; f++) {
                const faceOffset = (f - 2.5) * 3;
                const fx = p2.x + faceOffset * (f < 3 ? 1 : -1) * 0.3;
                const fy = p2.y + faceOffset * (f % 2 ? 0.5 : -0.5);
                const isSelected = cube.idx === selectedCube && cube.selectedFace === f;
                const alpha = isSelected ? 0.95 : (cube.active ? 0.8 : 0.5);
                const alphaHex = floor(alpha * 200).toString(16).padStart(2, '0');
                ctx.fillStyle = MODE_COLORS[f] + alphaHex;
                ctx.fillRect(cx + fx - faceSize/12, cy + fy - faceSize/12, faceSize/6, faceSize/6);
            }
            ctx.fillStyle = cube.sutra.color + (cube.active ? 'cc' : '80');
            ctx.fillRect(cx + p2.x - size/2, cy + p2.y - size/2, size, size);
            ctx.strokeStyle = cube.active ? '#d4af37' : '#333';
            ctx.lineWidth = cube.active ? 2 : 1;
            ctx.strokeRect(cx + p2.x - size/2, cy + p2.y - size/2, size, size);
            ctx.fillStyle = '#fff';
            const fontSize = size * 0.5;
            ctx.font = `${fontSize > 7 ? fontSize : 7}px monospace`;
            ctx.textAlign = 'center';
            ctx.fillText(String(cube.sutra.id), cx + p2.x, cy + p2.y + 3);
        }
    }
    
    R4.compute();
    const r4v = abs(Rat.toFloatForRendering(R4.value));
    const glowR = 30 + 50 * r4v + CYMATIC.vortex.strength * 25 + fieldCoupling * 20;
    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, glowR);
    grad.addColorStop(0, `rgba(255,220,150,${0.5 + r4v * 0.4})`);
    grad.addColorStop(0.4, `rgba(255,150,50,${0.2 + r4v * 0.2})`);
    grad.addColorStop(1, 'rgba(255,100,0,0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(cx, cy, glowR, 0, TWO_PI);
    ctx.fill();
    
    document.getElementById('r4-val').textContent = Rat.str(R4.value);
    document.getElementById('l-val').textContent = R4.lambda.map(l => Rat.str(l)).join(', ');
    document.getElementById('w-val').textContent = CYMATIC.vortex.strength.toFixed(3);
    document.getElementById('e-val').textContent = CYMATIC.energy().toFixed(1);
    document.getElementById('m-val').textContent = CYMATIC.modes.length;
    document.getElementById('n-val').textContent = CYMATIC.nodalPoints.length;
    document.getElementById('psi-val').textContent = GRVQ.peak.toFixed(4);
    document.getElementById('psi-norm').textContent = GRVQ.norm_integral.toFixed(4);
    document.getElementById('g-val').textContent = R4.getGCoupling().toFixed(4);
    document.getElementById('b-val').textContent = MSTVQ.B_magnitude.toFixed(4);
    document.getElementById('t-val').textContent = MSTVQ.T_stress.toExponential(2);
    document.getElementById('r4-main').textContent = `R⁴ = ${Rat.str(R4.value)}`;
    document.getElementById('r4-sub').textContent = `λ=[${R4.lambda.map(l => Rat.str(l)).join(',')}]`;
    
    if (selectedCube >= 0 && cubes[selectedCube]) {
        const s = cubes[selectedCube].sutra;
        document.getElementById('sel-id').textContent = `S${s.id}`;
        document.getElementById('sel-name').textContent = s.name;
        document.getElementById('sel-sanskrit').textContent = s.sanskrit;
        document.getElementById('sel-alg').textContent = s.alg;
        document.getElementById('sel-delta').textContent = `δ = ${s.delta}`;
    }
    
    time++;
    requestAnimationFrame(render);
}

function hitTest(mx, my) {
    const scale4D = 70 * (0.6 + R4.getFieldCoupling() * 0.5);
    const testX = mx - cx, testY = my - cy;
    const hits = [];
    for (let i = 0; i < cubes.length; i++) {
        const cube = cubes[i];
        const c4 = cube.getCenter4D();
        let v4 = { x: c4.x * scale4D, y: c4.y * scale4D, z: c4.z * scale4D, w: c4.w * scale4D };
        v4 = rotate4D(v4, rot4D);
        const dist = cube.getDistortion();
        v4.x += dist.offsetX; v4.y += dist.offsetY; v4.z += dist.offsetZ;
        let v3 = project4Dto3D(v4, 200);
        v3 = rotY3D(v3, camRotY);
        v3 = rotX3D(v3, camRotX);
        const p2 = project3Dto2D(v3, 550);
        const size = 16 * dist.scale * (450 / (550 + v3.z));
        if (testX > p2.x - size && testX < p2.x + size && testY > p2.y - size && testY < p2.y + size) {
            const relX = (testX - p2.x) / size, relY = (testY - p2.y) / size;
            let face = 0;
            if (relX < -0.3) face = 2;
            else if (relX > 0.3) face = 3;
            else if (relY < -0.3) face = 4;
            else if (relY > 0.3) face = 5;
            else if (relX + relY < 0) face = 0;
            else face = 1;
            hits.push({ idx: i, face, z: v3.z });
        }
    }
    if (hits.length > 0) { hits.sort((a, b) => b.z - a.z); return hits[0]; }
    return null;
}

canvas.addEventListener('mousedown', e => { isDrag = true; lastM = { x: e.clientX, y: e.clientY }; });
canvas.addEventListener('mousemove', e => {
    if (isDrag) {
        camRotY += (e.clientX - lastM.x) * 0.005;
        camRotX += (e.clientY - lastM.y) * 0.005;
        if (camRotX < -1.3) camRotX = -1.3;
        if (camRotX > 1.3) camRotX = 1.3;
        lastM = { x: e.clientX, y: e.clientY };
    }
});
canvas.addEventListener('mouseup', e => {
    const dx = e.clientX - lastM.x, dy = e.clientY - lastM.y;
    if (abs(dx) < 5 && abs(dy) < 5) {
        const hit = hitTest(e.clientX, e.clientY);
        if (hit) {
            selectedCube = hit.idx;
            const sutraId = cubes[hit.idx].sutra.id;
            QUEUE.add(sutraId);
            addTrace(`<span class="tr-sutra">+S${sutraId}</span> to queue`);
        }
    }
    isDrag = false;
});
canvas.addEventListener('wheel', e => { rot4D.xw += e.deltaY * 0.001; rot4D.yw += e.deltaX * 0.001; e.preventDefault(); }, { passive: false });

let touchStartTime = 0, touchStartPos = { x: 0, y: 0 };
canvas.addEventListener('touchstart', e => {
    e.preventDefault();
    const touch = e.touches[0];
    isDrag = true;
    lastM = { x: touch.clientX, y: touch.clientY };
    touchStartTime = Date.now();
    touchStartPos = { x: touch.clientX, y: touch.clientY };
}, { passive: false });
canvas.addEventListener('touchmove', e => {
    e.preventDefault();
    if (isDrag && e.touches.length === 1) {
        const touch = e.touches[0];
        camRotY += (touch.clientX - lastM.x) * 0.005;
        camRotX += (touch.clientY - lastM.y) * 0.005;
        if (camRotX < -1.3) camRotX = -1.3;
        if (camRotX > 1.3) camRotX = 1.3;
        lastM = { x: touch.clientX, y: touch.clientY };
    } else if (e.touches.length === 2) {
        const dx = e.touches[1].clientX - e.touches[0].clientX;
        const dy = e.touches[1].clientY - e.touches[0].clientY;
        rot4D.xw += dy * 0.0005;
        rot4D.yw += dx * 0.0005;
    }
}, { passive: false });
canvas.addEventListener('touchend', e => {
    e.preventDefault();
    const elapsed = Date.now() - touchStartTime;
    const dx = lastM.x - touchStartPos.x, dy = lastM.y - touchStartPos.y;
    if (elapsed < 300 && abs(dx) < 15 && abs(dy) < 15) {
        const hit = hitTest(touchStartPos.x, touchStartPos.y);
        if (hit) {
            selectedCube = hit.idx;
            const sutraId = cubes[hit.idx].sutra.id;
            QUEUE.add(sutraId);
            addTrace(`<span class="tr-sutra">+S${sutraId}</span> to queue`);
        }
    }
    isDrag = false;
}, { passive: false });

