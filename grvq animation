// §5 GRVQ WAVEFUNCTION — RENDER LAYER
// ═══════════════════════════════════════════════════════════════════════════════
// 
// Note: GRVQ uses IEEE-754 for visualization
// R4.lambda state is EXACT and separate
// 

const GRVQ = {
    n_modes: 3, r0: 1.0, normalization: 1.0, peak: 0, norm_integral: 0,
    
    S(j, theta, phi) { return 1 + j * sin(j * theta) * cos(j * phi) * 0.1; },
    
    psi(theta, phi) {
        let psi = this.normalization;
        for (let j = 1; j <= this.n_modes; j++) {
            const Sj = this.S(j, theta, phi);
            if (abs(Sj) > 0.01) psi *= (1 - j / (Sj * 10));
        }
        psi *= (1 + CYMATIC.sample(theta, phi) * 0.3);
        // Use rendering conversion for R4 coupling
        const r4v = Rat.toFloatForRendering(R4.value);
        psi *= (0.5 + 0.5 * abs(r4v));
        return psi;
    },
    
    updateStats() {
        this.peak = 0; this.norm_integral = 0;
        const dtheta = TWO_PI / 32, dphi = TWO_PI / 16;
        for (let i = 0; i < 32; i++) {
            const theta = i * dtheta;
            for (let j = 0; j < 16; j++) {
                const phi = j * dphi;
                const val = this.psi(theta, phi);
                if (abs(val) > abs(this.peak)) this.peak = val;
                this.norm_integral += val * val * dtheta * dphi;
            }
        }
        this.norm_integral /= (TWO_PI * TWO_PI);
    }
};

